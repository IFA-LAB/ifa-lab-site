---
/**
 * Example custom section (黃鉅燊). Copy this folder to src/custom/<your-id>/ and make it yours.
 * Rules: CONTRIBUTING.md. Short version: only your folder, only design tokens for colour and type,
 * no external scripts/fonts/iframes, stay inside the budgets. `npm run check` tells you if you broke one.
 */
import type { Locale } from '@/i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const zh = lang === 'zh-tw';

// research, oldest at the bottom like the lab's brick wall; colour = the lab's research-area colour
const research = [
  { year: '2025', clay: 'violet', zh: 'LAK 2025 國際學習分析與知識會議 Practitioner Track 發表：運用知識圖譜與大型語言模型分析學習軌跡', en: 'LAK 2025 Practitioner Track paper: analysing learning trajectories with knowledge graphs and LLMs', who: { zh: '指導：張家凱教授', en: 'With Prof. Chia-Kai Chang' } },
  { year: '2025–26', clay: 'pink', zh: '114 年度國科會大專生計畫：財伴 oSave 的實證研究。4 週準實驗 82 人，每週記帳天數提升 176%、預算達成率翻倍到 76.8%，財務焦慮顯著下降（p<0.01）', en: 'NSTC undergraduate project (2025–26): an empirical study of oSave. A 4-week quasi-experiment with 82 people: logging days per week up 176%, budget attainment doubled to 76.8%, financial anxiety significantly down (p<0.01)', who: { zh: '指導：邱信瑜教授', en: 'With Prof. Hsin-Yu Chiu' } },
  { year: '2024–25', clay: 'up', zh: '113 年度國科會大專生計畫：結合股市異常現象指標及生成式 AI 之股票追蹤系統', en: 'NSTC undergraduate project (2024–25): a stock tracker combining market-anomaly indicators with generative AI', who: { zh: '指導：邱信瑜教授', en: 'With Prof. Hsin-Yu Chiu' } },
  { year: '2024–25', clay: 'down', zh: '113 年度國科會大專生計畫：探討生成式 AI 於社交工程之發展應用（PhishForge 的研究版）', en: 'NSTC undergraduate project (2024–25): generative AI in social engineering (the research side of PhishForge)', who: { zh: '指導：胡雅涵教授', en: 'With Prof. Ya-Han Hu' } },
];

const trophies = [
  { year: '2025', zh: '台積電校園黑客松', en: 'TSMC IT CareerHack', clay: 'up' },
  { year: '2025', zh: '臺東創新創業大賽', en: 'Taitung Startup Award', clay: 'sun' },
  { year: '2024', zh: '大專資訊服務創新賽', en: 'InnoServe Awards', clay: 'blue' },
  { year: '2024', zh: '臺灣數創大賞 金獎', en: 'Taiwan Digital Creativity, Gold', clay: 'sun' },
  { year: '2024', zh: 'Startup 創業競技場', en: 'Startup Arena', clay: 'down' },
];
---
<div class="research">
  <h2>{zh ? '研究與發表：三個國科會計畫、一篇國際會議' : 'Research: three NSTC projects and one conference paper'}</h2>
  <ol>
    {research.map((r) => (
      <li style={`--c: var(--clay-${r.clay})`}>
        <span class="brick" aria-hidden="true"></span>
        <span class="year">{r.year}</span>
        <p>{zh ? r.zh : r.en}<span class="who">{zh ? r.who.zh : r.who.en}</span></p>
      </li>
    ))}
  </ol>
</div>

<div class="shelf">
  <h2>{zh ? '獎盃架：五座大獎' : 'Trophy shelf: five top prizes'}</h2>
  <ul>
    {trophies.map((x) => (
      <li style={`--c: var(--clay-${x.clay})`}>
        <span class="cup" aria-hidden="true"></span>
        <span class="year">{x.year}</span>
        <span>{zh ? x.zh : x.en}</span>
      </li>
    ))}
  </ul>
  <p class="more"><a href="https://ogmatcha.com/resume/" target="_blank" rel="noopener">{zh ? '完整年表在我的個人網站' : 'Full record on my site'}</a></p>
</div>

<style>
  /* headings break at punctuation and spaces, never inside a word like 國科會 */
  h2 { word-break: keep-all; }
  .research { display: grid; gap: var(--space-4); margin-bottom: var(--space-7); }
  .research ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .research li { display: grid; grid-template-columns: 52px 5.5em minmax(0, 1fr); gap: var(--space-3); align-items: start; }
  /* one clay brick per piece of work, in the lab's area colour */
  .brick { height: 22px; margin-top: 3px; border-radius: 7px; background: var(--c); box-shadow: inset 0 -4px 0 rgb(0 0 0 / 0.16), inset 2px 3px 3px rgb(255 255 255 / 0.4); }
  .research .year { padding-top: 4px; }
  .research p { margin: 0; font-size: 15px; line-height: 1.7; }
  .who { display: block; font-size: 14px; color: var(--ink-2); }
  /* phones: brick and year share the first line, the text gets the full width under them */
  @media (max-width: 559px) { .research li { grid-template-columns: 36px minmax(0, 1fr); row-gap: var(--space-1); } .research .year { padding-top: 0; align-self: center; } .research p { grid-column: 1 / -1; } }
  .shelf { display: grid; gap: var(--space-4); }
  h2 { font-size: 20px; }
  /* centred rows, so an odd last trophy sits in the middle instead of alone on the left */
  .shelf ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-5) var(--space-4); }
  .shelf li { flex: 0 1 140px; display: grid; align-content: start; justify-items: center; text-align: center; gap: var(--space-1); font-size: 15px; text-wrap: balance; }
  /* each cup stands on its own little plinth, right under it */
  .cup {
    position: relative; margin-bottom: var(--space-3);
    width: 46px; height: 52px; border-radius: 10px 10px 22px 22px; background: var(--c);
    box-shadow: inset -4px -6px 8px rgb(0 0 0 / 0.18), inset 4px 4px 8px rgb(255 255 255 / 0.35);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cup::after { content: ''; position: absolute; left: 50%; bottom: -12px; width: 68px; height: 10px; translate: -50% 0; border-radius: var(--r-full); background: var(--surface-2); box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.3); }
  @media (hover: hover) and (pointer: fine) { li:hover .cup::after { translate: -50% 4px; } }
  .year { font: 500 13px/1.4 var(--f-mono); color: var(--ink-2); }
  @media (hover: hover) and (pointer: fine) { li:hover .cup { transform: translateY(-4px); } }
  .more { font-size: 15px; }
</style>
