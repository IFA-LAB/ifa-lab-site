---
/**
 * 黃鉅燊's own section: a K line of my own (one candle a year, each standing on the year before), the research,
 * and the products that are still in use. Data: ./data.ts. Rules: CONTRIBUTING.md.
 * Want to start your own? Copy this folder to src/custom/<your-id>/, keep Section.astro, and replace the rest.
 */
import type { Locale } from '@/i18n/ui';
import MyKline from './MyKline';
import { FEATURED, MORE, RESEARCH, YEARS, type Bi } from './data';
interface Props { lang: Locale }
const { lang } = Astro.props;
const zh = lang === 'zh-tw';
const t = (b: Bi) => (zh ? b.zh : b.en);

const all = YEARS.flatMap((y) => y.items);
const count = (k: string) => all.filter((i) => i.kind === k).length;
const wins = count('win');
const lead = zh
  ? `${all.length} 塊積木：${count('role')} 個角色、${count('research')} 項研究、${count('work')} 個作品、${count('award') + wins} 個獎，其中 ${wins} 座全國首獎。`
  : `${all.length} bricks: ${count('role')} roles, ${count('research')} research items, ${count('work')} products and ${count('award') + wins} awards, ${wins} of them national first prizes.`;
---
<section class="part" aria-labelledby="me-kline">
  <header class="head">
    <h2 id="me-kline">{zh ? '年表' : 'Timeline'}</h2>
    <p>{lead}</p>
  </header>
  <MyKline client:visible lang={lang} />
</section>

<section class="part" aria-labelledby="me-research">
  <header class="head">
    <h2 id="me-research">{zh ? '研究：三個國科會計畫、一篇國際會議' : 'Research: three NSTC projects and a conference paper'}</h2>
  </header>
  <ol class="research">
    {RESEARCH.map((r) => (
      <li style={`--c: var(--clay-${r.clay})`}>
        <span class="tab" aria-hidden="true"></span>
        <span class="yr">{r.year}</span>
        <div>
          <p class="title">{r.href ? <a href={r.href} target="_blank" rel="noopener">{t(r.title)} ↗</a> : t(r.title)}</p>
          {r.result && <p class="result">{t(r.result)}</p>}
        </div>
        <span class="who">{zh ? '指導：' : 'With '}{t(r.who)}</span>
      </li>
    ))}
  </ol>
</section>

<section class="part" aria-labelledby="me-works">
  <header class="head">
    <h2 id="me-works">{zh ? '上線中的作品' : 'Live projects'}</h2>
  </header>
  <ul class="featured">
    {FEATURED.map((w) => (
      <li class="card" style={`--c: var(--clay-${w.clay})`}>
        <span class="slab" aria-hidden="true"></span>
        <p class="status"><i aria-hidden="true"></i>{t(w.status)}</p>
        <h3>{w.name}</h3>
        <p class="line">{t(w.line)}</p>
        <dl class="facts">
          {w.facts.map((f) => <div><dt>{t(f.label)}</dt><dd>{f.n}</dd></div>)}
        </dl>
        <p class="role">{t(w.role)}</p>
        <a class="go" href={w.href} target="_blank" rel="noopener">{zh ? '看作品' : 'See the work'}<span class="vh">{zh ? `：${w.name}` : `: ${w.name}`}</span> ↗</a>
      </li>
    ))}
  </ul>
  <ul class="more">
    {MORE.map((w) => (
      <li class="mini" style={`--c: var(--clay-${w.clay})`}>
        <span class="dot" aria-hidden="true"></span>
        <p class="name"><a href={w.href} target="_blank" rel="noopener">{w.name}</a><span class:list={['chip', { off: !w.live }]}>{t(w.status)}</span></p>
        <p class="line">{t(w.line)}</p>
        <p class="role">{t(w.role)}</p>
      </li>
    ))}
  </ul>
  <p class="all"><a href="https://www.ogmatcha.com/resume/" target="_blank" rel="noopener">{zh ? '完整年表和 16 項競賽獎，在我的個人網站' : 'The full record and all 16 awards are on my site'} ↗</a></p>
</section>

<style>
  .part { display: grid; gap: var(--space-5); }
  .part + .part { margin-top: var(--space-8); padding-top: var(--space-7); border-top: 1px solid var(--surface-2); }
  .head { display: grid; gap: var(--space-2); max-width: 46rem; }
  h2 { font: 600 22px/1.35 var(--f-display); }
  .head p { margin: 0; font-size: 15px; color: var(--ink-2); }

  /* research: tab | year | what and what came of it | advisor; one aligned table on wide screens */
  .research { list-style: none; margin: 0; padding: 0; display: grid; }
  .research li { display: grid; grid-template-columns: 10px 5.5rem minmax(0, 1fr) 10rem; gap: var(--space-4); align-items: baseline; padding: var(--space-4) 0; border-top: 1px solid var(--surface-2); }
  .research li:first-child { border-top: 0; padding-top: 0; }
  .tab { align-self: stretch; width: 10px; border-radius: var(--r-full); background: var(--c); box-shadow: inset -2px -3px 3px rgb(0 0 0 / 0.16); }
  .yr { font: 500 14px/1.6 var(--f-mono); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .research .title { margin: 0; font-size: 16px; line-height: 1.6; max-width: 40em; }
  .research .result { margin: var(--space-1) 0 0; font-size: 14px; line-height: 1.6; color: var(--ink-2); max-width: 44em; }
  .who { font-size: 14px; color: var(--ink-2); }
  @media (max-width: 767px) {
    .research li { grid-template-columns: 10px minmax(0, 1fr); row-gap: var(--space-1); }
    .tab { grid-row: 1 / span 3; }
    .yr, .research li > div, .who { grid-column: 2; }
  }

  /* three products as equal cards: status, name, one line, two figures, my role, link at the bottom */
  .featured, .more { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  /* the cards share their rows (subgrid), so status, name, line, figures and link sit at the same height in all three */
  .featured { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(6, auto); row-gap: 0; }
  /* tablets and phones: the three cards in a row you swipe, the next one peeking in, instead of three screens of scroll */
  @media (max-width: 899px) {
    .featured { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(86%, 22rem); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding-bottom: var(--space-2); scrollbar-width: thin; }
    .card { scroll-snap-align: start; }
  }
  .card { position: relative; grid-row: span 6; display: grid; grid-template-rows: subgrid; row-gap: var(--space-3); align-content: start; padding: var(--space-5); padding-top: calc(var(--space-5) + 10px); border-radius: var(--r-lg); background: var(--surface-2); overflow: hidden; }
  .slab { position: absolute; inset: 0 0 auto; height: 10px; background: var(--c); box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.14); }
  .status { display: inline-flex; align-items: center; gap: 6px; margin: 0; font: 600 13px/1.4 var(--f-body); color: var(--ink-2); }
  .status i { width: 8px; height: 8px; border-radius: var(--r-full); background: var(--clay-down); box-shadow: 0 0 0 3px rgb(0 0 0 / 0.06); }
  h3 { margin: 0; font: 700 20px/1.3 var(--f-display); }
  .line { margin: 0; font-size: 15px; line-height: 1.6; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: var(--space-2) 0 0; padding: var(--space-3) 0; border-block: 1px solid var(--surface); }
  /* figure on top, label under it; every figure on the same line however long its label */
  .facts div { display: grid; grid-template-rows: auto 1fr; align-content: start; gap: 2px; }
  .facts dd { order: -1; }
  .facts dd { margin: 0; font: 700 26px/1.1 var(--f-display); font-variant-numeric: tabular-nums; }
  .facts dt { font-size: 13px; line-height: 1.4; color: var(--ink-2); }
  .role { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-2); }
  .go { align-self: end; justify-self: start; min-height: 44px; display: inline-flex; align-items: center; font-weight: 600; }

  /* the rest: compact, three to a row on wide screens, all the same height */
  .more { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-5); margin-top: var(--space-2); }
  @media (max-width: 899px) { .more { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 559px) { .more { grid-template-columns: minmax(0, 1fr); } }
  .mini { display: grid; grid-template-columns: 10px minmax(0, 1fr); grid-template-rows: auto 1fr auto; column-gap: var(--space-3); row-gap: var(--space-1); padding: var(--space-4) 0; border-top: 1px solid var(--surface-2); }
  .dot { grid-row: 1 / span 3; width: 10px; border-radius: var(--r-full); background: var(--c); box-shadow: inset -2px -3px 3px rgb(0 0 0 / 0.16); }
  .name { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); margin: 0; font-weight: 600; }
  .name a { min-height: 24px; }
  .chip { padding: 1px 8px; border-radius: var(--r-full); background: var(--surface-2); font: 500 12px/1.6 var(--f-body); color: var(--ink-2); }
  .chip:not(.off)::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 5px; border-radius: var(--r-full); background: var(--clay-down); vertical-align: 1px; }
  .mini .line { font-size: 14px; }
  .mini .role { font-size: 13px; }
  .all { margin: 0; font-size: 15px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
