---
import Base from '@/layouts/Base.astro';
import { lab } from '@/data/lab';
import { ui, t, href, type Bi, type Locale } from '@/i18n/ui';
import { getCollection } from 'astro:content';
import { langPaths } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';
const ways: { title: Bi; body: Bi; clay: string }[] = [
  { clay: 'blue', title: { zh: '產業合作', en: 'Industry partners' }, body: { zh: '帶著資料和想問的問題來談，就像兆豐那樣。', en: 'Bring a dataset and a question, as Mega Bank did.' } },
  { clay: 'sun', title: { zh: '學術合作', en: 'Academic collaboration' }, body: { zh: '一起申請國科會計畫、合寫論文。', en: 'Joint NSTC proposals and co-authored papers.' } },
  { clay: 'pink', title: { zh: '跨領域研究', en: 'Interdisciplinary research' }, body: { zh: '做行為、語言或網路資料的研究者，可以拿金融市場的資料來驗證自己的方法。', en: 'Researchers working on behavior, language or network data can test their methods on financial market data.' } },
];
// Real collaboration record, computed from the publication list
const pubs = await getCollection('publications');
const memberNames = new Set((await getCollection('members')).map((m) => m.data.name.en).filter(Boolean));
const coauthors = new Map<string, number>();
for (const p of pubs) for (const a of p.data.authors) if (a !== 'Hsin-Yu Chiu' && !memberNames.has(a)) coauthors.set(a, (coauthors.get(a) ?? 0) + 1);
const people = [...coauthors].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const venues = [...new Set(pubs.filter((p) => p.data.kind === 'journal').map((p) => p.data.venue).filter(Boolean))] as string[];
---
<Base lang={lang} title={zh ? '產學合作與學術合作' : 'Industry and academic collaboration'} description={zh ? '和中央大學資管系 IFA Lab 合作：產學合作（已和兆豐銀行完成一個專案）、學術共同研究與跨領域研究。' : 'Work with IFA Lab: industry, academic and interdisciplinary collaboration.'}>
  <div class="wrap section">
    <div class="section-head">
      <h1>{zh ? '跟 IFA Lab 合作' : 'Work with IFA Lab'}</h1>
      <p class="muted">{zh ? `和兆豐完成過一個產學合作，也和 ${people.length} 位其他學者合寫過論文，刊在 ${venues.length} 本期刊。` : `A completed industry project with Mega Bank, and papers co-written with ${people.length} other researchers, in ${venues.length} journals.`}</p>
    </div>
    <section class="case" aria-labelledby="case-h">
      <p class="eyebrow">{zh ? '已完成的產學合作' : 'Completed industry project'}</p>
      <h2 id="case-h">{zh ? '兆豐 × IFA Lab：隨機優勢能不能預測？' : 'Mega × IFA Lab: can stochastic dominance be predicted?'}</h2>
      <p class="lede">{zh
        ? '和兆豐金控、兆豐銀行合作，研究「隨機優勢」關係的可預測性與持續性：處理跨時區資料對齊、超參數調整與財務特徵，讓模型的結果能放進實際的投資決策。'
        : 'With Mega Financial Holding and Mega Bank, we studied whether stochastic-dominance relations are predictable and persistent, working through cross-timezone data alignment, tuning and financial features so the results could feed real investment decisions.'}</p>
      <p class="team">{zh ? '參與成員：' : 'Team: '}<a href={href(lang, 'members/wei-hua-hou')}>{zh ? '侯威華' : 'Wei-Hua Hou'}</a>{zh ? '、' : ', '}<a href={href(lang, 'members/yu-bin-chen')}>{zh ? '陳昱斌' : 'Yu-Bin Chen'}</a>{zh ? '，指導：邱信瑜' : '; advisor Hsin-Yu Chiu'}</p>
    </section>
    <h2 class="ways-h">{zh ? '可以怎麼合作' : 'Ways to work with us'}</h2>
    <ul class="ways">
      {ways.map((w) => (
        <li style={`--c: var(--clay-${w.clay})`}>
          <h3>{t(w.title, lang)}</h3>
          <p>{t(w.body, lang)}</p>
        </li>
      ))}
    </ul>
    <p class="cta"><a class="btn" href={`mailto:${lab.contact.email}?subject=${encodeURIComponent(zh ? '和 IFA Lab 合作' : 'Collaboration with IFA Lab')}`}>{zh ? '寫信談合作' : 'Email us about a project'}</a> <a class="btn secondary" href={href(lang, 'research')}>{zh ? '先看研究成果' : 'See our research first'}</a></p>

    <div class="record">
      <section aria-labelledby="co-h">
        <h2 id="co-h">{zh ? `一起寫過論文的 ${people.length} 位研究者` : `${people.length} researchers we have co-authored with`}</h2>
        <ul class="tags">{people.map(([n, c]) => <li lang="en">{n}{c > 1 && <b> ×{c}</b>}</li>)}</ul>
      </section>
      <section aria-labelledby="ve-h">
        <h2 id="ve-h">{zh ? `刊登過的 ${venues.length} 本期刊` : `${venues.length} journals we have published in`}</h2>
        <ul class="tags venues">{venues.map((v) => <li lang="en">{v}</li>)}</ul>
      </section>
    </div>


  </div>
</Base>

<style>
  /* the one project is the page's lead: a coloured clay slab, not one more white card */
  .case {
    position: relative; margin-top: var(--space-7); padding: var(--space-7) var(--space-7) var(--space-8); display: grid; gap: var(--space-3);
    border-radius: var(--r-lg); background: color-mix(in oklab, var(--clay-blue) 18%, var(--surface));
    box-shadow: 10px 14px 28px var(--lo), inset 0 2px 0 var(--hi), inset -6px -8px 14px rgb(0 0 0 / 0.06);
  }
  .case h2 { font-size: clamp(26px, 3vw, 40px); max-width: 20em; text-wrap: balance; }
  .lede { margin: 0; max-width: 40em; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.8; }
  .team { margin: var(--space-2) 0 0; color: var(--ink-2); }
  .ways-h { margin-top: var(--space-9); font-size: clamp(22px, 2.2vw, 28px); }
  .ways { list-style: none; margin: var(--space-5) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-7); }
  .ways li { display: grid; gap: var(--space-3); align-content: start; padding-top: var(--space-5); border-top: 3px solid var(--c); }
  .ways h3 { font-size: 20px; }
  .ways p { margin: 0; }
  .record { margin-top: var(--space-9); padding-top: var(--space-7); border-top: 1px solid color-mix(in oklab, var(--ink) 10%, transparent); display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-7); }
  .record section { display: grid; gap: var(--space-4); align-content: start; }
  .record h2 { font-size: 22px; }
  .tags b { font: 600 12px/1 var(--f-mono); color: var(--ink-2); }
  .venues li { font-style: italic; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  @media (max-width: 899px) { .record, .ways { grid-template-columns: 1fr; } .ways { gap: var(--space-6); } }
  /* wide screens: the question on the left, the work on the right, so the slab has no empty half */
  @media (min-width: 900px) {
    .case { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--space-8); align-items: start; }
    .case > .eyebrow, .case > h2 { grid-column: 1; }
    .case > .lede { grid-column: 2; grid-row: 1 / span 2; }
    .case > .team { grid-column: 2; }
  }
  @media (max-width: 767px) { .case { padding: var(--space-6) var(--space-5) var(--space-7); } }
</style>
