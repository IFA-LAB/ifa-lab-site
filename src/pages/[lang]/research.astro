---
import LabCat from '@/components/LabCat.astro';
import Base from '@/layouts/Base.astro';
import Bi from '@/components/Bi.astro';
import { getCollection } from 'astro:content';
import { advisor, areas, studentProjects } from '@/data/lab';
import { Picture } from 'astro:assets';
import chadAi from '@/assets/projects/chad-ai.jpg';
const projectPhotos: Record<string, ImageMetadata> = { 'chad-ai': chadAi };
import { ui, t, href, type Locale } from '@/i18n/ui';
import { langPaths, publications, apa, memberByEnglishName, citation } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';
const site = Astro.site!;
const pubs = await publications();
const journals = pubs.filter((p) => p.data.kind === 'journal');
const working = pubs.filter((p) => p.data.kind === 'working');
const grants = (await getCollection('grants')).sort((a, b) => b.data.period.localeCompare(a.data.period));
const nowYM = new Date().toISOString().slice(0, 7).replace('-', '/');
const ongoing = (period: string) => { const [s, e] = period.split(/[–-]/).map((x) => x.trim()); return s <= nowYM && (!e || e >= nowYM); };
const theses = (await getCollection('theses')).sort((a, b) => b.data.academicYear - a.data.academicYear);
const members = await getCollection('members');
const nameOf = (id: string) => members.find((m) => m.id === id)?.data.name;
const byName = await memberByEnglishName();
const areaName = (k: string) => t(areas.find((a) => a.key === k)?.name, lang);
const areaClay = (k: string) => areas.find((a) => a.key === k)?.clay ?? 'grey';
/** Who works on each area: thesis writers plus lab members among a paper's authors (the advisor is in every area, so left out). */
const peopleByArea = new Map<string, string[]>();
const addPerson = (area: string, id?: string) => { if (!id || id === 'hsin-yu-chiu') return; const l = peopleByArea.get(area) ?? []; if (!l.includes(id)) l.push(id); peopleByArea.set(area, l); };
for (const x of theses) addPerson(x.data.area, x.data.member);
for (const p of pubs) for (const a of p.data.authors) addPerson(p.data.area, byName.get(a));
/** Theses are finished at the end of the ROC academic year: AY 113 → June 2025. */
const thesisYear = (ay: number) => ay + 1912;
const works = [
  ...pubs.map((p) => ({ id: p.id, title: p.data.title, year: p.data.year, area: p.data.area, kind: p.data.kind, soon: p.data.status === 'forthcoming' })),
  ...theses.map((x) => ({ id: `t-${x.id}`, title: t(x.data.title, lang), year: thesisYear(x.data.academicYear), area: x.data.area, kind: 'thesis', soon: false })),
];
const done = works.filter((w) => !w.soon);
const yrs = done.map((w) => w.year);
const wallYears = Array.from({ length: Math.max(...yrs) - Math.min(...yrs) + 1 }, (_, i) => Math.min(...yrs) + i);
const byArea = (a: { area: string }, b: { area: string }) => areas.findIndex((x) => x.key === a.area) - areas.findIndex((x) => x.key === b.area);
// accepted papers sit in their own "forthcoming" pile, not under a future year
// a run of empty years shares one narrow column ("2022–23"), so two empty labels never sit side by side
const yearCols: { year: number; to?: number; bricks: typeof works }[] = [];
for (const y of wallYears) {
  const bricks = done.filter((w) => w.year === y).sort(byArea);
  const last = yearCols.at(-1);
  if (!bricks.length && last && !last.bricks.length) last.to = y;
  else yearCols.push({ year: y, bricks });
}
const wall: { year: number | string; to?: number; bricks: typeof works }[] = [
  ...yearCols,
  ...(works.some((w) => w.soon) ? [{ year: zh ? '即將' : 'Soon', bricks: works.filter((w) => w.soon).sort(byArea) }] : []),
];
const wallMax = Math.max(...wall.map((c) => c.bricks.length));

const jsonld = journals.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.data.title,
  author: p.data.authors.map((a) => ({ '@type': 'Person', name: a })),
  datePublished: String(p.data.year),
  ...(p.data.venue ? { isPartOf: { '@type': 'Periodical', name: p.data.venue } } : {}),
  ...(p.data.doi ? { sameAs: `https://doi.org/${p.data.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.data.doi } } : {}),
  url: new URL(href(lang, `papers/${p.id}`), site).href,
}));
---
<Base lang={lang} title={t(ui.nav.research, lang)} description={zh ? `IFA Lab 的 ${journals.length} 篇期刊論文、${working.length} 篇工作論文、${grants.length} 件國科會計畫與 ${theses.length} 篇碩士論文。` : `IFA Lab's ${journals.length} journal articles, ${working.length} working papers, ${grants.length} NSTC projects and ${theses.length} master's theses.`} jsonld={jsonld}>
  <div class="wrap section">
    <div class="section-head">
      <p class="eyebrow">{t(ui.nav.research, lang)}</p>
      <h1>{zh ? '研究成果' : 'Research'}</h1>
      <p class="muted">{zh ? '依六個研究領域上色。粗體作者是實驗室成員，* 為通訊作者。' : 'Colored by research area. Lab members are in bold; * marks the corresponding author.'}</p>
    </div>

    <figure class="wall clay" aria-label={zh ? `成果牆：${wall.map((c) => `${c.year} 年 ${c.bricks.length} 件`).join('、')}` : `Output wall: ${wall.map((c) => `${c.year}: ${c.bricks.length}`).join(', ')}`}>
      <div class="cols" style={`--rows: ${wallMax}`}>
        {wall.map((c) => (
          <div class:list={['col', { empty: !c.bricks.length, run: !!c.to }]}>
            {c.bricks.length === wallMax && wall.findIndex((x) => x.bricks.length === wallMax) === wall.indexOf(c) && (
              <span class="perch"><LabCat lang={lang} size={58} bubble="left" lines={[{ zh: '這一年疊了最多塊，我坐在最上面看風景。', en: 'This year has the most blocks. Nice view up here.' }, { zh: '空心的是還在寫的工作論文，我不敢踩。', en: 'Hollow ones are working papers, still drying. I do not step on them.' }, { zh: '點下面的顏色，可以只看一個領域。', en: 'Tap a color below to see just one area.' }]} /></span>
            )}
            <span class="num" aria-hidden="true">{c.bricks.length || ''}</span>
            {/* each brick jumps to its entry in the list below (pointer only; the list itself is the accessible version) */}
            <span class="pile" aria-hidden="true">{c.bricks.map((b) => <a href={`#${b.id}`} tabindex="-1" title={b.title} data-brick data-area={b.area} class:list={[b.kind]} style={`--c: var(--clay-${areaClay(b.area)})`}></a>)}</span>
            {typeof c.year === 'number' ? <span class="yr" aria-hidden="true"><span class="cent">{String(c.year).slice(0, 2)}</span>{String(c.year).slice(2)}{c.to && `–${String(c.to).slice(2)}`}</span> : <span class="yr soon" aria-hidden="true">{c.year}</span>}
          </div>
        ))}
      </div>
      <figcaption class="muted">{zh ? '每一塊積木是一篇論文或碩士論文，依完成年份往上疊；顏色是研究領域，空心的是工作論文。' : 'One brick per paper or thesis, stacked by year; color is the research area, hollow bricks are working papers.'}</figcaption>
    </figure>

    <div class="filter" role="group" aria-label={zh ? '依研究領域篩選' : 'Filter by research area'}>
      <ul class="areas">
        <li><button type="button" class="chip" data-area="" aria-pressed="true">{zh ? '全部' : 'All'}</button></li>
        {areas.map((a) => <li id={a.key}><button type="button" class="chip" data-area={a.key} aria-pressed="false" style={`--c: var(--clay-${a.clay})`}><i aria-hidden="true"></i>{t(a.short ?? a.name, lang)}</button></li>)}
      </ul>
      <p class="muted status" aria-live="polite" data-status></p>
      {areas.map((a) => (peopleByArea.get(a.key)?.length ?? 0) > 0 && (
        <p class="people" data-people={a.key} hidden>{zh ? '做這個領域的人：' : 'Who works on this: '}{peopleByArea.get(a.key)!.map((id, i) => <>{i > 0 && (zh ? '、' : ', ')}<a href={href(lang, `members/${id}`)}>{t(nameOf(id), lang)}</a></>)}</p>
      ))}
    </div>
    <nav class="jump" aria-label={zh ? '跳到' : 'Jump to'} data-label={zh ? '跳到' : 'Jump to'}>
      <a href="#j-h" data-for="j-h">{t(ui.pubs.journal, lang)} <b>{journals.length}</b></a>
      <a href="#w-h" data-for="w-h">{t(ui.pubs.working, lang)} <b>{working.length}</b></a>
      <a href="#t-h" data-for="t-h">{t(ui.pubs.theses, lang)} <b>{theses.length}</b></a>
      <a href="#g-h">{t(ui.pubs.grants, lang)} <b>{grants.length}</b></a>
      <a href="#s-h">{t(ui.pubs.projects, lang)} <b>{studentProjects.length}</b></a>
    </nav>

    <section aria-labelledby="j-h" class="group" data-pubs>
      <h2 id="j-h">{t(ui.pubs.journal, lang)} <span class="n">{journals.length}</span></h2>
      <ol class="pubs">
        {journals.map((p) => {
          const c = apa(p.data, lang);
          return (
            <li id={p.id} class="pub" data-area={p.data.area} style={`--c: var(--clay-${areaClay(p.data.area)})`}>
              <span class="block" aria-hidden="true" data-vt="brick">{p.data.status === 'forthcoming' ? (zh ? '即將' : 'Soon') : p.data.year}</span>
              <div>
                <p class="title" lang="en"><a href={href(lang, `papers/${p.id}`)} data-vt="title">{p.data.title}</a></p>
                <p class="authors">{p.data.authors.map((a, i) => (
                  <>{i > 0 && ', '}<span class="nm">{byName.has(a) || a === 'Hsin-Yu Chiu' ? <strong>{a}</strong> : a}{p.data.corresponding.includes(i) && '*'}</span></>
                ))}</p>
                {/* each item carries its trailing ·, and lines break only between items: a · never starts a line */}
                <p class="muted meta">{[
                  <em>{c.tail}</em>,
                  String(c.year),
                  <span class="area-tag">{areaName(p.data.area)}</span>,
                  p.data.doi && <a href={`https://doi.org/${p.data.doi}`} target="_blank" rel="noopener">DOI</a>,
                  !p.data.doi && p.data.url && <a href={p.data.url} target="_blank" rel="noopener">{zh ? '全文' : 'Full text'}</a>,
                  p.data.slides && <a href={p.data.slides} target="_blank" rel="noopener">{zh ? '簡報' : 'Slides'}</a>,
                  <button type="button" class="copy" data-copy={citation(p.data)} data-done={zh ? '已複製引用' : 'Citation copied'}>{zh ? '複製引用' : 'Copy citation'}</button>,
                ].filter(Boolean).map((x, i, all) => <><span class:list={[{ nw: i > 0 }]}>{x}{i < all.length - 1 && ' ·'}</span>{i < all.length - 1 && ' '}</>)}
                </p>
                {p.data.plain && <Bi text={p.data.plain} lang={lang} />}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section aria-labelledby="w-h" class="group" data-pubs>
      <h2 id="w-h">{t(ui.pubs.working, lang)} <span class="n">{working.length}</span></h2>
      <ol class="pubs two">
        {working.map((p) => (
          <li id={p.id} class="pub" data-area={p.data.area} style={`--c: var(--clay-${areaClay(p.data.area)})`}>
            <span class="block" aria-hidden="true" data-vt="brick">{p.data.year}</span>
            <div>
              <p class="title" lang="en"><a href={href(lang, `papers/${p.id}`)} data-vt="title">{p.data.title}</a></p>
              <p class="authors">{p.data.authors.map((a, i) => (
                <>{i > 0 && ', '}<span class="nm">{byName.has(a) || a === 'Hsin-Yu Chiu' ? <strong>{a}</strong> : a}{p.data.corresponding.includes(i) && '*'}</span></>
              ))}</p>
              {p.data.plain && <Bi text={p.data.plain} lang={lang} />}
              <p class="muted meta">{p.data.year}&nbsp;· <span class="area-tag">{areaName(p.data.area)}</span>{p.data.url && <>&nbsp;· <a href={p.data.url} target="_blank" rel="noopener">{zh ? '全文' : 'Full text'}</a></>}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="t-h" class="group" data-pubs>
      <h2 id="t-h">{t(ui.pubs.theses, lang)} <span class="n">{theses.length}</span></h2>
      <ol class="pubs two">
        {theses.map((x) => (
          <li id={`t-${x.id}`} class="pub" data-area={x.data.area} style={`--c: var(--clay-${areaClay(x.data.area)})`}>
            <span class="block" aria-hidden="true" data-vt="brick">{thesisYear(x.data.academicYear)}</span>
            <div>
              <Bi text={x.data.title} lang={lang} />
              <p class="muted meta"><a href={href(lang, `members/${x.data.member}`)}>{t(nameOf(x.data.member), lang)}</a>&nbsp;· {zh ? `${x.data.academicYear} 學年度` : `AY ${x.data.academicYear + 1911}–${String(x.data.academicYear + 1912).slice(2)}`}&nbsp;· <span class="area-tag">{areaName(x.data.area)}</span></p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="g-h" class="group">
      <h2 id="g-h">{t(ui.pubs.grants, lang)} <span class="n">{grants.length}</span></h2>
      <ul class="grants">
        {grants.map((g) => (
          <li class="clay">
            <p class="mono muted">{g.data.period}{ongoing(g.data.period) && <span class="live">{zh ? '進行中' : 'Ongoing'}</span>}</p>
            <Bi text={g.data.title} lang={lang} />
            <p class="muted meta">{t(g.data.kind, lang)}&nbsp;· {t(ui.pubs.pi, lang)} {(() => { const m = members.find((x) => x.data.name.en === g.data.pi); if (g.data.pi === advisor.name.en) return <a href={href(lang, 'advisor')}>{t(advisor.name, lang)}</a>; return m ? <a href={href(lang, `members/${m.id}`)}>{t(m.data.name, lang)}</a> : g.data.pi; })()}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="s-h" class="group">
      <h2 id="s-h">{t(ui.pubs.projects, lang)} <span class="n">{studentProjects.length}</span></h2>
      <ul class="projects">
        {studentProjects.map((p) => (
          <li class:list={['clay', { feature: p.photo }]}>
            {p.photo && projectPhotos[p.photo] && (
              <Picture src={projectPhotos[p.photo]} alt={t(p.photoAlt!, lang)} widths={[480, 960]} sizes="(min-width: 900px) 480px, 100vw" formats={['avif', 'webp']} class="pphoto" />
            )}
            <div class="ptext">
              <p class="mono muted">{p.year}{p.award && <> · <span class="award">{t(p.award, lang)}</span></>}</p>
              <p class="title">{p.name}</p>
              <p>{t(p.desc, lang)}</p>
              {p.members.length > 0 && <p class="muted meta">{p.members.map((id, i) => <>{i > 0 && (zh ? '、' : ', ')}<a href={href(lang, `members/${id}`)}>{t(nameOf(id), lang)}</a></>)}</p>}
              {p.by && <p class="muted meta">{t(p.by, lang)}</p>}
              {p.links.length > 0 && <p class="plinks">{p.links.map((l) => <a class="chip" href={l.url} target="_blank" rel="noopener">{l.label}</a>)}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter button[data-area]')];
  const items = [...document.querySelectorAll<HTMLElement>('.pub[data-area]')];
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const zh = document.documentElement.lang.startsWith('zh');
  function apply(area: string, scroll = false) {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.area === area));
    let n = 0;
    for (const li of items) { const on = !area || li.dataset.area === area; li.hidden = !on; if (on) n++; }
    for (const g of document.querySelectorAll<HTMLElement>('.group[data-pubs]')) {
      const shown = g.querySelectorAll('.pub:not([hidden])').length;
      g.querySelector('.n')!.textContent = String(shown);
      g.hidden = shown === 0;
      // the jump chips carry the same filtered counts; an emptied one fades
      const id = g.getAttribute('aria-labelledby');
      const chip = document.querySelector<HTMLElement>(`.jump [data-for="${id}"]`);
      if (chip) { chip.querySelector('b')!.textContent = String(shown); chip.classList.toggle('none', shown === 0); }
    }
    // the wall above follows the filter: other areas fade, each year's number counts only this area
    for (const col of document.querySelectorAll<HTMLElement>('.wall .col')) {
      let k = 0;
      for (const a of col.querySelectorAll<HTMLElement>('[data-brick]')) { const on = !area || a.dataset.area === area; a.classList.toggle('off', !on); if (on) k++; }
      const num = col.querySelector<HTMLElement>('.num');
      if (num) num.textContent = k ? String(k) : '';
    }
    for (const p of document.querySelectorAll<HTMLElement>('[data-people]')) p.hidden = p.dataset.people !== area;
    const label = buttons.find((b) => b.dataset.area === area)?.textContent?.trim();
    status.textContent = area ? (zh ? `只顯示「${label}」：${n} 件（論文與碩士論文）` : `Showing ${label}: ${n} ${n === 1 ? 'work' : 'works'} (papers and theses)`) : '';
    if (scroll) document.querySelector('.filter')?.scrollIntoView({ block: 'start' });
  }
  for (const b of buttons) b.addEventListener('click', () => {
    const area = b.dataset.area ?? '';
    apply(area);
    history.replaceState(null, '', area ? `#${area}` : location.pathname);
  });
  const fromHash = location.hash.slice(1);
  if (buttons.some((b) => b.dataset.area === fromHash && fromHash)) apply(fromHash, true);

  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-brick]')) {
    a.addEventListener('click', (e) => {
      const el = document.getElementById(a.hash.slice(1));
      if (!el) return;
      e.preventDefault();
      if (el.hidden) apply('');
      history.replaceState(null, '', a.hash);
      el.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      document.querySelectorAll('.pub.lit').forEach((x) => x.classList.remove('lit'));
      el.classList.add('lit');
      setTimeout(() => el.classList.remove('lit'), 2400);
    });
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('button.copy')) {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = b.dataset.done ?? label; setTimeout(() => (b.textContent = label), 1600); } catch {}
    });
  }
</script>

<style>
  .projects { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .projects > li { padding: var(--space-5); display: grid; gap: var(--space-4); align-content: start; min-width: 0; }
  /* a lone card after the feature takes the full row instead of leaving a hole */
  .projects > li:not(.feature):last-child:nth-child(even) { grid-column: 1 / -1; }
  .projects > li.feature { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; }
  .ptext { display: grid; gap: var(--space-2); min-width: 0; }
  .projects :global(.pphoto) { display: block; width: 100%; height: auto; border-radius: var(--r-md); }
  /* the award reads as words, not code: body face even inside the mono year line */
  .award { font: 600 15px/1.4 var(--f-body); color: var(--ink); }
  .plinks { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .plinks a { text-decoration: none; min-height: 40px; }
  @media (max-width: 899px) { .projects, .projects > li.feature { grid-template-columns: 1fr; } }
  .areas { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); }
  .filter { scroll-margin-top: 88px; margin-bottom: var(--space-1); display: grid; gap: var(--space-2); }
  .filter .areas { margin-bottom: 0; }
  .areas button { min-height: 44px; cursor: pointer; font: inherit; font-size: 15px; display: inline-flex; align-items: center; gap: var(--space-2); border: 0; color: var(--ink); }
  .areas button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  /* tablets: a touch tighter so all seven chips share one row instead of leaving one alone */
  @media (min-width: 768px) and (max-width: 1023px) { .areas { gap: 6px; } .areas button { padding-inline: 10px; gap: 6px; font-size: 14px; } }
  .status { font-size: 14px; min-height: 1.5em; }
  .people { font-size: 14px; margin-top: calc(-1 * var(--space-1)); }
  .title a { color: var(--ink); text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: 4px; }
  .title a:hover { text-decoration-color: currentColor; }
  .copy { background: none; border: 0; padding: 0; min-height: 32px; color: var(--accent); font: 500 14px/1.4 var(--f-body); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .pub[hidden], .group[hidden] { display: none; }
  .areas i, .block { display: inline-block; background: var(--c); box-shadow: inset -2px -3px 4px rgb(0 0 0 / 0.18), inset 2px 2px 4px rgb(255 255 255 / 0.35); }
  .areas i { width: 12px; height: 12px; border-radius: 4px; }
  .group { margin-top: var(--space-8); }
  .group h2 { margin-bottom: var(--space-5); display: flex; align-items: baseline; gap: var(--space-3); scroll-margin-top: 140px; }
  .n { font: 500 16px/1 var(--f-mono); color: var(--ink-2); }
  .pubs { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .pub { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-5); padding: var(--space-4) 0; border-bottom: 1px solid var(--line); scroll-margin-top: 96px; }
  .pub > div { display: grid; gap: var(--space-1); min-width: 0; align-content: start; }
