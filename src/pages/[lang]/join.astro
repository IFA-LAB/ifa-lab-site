---
import Base from '@/layouts/Base.astro';
import { lab, advisor, areas } from '@/data/lab';
import { ui, t, href, type Bi, type Locale } from '@/i18n/ui';
import { langPaths } from '@/lib/content';
import { getCollection, getEntry } from 'astro:content';
import BiText from '@/components/Bi.astro';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';

const faq: { q: Bi; a: Bi }[] = [
  {
    q: { zh: 'IFA Lab 適合什麼樣的學生？', en: 'Who is IFA Lab for?' },
    a: { zh: '想拿真實資料做研究的學生：實驗室做過台股、期貨、選擇權、財報文字和 P2P 借貸的題目。不懂金融也沒關係。', en: 'Students who want to do research on real data: past topics used Taiwan stocks, futures, options, financial-report text and P2P lending. No finance background is needed.' },
  },
  {
    q: { zh: '中央資管碩士班怎麼找指導老師？', en: 'How do I choose an advisor for the NCU IM master’s program?' },
    a: { zh: '先看老師近幾年的論文和學生題目合不合你的興趣，再寄信約時間聊；也可以問學長姐每週 meeting 的方式和畢業時程。IFA Lab 學長姐的碩論題目和畢業去向列在本頁下方。', en: 'Look at the advisor’s recent papers and students’ topics, then email to set up a chat; ask current students how meetings run and how long graduation takes. IFA Lab’s past theses and where graduates went are listed below.' },
  },
  {
    q: { zh: '一定要做金融題目嗎？', en: 'Do I have to work on finance?' },
    a: { zh: '不用。老師是金融背景，但題目不限金融，資訊管理領域裡你有興趣的方向，都可以找老師討論。', en: 'No. Prof. Chiu’s background is finance, but topics are not limited to it: any direction in information management you care about is open to discuss with him.' },
  },
  {
    q: { zh: '今年收了幾位碩士生？什麼時候寄信？', en: 'How many master’s students joined this year? When should I write?' },
    a: { zh: '2026 年秋天收了 3 位碩士生。什麼時候寄信都可以，越早聊，越有時間想題目。有程式基礎（Python、R 或類似語言）會比較快上手。', en: 'Three master’s students joined in fall 2026. Write any time; the earlier we talk, the more time there is to shape a topic. Some programming (Python, R or similar) helps you start faster.' },
  },
  {
    q: { zh: '實驗室平常怎麼運作？', en: 'What is lab life like?' },
    a: { zh: '每週 meeting 一次，報告進度、一起討論。壓力不大，可以去實習，畢業也沒有硬性規定的標準，進度跟老師討論著走。每年中秋節會去老師家烤肉。', en: 'One meeting a week to share progress and talk it through. The pace is relaxed, internships are fine and there is no fixed bar for graduating: you set the pace with Prof. Chiu. Every Mid-Autumn Festival we have a barbecue at his place.' },
  },
  {
    q: { zh: '有助學金嗎？', en: 'Is there funding?' },
    a: { zh: `有。碩士生可以當助教，或參與老師的國科會計畫，都有助學金。研究要用的設備和出國發表論文也有支援。金額每年不同，想知道可以寫信問老師（${lab.contact.email}）。`, en: `Yes. Master’s students can work as teaching assistants or on Prof. Chiu’s NSTC projects, both paid. Equipment for your research and trips to present papers abroad are supported too. Amounts vary by year; email Prof. Chiu (${lab.contact.email}) to ask.` },
  },
  {
    q: { zh: '大學部可以加入嗎？', en: 'Can undergraduates join?' },
    a: { zh: '老師沒有帶大學部的畢業專題。大學部同學可以當老師研究計畫的研究助理，或一起申請國科會大專生研究計畫。', en: 'Prof. Chiu does not supervise undergraduate capstone projects. Undergraduates can join as research assistants on his projects or apply together for an NSTC undergraduate research grant.' },
  },
  {
    q: { zh: '要怎麼聯絡實驗室？', en: 'How do I get in touch?' },
    a: { zh: `寄信給邱信瑜老師（${lab.contact.email}），簡單介紹自己和有興趣的題目；也可以到志希館 712 實驗室找我們，或到管理二館 I1‑932 找老師。`, en: `Email Prof. Hsin-Yu Chiu (${lab.contact.email}) with a short introduction and the topics you are interested in, or visit the lab in Room 712, Zhixi Building, or Prof. Chiu’s office, I1‑932, Management Building II.` },
  },
];
const theses = (await getCollection('theses')).sort((a, b) => b.data.academicYear - a.data.academicYear);
const thesisRows = await Promise.all(theses.map(async (x) => ({ x, m: await getEntry('members', x.data.member) })));
const gone = (await getCollection('members')).filter((m) => m.data.status === 'graduated' && m.data.now).sort((a, b) => a.data.cohort - b.data.cohort || a.data.order - b.data.order);
const steps: { t: Bi; d: Bi }[] = [
  { t: { zh: '寄一封信', en: 'Send an email' }, d: { zh: '三五句話介紹自己、修過的課，和你好奇的題目。想考碩士班的話，在甄試或考試報名之前就來信，比較有時間先聊題目。', en: 'A few lines about you, the courses you took and what you are curious about. Applying for the master’s program? Write before the application window so there is time to talk topics.' } },
  { t: { zh: '來 712 聊聊', en: 'Drop by Room 712' }, d: { zh: '到志希館 712 跟學長姐聊實驗室的日常，再跟老師約時間。', en: 'Chat with current students in Zhixi 712, then book a time with the advisor.' } },
  { t: { zh: '挑題目', en: 'Pick a topic' }, d: { zh: '從六個研究領域挑，或帶你自己想做的題目來，先用一個小資料集做做看。', en: 'Pick one of the six research areas or bring your own idea, and start with a small dataset.' } },
];
// Department rules are from the NCU IM master's regulations (2025-06-18 version);
// the lab-side pace (when topics settle, internships) was approved by the owner on 2026-11-27.
const road: { when: Bi; t: Bi; d: Bi; rule?: Bi }[] = [
  { when: { zh: 'M0 · 入學前', en: 'M0 · Before you start' }, t: { zh: '先認識、先補課', en: 'Meet us, fill the gaps' },
    d: { zh: '來 712 聊聊，讀幾篇學長姐的碩論。沒修過資料庫管理、系統分析與設計的話，這兩門是先修課，要先排進課表。', en: 'Visit Room 712 and read a few past theses. Database management and systems analysis & design are prerequisites; plan them in if you have not taken them.' },
    rule: { zh: '先修課不列入畢業學分', en: 'Prerequisites do not count toward the degree' } },
  { when: { zh: 'M1 · 上學期', en: 'M1 · Fall' }, t: { zh: '修課，跟著開會', en: 'Courses and weekly meetings' },
    d: { zh: '修必修課（管理資訊系統、研究方法、軟體工程等），先聽學長姐報告，從一個小資料集開始動手。', en: 'Take the core courses (MIS, research methods, software engineering and more), sit in on the weekly meeting, and start on a small dataset.' },
    rule: { zh: '學分抵免在第一或第二學期辦', en: 'Credit transfer: first or second semester only' } },
  { when: { zh: 'M1 · 下學期', en: 'M1 · Spring' }, t: { zh: '定下題目', en: 'Settle on a topic' },
    d: { zh: '選定研究領域和題目，讀文獻、跑第一版實驗。暑假可以去實習，學長姐去過台積電、工研院。', en: 'Pick an area and a topic, read the literature and run a first experiment. The summer is open for internships; past members interned at TSMC and ITRI.' },
    rule: { zh: '開學第二週結束前交論文指導同意書', en: 'Advisor agreement due by the end of week 2' } },
  { when: { zh: 'M2 · 上學期', en: 'M2 · Fall' }, t: { zh: '做實驗、開始寫', en: 'Experiments and writing' },
    d: { zh: '完成主要實驗，開始寫論文，輪到自己報告進度。有興趣的話可以把成果整理成工作論文。', en: 'Finish the main experiments and start writing; now you report at the meeting. If it works out, the results can become a working paper.' },
    rule: { zh: '碩士班進修英文一學年，70 分以上才能申請口試', en: 'One year of graduate English, 70 or above, before the defense' } },
  { when: { zh: 'M2 · 下學期', en: 'M2 · Spring' }, t: { zh: '口試、畢業', en: 'Defend and graduate' },
    d: { zh: '交論文初稿、論文比對報告和學術倫理課程證明，申請口試；口試委員 3–5 位，三分之一以上來自校外。', en: 'Submit the draft, a similarity report and the research-ethics course record to apply for the defense; the committee has 3–5 members, at least a third from outside NCU.' },
    rule: { zh: '在校曆規定的期限內申請口試', en: 'Apply by the deadline in the academic calendar' } },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: t(f.q, lang), acceptedAnswer: { '@type': 'Answer', text: t(f.a, lang) } })),
};
---
<Base lang={lang} title={zh ? '中央資管碩士班找指導老師：加入我們' : 'Join us: master’s students at NCU IM'} description={zh ? 'IFA Lab 招收碩士班學生：題目不限金融，資訊管理領域的方向都可以討論，每週 meeting 一次、壓力不大、可以實習。學長姐畢業後去了台積電、中華電信研究院、世界先進。' : 'IFA Lab takes master’s students on any information-management topic: one meeting a week, internships welcome. Graduates went on to TSMC, Chunghwa Telecom Labs and VIS.'} jsonld={[faqLd]}>
  <div class="wrap section">
    <div class="section-head">
      <h1 class="lines">{(zh ? ['加入 IFA Lab：', '碩士班與研究助理'] : ['Join IFA Lab:', 'master’s students and RAs']).map((l, i) => <>{i && !zh ? ' ' : ''}<span>{l}</span></>)}</h1>
      <p class="muted">{zh ? '2026 年秋天收了 3 位碩士生，題目不限金融。' : 'Three master’s students joined in fall 2026. Topics are not limited to finance.'}</p>
      <p class="cta top"><a class="btn" href={`mailto:${lab.contact.email}`}>{zh ? `寄信給${advisor.name.zh}老師` : `Email Prof. ${advisor.name.en}`}</a></p>
    </div>
    <section class="steps-wrap" aria-labelledby="steps-h">
      <h2 id="steps-h">{zh ? '三步加入' : 'How to join, in three steps'}</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="num" aria-hidden="true">{i + 1}</span><h3>{t(s.t, lang)}</h3><p>{t(s.d, lang)}</p></li>
        ))}
      </ol>
    </section>
    <section class="road-wrap" aria-labelledby="road-h">
      <h2 id="road-h">{zh ? '兩年怎麼過' : 'Two years, step by step'}</h2>
      <ol class="road">
        {road.map((r) => (
          <li>
            <p class="when">{t(r.when, lang)}</p>
            <h3>{t(r.t, lang)}</h3>
            <p class="d">{t(r.d, lang)}</p>
            {r.rule && <p class="rule"><b>{zh ? '系規' : 'Dept. rule'}</b> {t(r.rule, lang)}</p>}
          </li>
        ))}
      </ol>
    </section>
    <section class="faq-wrap" aria-labelledby="faq-h">
      <h2 id="faq-h">{zh ? '大家常問的' : 'What people ask'}</h2>
      <div class="faq">
        {faq.map((f) => (
          <section class="qa">
            <h3>{t(f.q, lang)}</h3>
            <p>{t(f.a, lang)}</p>
          </section>
        ))}
      </div>
    </section>
    <section class="where" aria-labelledby="where-h">
      <h2 id="where-h">{zh ? '學長姐畢業後去哪裡' : 'Where graduates went'}</h2>
      <ul>
        {gone.map((m) => (
          <li><strong>{t(m.data.now, lang)}</strong><a href={href(lang, `members/${m.id}`)}>{t(m.data.name, lang)}</a><span class="muted">{t(m.data.headline, lang)}</span></li>
        ))}
      </ul>
    </section>
    <section class="past" aria-labelledby="past-h">
      <h2 id="past-h">{zh ? '學長姐做過的題目' : 'Topics past members wrote theses on'}</h2>
      <ul>
        {thesisRows.map(({ x, m }) => { const a = areas.find((y) => y.key === x.data.area); return (
          <li style={`--c: var(--clay-${a?.clay ?? 'grey'})`}>
            <BiText text={x.data.title} lang={lang} />
            <p class="muted small">{m ? <a href={href(lang, `members/${x.data.member}`)}>{t(m.data.name, lang)}</a> : x.data.member} ·&nbsp;{zh ? `${x.data.academicYear} 學年度` : `AY ${x.data.academicYear + 1911}–${String(x.data.academicYear + 1912).slice(2)}`}{a && <> ·&nbsp;<span class="area"><i aria-hidden="true"></i>{t(a.name, lang)}</span></>}</p>
          </li>
        ); })}
      </ul>
    </section>
    <p class="cta"><a class="btn" href={`mailto:${lab.contact.email}`}>{zh ? `寄信給${advisor.name.zh}老師` : `Email Prof. ${advisor.name.en}`}</a> <button type="button" class="btn secondary" data-ask-open>{zh ? '還有問題？問 K 喵' : 'More questions? Ask K-meow'}</button></p>
  </div>
</Base>

<style>
  .road-wrap { margin-top: var(--space-9); display: grid; gap: var(--space-4); }
  .road-wrap h2 { font-size: clamp(24px, 2.4vw, 32px); }
  /* five stops down one rail on the left (five columns at 1440 left 7–12 characters a line) */
  .road { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-6); max-width: 960px; }
  .road li { position: relative; display: grid; gap: var(--space-2); align-content: start; padding: 0 0 0 var(--space-7); }
  .road li::before { content: ''; position: absolute; top: 0; bottom: calc(-1 * var(--space-6)); left: 7px; width: 3px; border-radius: 2px; background: color-mix(in oklab, var(--ink) 12%, transparent); }
  .road li:last-child::before { bottom: 0; }
  .road li::after { content: ''; position: absolute; top: 0; left: 0; width: 18px; height: 18px; border-radius: 6px; background: var(--clay-sun); box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.16), 0 2px 4px var(--lo); }
  .road li:last-child::after { background: var(--clay-up); }
  .road .when { font: 600 14px/1.3 var(--f-mono); color: var(--ink-2); }
  .road h3 { font-size: 20px; }
  .road p { font-size: 16px; line-height: 1.7; }
  .road .rule b { margin-right: var(--space-2); font-weight: 600; color: var(--ink); }
  .road .rule { font-size: 14px; line-height: 1.5; color: var(--ink-2); padding-top: var(--space-2); border-top: 1px dashed color-mix(in oklab, var(--ink) 18%, transparent); }
  /* wide screens: when and what on the left, the details beside them */
  @media (min-width: 1000px) {
    .road li { grid-template-columns: 220px minmax(0, 1fr); column-gap: var(--space-6); }
    .road .when, .road h3 { grid-column: 1; }
    .road .d { grid-column: 2; grid-row: 1 / span 2; }
    .road .rule { grid-column: 2; }
  }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .steps-wrap, .faq-wrap, .past, .where { margin-top: var(--space-9); display: grid; gap: var(--space-5); }
  .steps-wrap h2, .faq-wrap h2, .past h2, .where h2 { font-size: clamp(24px, 2.4vw, 32px); }
  /* the one slab on the page: what to do next, right under the hero */
  .steps-wrap {
    margin-top: 0; padding: var(--space-7); border-radius: var(--r-lg); background: var(--tint-warm);
    box-shadow: 10px 14px 28px var(--lo), inset 0 2px 0 var(--hi), inset -6px -8px 14px rgb(0 0 0 / 0.05);
  }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); counter-reset: s; }
  .steps li { display: grid; gap: var(--space-2); align-content: start; position: relative; }
  /* a dashed path joins the numbered bricks */
  .steps li:not(:last-child)::after { content: ''; position: absolute; top: 22px; left: 60px; right: calc(-1 * var(--space-6) + 8px); border-top: 2px dashed color-mix(in oklab, var(--ink) 25%, transparent); }
  .num { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font: 600 22px/1 var(--f-display); color: #1d2633; background: var(--clay-sun); box-shadow: 3px 5px 10px var(--lo), inset -3px -4px 6px rgb(0 0 0 / 0.15), inset 3px 3px 6px rgb(255 255 255 / 0.35); margin-bottom: var(--space-2); }
  .steps h3 { font-size: 20px; }
  .steps p { margin: 0; }
  .faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8); }
  .qa { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-4); border-top: 1px solid color-mix(in oklab, var(--ink) 12%, transparent); }
  .qa h3 { font-size: 19px; }
  .qa p { margin: 0; }
  .where ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-6); }
  .where li { display: grid; gap: var(--space-1); align-content: start; padding-top: var(--space-3); border-top: 3px solid var(--clay-up); }
  .where li strong { font: 600 22px/1.3 var(--f-display); word-break: keep-all; }
  .where li a { font-weight: 600; }
  .where li .muted { font-size: 14px; }
  .past ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); max-width: 52em; }
  .past li { display: grid; gap: var(--space-1); padding-left: var(--space-4); box-shadow: inset 3px 0 0 var(--c); }
  /* same six-colour area code as the research page */
  .past .area { white-space: nowrap; }
  .past .area i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; background: var(--c); vertical-align: 0; }
  .small { font-size: 14px; }
  .cta.top { margin: var(--space-4) 0 var(--space-7); display: flex; align-items: end; gap: var(--space-4); }
  .when { margin-top: var(--space-4); }
  @media (max-width: 767px) {
    .steps, .faq { grid-template-columns: 1fr; }
    .steps li:not(:last-child)::after { display: none; }
    .steps-wrap { padding: var(--space-6) var(--space-5); }
    .steps-wrap, .faq-wrap, .past, .where { margin-top: var(--space-8); }
    .steps-wrap { margin-top: 0; }
  }
</style>
