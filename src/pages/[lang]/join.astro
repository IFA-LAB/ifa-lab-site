---
import LabCat from '@/components/LabCat.astro';
import Mate from '@/components/Mate.astro';
import Base from '@/layouts/Base.astro';
import { lab, advisor, areas } from '@/data/lab';
import { ui, t, href, type Bi, type Locale } from '@/i18n/ui';
import { langPaths } from '@/lib/content';
import { getCollection, getEntry } from 'astro:content';
import BiText from '@/components/Bi.astro';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';

const faq: { q: Bi; a: Bi }[] = [
  {
    q: { zh: 'IFA Lab 適合什麼樣的學生？', en: 'Who is IFA Lab for?' },
    a: { zh: '對資訊科技與金融都有興趣，想用 AI、機器學習與資料科學解決金融問題的大學部與碩士班學生。', en: 'Undergraduate and master’s students interested in both IT and finance who want to solve financial problems with AI, machine learning and data science.' },
  },
  {
    q: { zh: '大學部學生可以做什麼？', en: 'What can undergraduates work on?' },
    a: { zh: '可以參與金融應用設計、複雜金融資料的網頁視覺化、用機器學習或 AI 預測資產價格，以及破產分析與投資組合管理等專題。', en: 'Projects such as designing financial applications, web visualizations of complex financial data, predicting asset prices with machine learning or AI, and bankruptcy analysis and portfolio management.' },
  },
  {
    q: { zh: '碩士班要先準備什麼？', en: 'What should master’s applicants prepare?' },
    a: { zh: '扎實的程式基礎（Python、R 或類似語言）、對金融產業的基本理解，以及對系統開發、資料科學或實證財務的興趣。', en: 'A solid programming foundation (Python, R or similar), a good understanding of the financial industry, and interest in system development, data science or empirical finance.' },
  },
  {
    q: { zh: '要怎麼聯絡實驗室？', en: 'How do I get in touch?' },
    a: { zh: `寄信給邱信瑜老師（${lab.contact.email}），簡單介紹自己和有興趣的題目；也可以到志希館 712 實驗室找我們，或到管理二館 I1-932 找老師。`, en: `Email Prof. Hsin-Yu Chiu (${lab.contact.email}) with a short introduction and the topics you are interested in, or visit the lab in Room 712, Zhixi Building, or Prof. Chiu’s office, I1-932, Management Building II.` },
  },
];
const theses = (await getCollection('theses')).sort((a, b) => b.data.academicYear - a.data.academicYear);
const thesisRows = await Promise.all(theses.map(async (x) => ({ x, m: await getEntry('members', x.data.member) })));
const crew = (await getCollection('members')).filter((m) => !m.data.placeholder).sort((a, b) => a.data.cohort - b.data.cohort || a.data.order - b.data.order);
const steps: { t: Bi; d: Bi }[] = [
  { t: { zh: '寄一封信', en: 'Send an email' }, d: { zh: '三五句話介紹自己、修過的課，和你好奇的題目。想考碩士班的話，在甄試或考試報名之前就來信，比較有時間先聊題目。', en: 'A few lines about you, the courses you took and what you are curious about. Applying for the master’s program? Write before the application window so there is time to talk topics.' } },
  { t: { zh: '來 712 聊聊', en: 'Drop by Room 712' }, d: { zh: '到志希館 712 跟學長姐聊實驗室的日常，再跟老師約時間。', en: 'Chat with current students in Zhixi 712, then book a time with the advisor.' } },
  { t: { zh: '挑一塊積木', en: 'Pick a block' }, d: { zh: '從六個研究領域選題目，先從一個小資料集開始疊。', en: 'Choose a topic from the six research areas and start stacking with a small dataset.' } },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: t(f.q, lang), acceptedAnswer: { '@type': 'Answer', text: t(f.a, lang) } })),
};
---
<Base lang={lang} title={t(ui.nav.join, lang)} description={zh ? 'IFA Lab 招收對 AI 與金融有興趣的大學部與碩士班學生：可以做什麼、要準備什麼、怎麼聯絡。' : 'IFA Lab welcomes undergraduate and master’s students interested in AI and finance: what you can work on, what to prepare and how to reach us.'} jsonld={[faqLd]}>
  <div class="wrap section">
    <div class="section-head">
      <p class="eyebrow">{t(ui.nav.join, lang)}</p>
      <h1 class="lines">{(zh ? ['想用 AI 做金融研究？', '來疊積木吧'] : ['Want to do finance research with AI?', 'Come build with us']).map((l) => <span>{l}</span>)}</h1>
      <p class="muted">{zh ? '我們招收大學部專題生與碩士班學生。下面是最常被問到的四個問題。' : 'We recruit undergraduate project students and master’s students. Here are the four questions we get most.'}</p>
      <div class="crowd" aria-label={zh ? '現在的成員' : 'Current members'}>
        {crew.map((m) => <Mate member={m} lang={lang} size={56} />)}
      </div>
      <p class="muted when">{zh ? '他們每個人都是從一封信開始的。' : 'Every one of them started with an email.'}</p>
      <p class="cta top"><a class="btn" href={`mailto:${lab.contact.email}`}>{zh ? `寄信給${advisor.name.zh}老師` : `Email Prof. ${advisor.name.en}`}</a><LabCat lang={lang} size={64} bubble="right" lines={[{ zh: '信裡寫你好奇的題目，比寫自傳有用。', en: 'Write about a question you are curious about. It beats a CV.' }, { zh: '不會寫程式也沒關係，學長姐會帶。', en: 'Cannot code yet? Seniors will help you start.' }]} /></p>
    </div>
    <div class="faq">
      {faq.map((f) => (
        <section class="qa clay">
          <h2>{t(f.q, lang)}</h2>
          <p>{t(f.a, lang)}</p>
        </section>
      ))}
    </div>
    <section class="steps-wrap" aria-labelledby="steps-h">
      <h2 id="steps-h">{zh ? '三步加入' : 'Three steps in'}</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="clay"><span class="num" aria-hidden="true">{i + 1}</span><h3>{t(s.t, lang)}</h3><p class="muted">{t(s.d, lang)}</p></li>
        ))}
      </ol>
    </section>
    <section class="past" aria-labelledby="past-h">
      <h2 id="past-h">{zh ? '學長姐做過的題目' : 'Topics past members wrote theses on'}</h2>
      <ul>
        {thesisRows.map(({ x, m }) => { const a = areas.find((y) => y.key === x.data.area); return (
          <li style={`--c: var(--clay-${a?.clay ?? 'grey'})`}>
            <BiText text={x.data.title} lang={lang} />
            <p class="muted small">{m ? <a href={href(lang, `members/${x.data.member}`)}>{t(m.data.name, lang)}</a> : x.data.member} · {zh ? `${x.data.academicYear} 學年度` : `AY ${x.data.academicYear + 1911}`}{a && <> · <span class="area"><i aria-hidden="true"></i>{t(a.name, lang)}</span></>}</p>
          </li>
        ); })}
      </ul>
    </section>
    <p class="cta"><a class="btn" href={`mailto:${lab.contact.email}`}>{zh ? `寄信給${advisor.name.zh}老師` : `Email Prof. ${advisor.name.en}`}</a> <a class="btn secondary" href={href(lang, 'members')}>{zh ? '先認識成員' : 'Meet the members'}</a></p>
  </div>
</Base>

<style>
  .faq { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .qa { padding: var(--space-6); display: grid; gap: var(--space-3); align-content: start; }
  .qa h2 { font-size: 21px; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .steps-wrap, .past { margin-top: var(--space-8); display: grid; gap: var(--space-5); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .steps li { padding: var(--space-6) var(--space-5) var(--space-5); display: grid; gap: var(--space-2); align-content: start; position: relative; }
  .num { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font: 600 22px/1 var(--f-display); color: var(--ink); background: var(--clay-sun); box-shadow: 3px 5px 10px var(--lo), inset -3px -4px 6px rgb(0 0 0 / 0.15), inset 3px 3px 6px rgb(255 255 255 / 0.35); margin-bottom: var(--space-2); }
  .steps h3 { font-size: 20px; }
  .past ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); max-width: 52em; }
  .past li { display: grid; gap: var(--space-1); padding-left: var(--space-4); box-shadow: inset 3px 0 0 var(--c); }
  /* same six-colour area code as the research page */
  .past .area { white-space: nowrap; }
  .past .area i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; background: var(--c); vertical-align: 0; }
  .small { font-size: 14px; }
  @media (max-width: 767px) { .steps { grid-template-columns: 1fr; } }
  .cta.top { margin: var(--space-4) 0 var(--space-7); display: flex; align-items: end; gap: var(--space-4); }
  .crowd { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-4); margin-top: var(--space-5); }
  .when { margin-top: var(--space-4); }
  @media (max-width: 767px) { .faq { grid-template-columns: 1fr; } }
</style>
