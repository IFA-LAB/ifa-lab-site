---
import Base from '@/layouts/Base.astro';
import ClayCandles from '@/components/ClayCandles.astro';
import ClayFigure from '@/components/ClayFigure.astro';
import ClayKline from '@/components/three/ClayKline';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import advisorPhoto from '@/assets/advisor.jpg';
import { lab, areas, advisor } from '@/data/lab';
import { ui, t, href, type Locale } from '@/i18n/ui';
import { langPaths, membersByCohort } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';

const pubs = await getCollection('publications');
const theses = await getCollection('theses');
const grants = await getCollection('grants');
const cohorts = await membersByCohort();
const memberCount = cohorts.reduce((n, [, ms]) => n + ms.length, 0);

const perArea = (k: string) => pubs.filter((p) => p.data.area === k).length + theses.filter((x) => x.data.area === k).length;
const stats = [
  { n: pubs.filter((p) => p.data.kind === 'journal').length, label: t(ui.pubs.journal, lang) },
  { n: pubs.filter((p) => p.data.kind === 'working').length, label: t(ui.pubs.working, lang) },
  { n: grants.length, label: t(ui.pubs.grants, lang) },
  { n: theses.length, label: t(ui.pubs.theses, lang) },
  { n: memberCount, label: zh ? '位成員' : 'Members' },
];
const boardEn: Record<string, string> = { empirical: 'Empirical', behavioral: 'Behavioral', pricing: 'Pricing', ai: 'AI / ML', forecast: 'Forecasting', apps: 'Apps & Viz' };
const titleLines = zh ? ['智能金融', '分析實驗室'] : ['Intelligent Finance', 'Analytics Lab'];
const description = zh
  ? '國立中央大學資訊管理學系的智能金融分析實驗室（IFA Lab），由邱信瑜副教授主持，研究實證財務、行為財務、資產定價、AI 與機器學習、財務預測與金融應用。'
  : 'IFA Lab (Intelligent Finance Analytics Lab) at National Central University, led by Associate Professor Hsin-Yu Chiu, researches empirical and behavioral finance, asset pricing, AI and machine learning, forecasting and financial applications.';
---
<Base lang={lang} title={lab.short} description={description}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="eyebrow">{lab.short} · NCU {zh ? '資訊管理學系' : 'Information Management'}</p>
        <h1 id="hero-h">{titleLines.map((l) => <span>{l}</span>)}</h1>
        <p class="lede">{zh
          ? '我們把財務理論、資料與 AI 疊在一起：從台股實證、投資人行為到圖神經網路預測，做出決策者用得上的模型。'
          : 'We stack finance theory, data and AI together: from Taiwan market evidence and investor behavior to graph-network forecasting, building models decision-makers can use.'}</p>
        <div class="cta">
          <a class="btn" href={href(lang, 'research')}>{zh ? '看研究成果' : 'See our research'}</a>
          <a class="btn secondary" href={href(lang, 'join')}>{t(ui.nav.join, lang)}</a>
        </div>
      </div>
      <div class="visual" data-kline>
        <ClayCandles label={zh ? '黏土做的 K 線模型：紅色上漲、綠色下跌的積木 K 棒，上方漂著金幣' : 'A clay candlestick model: red rising and green falling blocks with floating coins'} />
        <ClayKline
          client:visible
          bars={areas.map((a) => ({ key: a.key, label: zh ? a.name.zh : boardEn[a.key], name: t(a.name, lang), count: perArea(a.key), href: href(lang, `research#${a.key}`) }))}
          hint={zh ? '每根 K 棒是一個研究領域，滑過看看、點進去' : 'Each candle is a research area. Hover, then click'}
          hintTouch={zh ? '每根 K 棒是一個研究領域，點一下看論文' : 'Each candle is a research area. Tap one'}
          unit={zh ? '篇' : 'works'}
          wake={zh ? '點一下，讓 K 棒動起來' : 'Tap to bring the candles to life'}
        />
      </div>
    </div>
    <div class="wrap">
      <dl class="ticker clay" aria-label={zh ? '研究成果數量' : 'Output at a glance'}>
        {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.n}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="areas-h">
    <div class="section-head">
      <p class="eyebrow">{zh ? '研究領域' : 'Research areas'}</p>
      <h2 id="areas-h">{zh ? 'IFA Lab 在研究什麼？' : 'What does IFA Lab research?'}</h2>
      <p class="muted">{zh
        ? '六個領域，每一塊積木都是一篇論文或碩士論文。'
        : 'Six areas. Every block is a paper or a master’s thesis.'}</p>
    </div>
    <ul class="areas">
      {areas.map((a) => (
        <li>
          <a class="area clay" href={href(lang, `research#${a.key}`)} style={`--c: var(--clay-${a.clay})`}>
            <span class="stack" aria-hidden="true">{Array.from({ length: Math.min(perArea(a.key), 8) }, () => <i></i>)}</span>
            <h3>{t(a.name, lang)}</h3>
            <p class="muted">{t(a.blurb, lang)}</p>
            <span class="count">{perArea(a.key)} {zh ? '篇' : perArea(a.key) === 1 ? 'work' : 'works'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="shelf-h">
    <div class="section-head">
      <p class="eyebrow">{t(ui.nav.members, lang)}</p>
      <h2 id="shelf-h">{zh ? '一屆一層的成員書架' : 'One shelf per cohort'}</h2>
      <p class="muted">{zh ? '點一個公仔，看他們在做什麼。' : 'Pick a figure to see what they work on.'}</p>
    </div>
    <div class="shelf">
      {cohorts.map(([c, ms]) => (
        <div class="row">
          <p class="eyebrow">{t(ui.cohort(c), lang)}</p>
          <ul>
            {ms.map((m) => (
              <li>
                <a href={href(lang, `members/${m.id}`)}>
                  <ClayFigure clay={m.data.figure.clay} accessory={m.data.figure.accessory} placeholder={m.data.placeholder} size={92} />
                  <span>{t(m.data.name, lang)}</span>
                  {m.data.placeholder && <small class="soon">{t(ui.placeholderNote, lang)}</small>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section mission" aria-labelledby="mission-h">
    <div>
      <p class="eyebrow">{zh ? '使命' : 'Mission'} · {t(lab.tagline, lang)}</p>
      <h2 id="mission-h" class="quote">{zh ? '用台灣市場的資料檢驗財務理論，再把它做成用得上的模型。' : 'We test finance theory on Taiwan market data, then turn it into models people can use.'}</h2>
      <p class="lede">{t(lab.mission[0], lang)}</p>
    </div>
    <a class="advisor clay" href={href(lang, 'advisor')}>
      <Image class="advisor-photo" src={advisorPhoto} alt="" width={128} height={128} densities={[1, 2]} format="webp" />
      <span>
        <span class="eyebrow">{t(ui.nav.advisor, lang)}</span>
        <strong>{t(advisor.name, lang)}</strong>
        <span class="muted">{t(advisor.title, lang)}</span>
        <span class="go">{zh ? '認識老師 →' : 'Meet the advisor →'}</span>
      </span>
    </a>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); overflow-x: clip; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-5); align-items: center; }
  .copy { display: grid; gap: var(--space-5); position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(44px, 6.6vw, 96px); line-height: 1.08; }
  .hero h1 span { display: block; white-space: nowrap; }
  :global(html:lang(en)) .hero h1 { font-size: clamp(40px, 5vw, 68px); letter-spacing: -0.02em; }
  :global(html:lang(en)) .lede { max-width: 26em; }
  .lede { font-size: 19px; color: var(--ink-2); max-width: 30em; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* the scene bleeds to the right edge of the viewport on wide screens */
  .visual { position: relative; margin-right: min(0px, calc((var(--page) - 100vw) / 2)); aspect-ratio: 7 / 5.4; }
  .visual :global(.kline-canvas) { position: absolute; inset: 0; }
  .visual :global(.kline-canvas canvas) { touch-action: pan-y; }
  .visual[data-live] :global(.stage > *) { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .visual :global(.kline-hint) {
    position: absolute; left: 50%; bottom: -6px; transform: translateX(-50%); white-space: nowrap;
    font: 500 14px/1.4 var(--f-body); color: var(--ink-2);
    background: var(--surface); padding: 8px 16px; border-radius: var(--r-full); box-shadow: 4px 6px 14px var(--lo);
  }
  .visual :global(.kline-hint b) { color: var(--ink); }

  .ticker { margin: var(--space-6) 0 0; padding: var(--space-5) var(--space-6); display: grid; grid-template-columns: repeat(5, 1fr); }
  .ticker > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-1); padding-inline: var(--space-5); }
  .ticker > div + div { box-shadow: inset 1px 0 0 var(--line); }
  .ticker > div:first-child { padding-left: 0; }
  .ticker dd { margin: 0; font: 600 clamp(40px, 4.4vw, 60px)/1 var(--f-display); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .ticker dt { font-size: 15px; color: var(--ink-2); }

  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .area { display: grid; gap: var(--space-2); padding: var(--space-5); text-decoration: none; color: var(--ink); height: 100%; transition: transform var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .area:hover { transform: translateY(-3px); } }
  .stack { display: flex; gap: 4px; align-items: end; height: 40px; }
  .stack i { width: 18px; height: 18px; border-radius: 5px; background: var(--c); box-shadow: inset -2px -3px 4px rgb(0 0 0 / 0.18), inset 2px 2px 4px rgb(255 255 255 / 0.35); }
  .stack i:nth-child(even) { height: 26px; }
  .count { font: 500 14px/1 var(--f-mono); color: var(--ink-2); }

  /* 2×2 bookcase: each cohort is one shelf with a plank */
  .shelf { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7) var(--space-6); }
  .row { position: relative; display: grid; gap: var(--space-3); padding-bottom: var(--space-4); }
  /* a clay plank: lit top edge, darker front, soft cast shadow */
  .row::after { content: ''; position: absolute; inset: auto -8px 0; height: 18px; border-radius: 9px; background: var(--surface); box-shadow: 0 10px 18px var(--lo), inset 0 3px 0 var(--hi), inset 0 -7px 0 var(--surface-2); }
  .row ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .row a { display: grid; justify-items: center; gap: var(--space-1); text-decoration: none; color: var(--ink); font-size: 16px; font-weight: 500; padding: var(--space-2); border-radius: var(--r-md); transition: transform var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .row a:hover { transform: translateY(-4px); } }

  .soon { font-size: 13px; font-weight: 400; color: var(--ink-2); margin-top: -2px; }
  .mission { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-8); align-items: center; }
  .mission > div { display: grid; gap: var(--space-4); }
  .quote { font-size: clamp(28px, 3.2vw, 42px); line-height: 1.3; }
  .advisor { display: flex; gap: var(--space-5); align-items: center; padding: var(--space-5); text-decoration: none; color: var(--ink); transition: transform var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .advisor:hover { transform: translateY(-3px); } }
  .advisor > span:last-child { display: grid; gap: 2px; }
  .advisor-photo { width: 128px; height: 128px; border-radius: var(--r-lg); object-fit: cover; flex: none; box-shadow: 4px 6px 14px var(--lo); }
  .advisor strong { font: 600 28px/1.3 var(--f-display); }
  .go { margin-top: var(--space-2); font-weight: 600; color: var(--accent); }

  @media (max-width: 1023px) {
    .hero-grid, .mission { grid-template-columns: 1fr; }
    .visual { margin-right: 0; }
    .areas { grid-template-columns: repeat(2, 1fr); }
    .ticker { grid-template-columns: repeat(3, 1fr); row-gap: var(--space-5); }
    .ticker > div:nth-child(4) { padding-left: 0; box-shadow: none; }
  }
  @media (max-width: 767px) {
    .hero { padding-top: var(--space-4); }
    .visual { margin-inline: -16px; aspect-ratio: 1 / 0.8; margin-bottom: var(--space-6); }
    .visual :global(.kline-hint) { bottom: calc(-1 * var(--space-6)); }
    .ticker > div:last-child:nth-child(odd) { grid-column: 1 / -1; padding-left: 0; box-shadow: none; }
    .area h3 { font-size: 18px; word-break: keep-all; }
    .areas { gap: var(--space-3); }
    .area { padding: var(--space-4); }
    .area .muted { display: none; }
    .shelf { grid-template-columns: 1fr; }
    .ticker { grid-template-columns: repeat(2, 1fr); padding: var(--space-5); }
    .ticker > div, .ticker > div:nth-child(4) { padding: 0 var(--space-4); box-shadow: none; }
    .ticker > div:nth-child(odd) { padding-left: 0; }
    .ticker > div:nth-child(even) { box-shadow: inset 1px 0 0 var(--line); }
    .advisor { flex-direction: column; align-items: start; }
  }
</style>
