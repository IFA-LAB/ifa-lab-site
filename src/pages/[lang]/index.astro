---
import LabCat from '@/components/LabCat.astro';
import Mate from '@/components/Mate.astro';
import Base from '@/layouts/Base.astro';
import ClayCandles from '@/components/ClayCandles.astro';
import ClayKline from '@/components/three/ClayKline';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import advisorPhoto from '@/assets/advisor.jpg';
import { lab, areas, advisor } from '@/data/lab';
import { ui, t, href, type Locale } from '@/i18n/ui';
import { langPaths, membersByCohort } from '@/lib/content';
import { labEvents, newestFirst, type Kind } from '@/lib/history';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';

const pubs = await getCollection('publications');
const theses = await getCollection('theses');
const grants = await getCollection('grants');
const cohorts = await membersByCohort();
const memberCount = cohorts.reduce((n, [, ms]) => n + ms.length, 0);

const perArea = (k: string) => pubs.filter((p) => p.data.area === k).length + theses.filter((x) => x.data.area === k).length;
const stats = [
  { n: pubs.filter((p) => p.data.kind === 'journal').length, label: t(ui.pubs.journal, lang) },
  { n: pubs.filter((p) => p.data.kind === 'working').length, label: t(ui.pubs.working, lang) },
  { n: grants.length, label: t(ui.pubs.grants, lang) },
  { n: theses.length, label: t(ui.pubs.theses, lang) },
  { n: memberCount, label: zh ? '位成員' : 'Members' },
];
// latest news: the newest event of each kind, three cards
const latest = (await labEvents(lang)).sort(newestFirst).filter((e, i, all) => all.findIndex((x) => x.kind === e.kind) === i).slice(0, 3);
const kindLook: Record<Kind, { clay: string; name: { zh: string; en: string } }> = {
  paper: { clay: 'blue', name: { zh: '論文', en: 'Paper' } },
  award: { clay: 'up', name: { zh: '獎項', en: 'Award' } },
  grant: { clay: 'sun', name: { zh: '計畫', en: 'Grant' } },
  thesis: { clay: 'down', name: { zh: '碩士論文', en: 'Thesis' } },
  milestone: { clay: 'pink', name: { zh: '里程碑', en: 'Milestone' } },
};
const fmtDate = (d: string) => (d.length === 4 ? d : zh ? `${d.slice(0, 4)} 年 ${+d.slice(5, 7)} 月` : new Date(`${d}-01`).toLocaleString('en', { month: 'short', year: 'numeric' }));
const crew = cohorts.flatMap(([, ms]) => ms).slice(0, 8);
// timeline for the board: works per area counted up to each year; accepted papers join at "now"
const dated = [
  ...pubs.map((p) => ({ area: p.data.area, year: p.data.status === 'forthcoming' ? Infinity : p.data.year })),
  ...theses.map((x) => ({ area: x.data.area, year: x.data.academicYear + 1912 })),
];
const upTo = (y: number) => Object.fromEntries(areas.map((a) => [a.key, dated.filter((w) => w.area === a.key && w.year <= y).length]));
const stepYears = [...new Set(dated.map((w) => w.year).filter(Number.isFinite))].sort((a, b) => a - b);
const steps = [...stepYears.map((y) => ({ label: String(y), counts: upTo(y) })), { label: zh ? '現在' : 'Now', counts: upTo(Infinity) }]
  .filter((st, i, all) => i === all.length - 1 || JSON.stringify(st.counts) !== JSON.stringify(all[all.length - 1].counts));
const boardEn: Record<string, string> = { empirical: 'Empirical', behavioral: 'Behavioral', pricing: 'Pricing', ai: 'AI / ML', forecast: 'Forecasting', apps: 'Apps & Viz' };
const titleLines = zh ? ['智能金融', '分析實驗室'] : ['Intelligent Finance', 'Analytics Lab'];
const description = zh
  ? '國立中央大學資訊管理學系的智能金融分析實驗室（IFA Lab），由邱信瑜副教授主持，研究實證財務、行為財務、資產定價、AI 與機器學習、財務預測與金融應用。'
  : 'IFA Lab (Intelligent Finance Analytics Lab) at National Central University, led by Associate Professor Hsin-Yu Chiu, researches empirical and behavioral finance, asset pricing, AI and machine learning, forecasting and financial applications.';
---
<Base lang={lang} title={lab.short} description={description}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="eyebrow">{lab.short} · NCU {zh ? '資訊管理學系' : 'Information Management'}</p>
        <h1 id="hero-h">{titleLines.map((l) => <span>{l}</span>)}</h1>
        <p class="lede">{zh
          ? '我們把財務理論、資料與 AI 疊在一起：從台股實證、投資人行為到圖神經網路預測，做出決策者用得上的模型。'
          : 'We stack finance theory, data and AI together: from Taiwan market evidence and investor behavior to graph-network forecasting, building models decision-makers can use.'}</p>
        <div class="cta">
          <a class="btn" href={href(lang, 'research')}>{zh ? '看研究成果' : 'See our research'}</a>
          <a class="btn secondary" href={href(lang, 'join')}>{t(ui.nav.join, lang)}</a>
        </div>
      </div>
      <div class="visual" data-kline>
        <ClayCandles bars={areas.map((a) => ({ clay: a.clay, count: perArea(a.key) }))} label={zh ? '黏土做的 K 線模型：每個研究領域一根積木 K 棒，越高代表成果越多，上方漂著金幣' : 'A clay candlestick model: one block per research area, taller for more work, with floating coins'} />
        <ClayKline
          client:visible
          bars={areas.map((a) => ({ key: a.key, label: zh ? a.name.zh : boardEn[a.key], name: t(a.name, lang), count: perArea(a.key), href: href(lang, `research#${a.key}`), clay: a.clay }))}
          hint={zh ? '每根 K 棒是一個研究領域，滑過看看、點進去' : 'Each candle is a research area. Hover, then click'}
          hintTouch={zh ? '每根 K 棒是一個研究領域，點一下看論文' : 'Each candle is a research area. Tap one'}
          unit={zh ? '篇' : 'works'}
          wake={zh ? '點一下，讓 K 棒動起來' : 'Tap to bring the candles to life'}
          steps={steps}
          text={zh
            ? { play: '播放實驗室的成長', pause: '暫停', year: '年份', total: '篇累積', replay: '按 ▶ 從 {y} 播', more: '其他 +', coin: ['叮！研究經費 +1（假的）', '金幣翻面了，論文還是要自己寫。', '再點也不會變成國科會計畫喔。'], cat: ['喵！我是 K 喵。', '按左上角的播放鍵，看 K 棒一年一年長高。', '滑過 K 棒，我就跑過去看。'] }
            : { play: 'Play the lab’s growth', pause: 'Pause', year: 'Year', total: 'works so far', replay: '▶ replays from {y}', more: 'others +', coin: ['Ding! Funding +1 (not really).', 'The coin flipped. The paper still needs writing.', 'Clicking will not turn it into a grant.'], cat: ['Meow! I am K-meow.', 'Press play, top left, to watch the candles grow year by year.', 'Hover a candle and I will go look.'] }}
        />
      </div>
      <ul class="legend" aria-label={zh ? '六個研究領域' : 'Six research areas'}>
        {areas.map((a) => <li style={`--c: var(--clay-${a.clay})`}><i aria-hidden="true"></i>{zh ? a.name.zh : boardEn[a.key]}</li>)}
      </ul>
    </div>
    <div class="wrap">
      <dl class="ticker clay" aria-label={zh ? '研究成果數量' : 'Output at a glance'}>
        {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.n}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="wrap section mission" aria-labelledby="mission-h">
    <div>
      <p class="eyebrow">{zh ? '使命' : 'Mission'} · {t(lab.tagline, lang)}</p>
      <h2 id="mission-h" class="quote">{zh ? '用台灣市場的資料檢驗財務理論，再把它做成用得上的模型。' : 'We test finance theory on Taiwan market data, then turn it into models people can use.'}</h2>
      <p class="lede">{t(lab.mission[0], lang)}</p>
    </div>
    <a class="advisor clay" href={href(lang, 'advisor')}>
      <Image class="advisor-photo" src={advisorPhoto} alt="" width={128} height={128} densities={[1, 2]} format="webp" />
      <span>
        <span class="eyebrow">{t(ui.nav.advisor, lang)}</span>
        <strong>{t(advisor.name, lang)}</strong>
        <span class="muted">{t(advisor.title, lang)}</span>
        <span class="go">{zh ? '認識老師 →' : 'Meet the advisor →'}</span>
      </span>
    </a>
  </section>

  <section class="wrap section" aria-labelledby="areas-h">
    <div class="section-head">
      <p class="eyebrow">{zh ? '研究領域' : 'Research areas'}</p>
      <h2 id="areas-h">{zh ? 'IFA Lab 在研究什麼？' : 'What does IFA Lab research?'}</h2>
      <p class="muted">{zh
        ? '六個領域，每一塊積木都是一篇論文或碩士論文。'
        : 'Six areas. Every block is a paper or a master’s thesis.'}</p>
    </div>
    <ul class="areas">
      {areas.map((a) => (
        <li>
          <a class="area clay" href={href(lang, `research#${a.key}`)} style={`--c: var(--clay-${a.clay})`}>
            <span class="txt">
              <h3>{t(a.name, lang)}</h3>
              <p class="muted">{t(a.blurb, lang)}</p>
            </span>
            <span class="tower" aria-hidden="true">{Array.from({ length: perArea(a.key) }, () => <i></i>)}</span>
            <span class="count"><b>{perArea(a.key)}</b> {zh ? '篇' : perArea(a.key) === 1 ? 'work' : 'works'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section latest" aria-labelledby="news-h">
    <div class="section-head row-head">
      <div>
        <p class="eyebrow">{zh ? '最新動態' : 'Latest'}</p>
        <h2 id="news-h">{zh ? '最近疊上去的幾塊' : 'The newest blocks on the pile'}</h2>
      </div>
      <a class="more" href={href(lang, 'history')}>{zh ? '看完整沿革 →' : 'Full history →'}</a>
    </div>
    <ul class="news">
      {latest.map((e) => (
        <li class="clay">
          <p class="tag"><i data-k={e.kind} style={e.clay && `--c: var(--clay-${e.clay})`} aria-hidden="true"></i>{t(kindLook[e.kind].name, lang)} · <time datetime={e.date}>{fmtDate(e.date)}</time></p>
          <p class="say">{e.link ? <a href={e.link}>{t(e.text, lang)}</a> : t(e.text, lang)}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="shelf-h">
    <div class="section-head">
      <p class="eyebrow">{t(ui.nav.members, lang)}</p>
      <h2 id="shelf-h">{zh ? '一屆一層的成員書架' : 'One shelf per cohort'}</h2>
      <p class="muted">{zh ? '點一個公仔，看他們在做什麼。' : 'Pick a figure to see what they work on.'}</p>
    </div>
    <div class="shelf">
      {cohorts.map(([c, ms]) => (
        <div class="row">
          <p class="eyebrow">{t(ui.cohort(c), lang)}</p>
          <ul>
            {ms.filter((m) => !m.data.placeholder).map((m) => (
              <li>
                <Mate member={m} lang={lang} size={92} caption />
              </li>
            ))}
          </ul>
          {(() => { const rest = ms.filter((m) => m.data.placeholder); return rest.length > 0 && (
            <p class="also muted">{zh ? '同屆還有 ' : 'Also: '}{rest.map((m) => t(m.data.name, lang)).join(zh ? '、' : ', ')}</p>
          ); })()}
        </div>
      ))}
    </div>
  </section>
  <section class="wrap section">
    <div class="join clay has-cat">
      <span class="cat-perch" style="right: 56px; top: -64px;"><LabCat lang={lang} bubble="left" lines={[{ zh: '我是 K 喵，IFA Lab 的吉祥物。', en: 'I am K-meow, the IFA Lab mascot.' }, { zh: '上面那隻 3D 的也是我，滑過 K 棒我會跑過去看。', en: 'The 3D cat up top is me too. Hover a candle and I go look.' }, { zh: '想加入？先寄一封信給老師，我幫你顧信箱。', en: 'Want to join? Email the professor first. I will watch the inbox.' }]} /></span>
      <div>
        <h2>{zh ? '想一起把題目疊起來？' : 'Want to stack a question with us?'}</h2>
        <p class="muted">{zh ? '修過財務或程式都可以，先寄一封信聊聊你好奇的事。' : 'Finance or programming background both work. Start with an email about what you are curious about.'}</p>
        <a class="btn" href={href(lang, 'join')}>{t(ui.nav.join, lang)}</a>
      </div>
      <div class="crowd" aria-label={zh ? '現在的成員' : 'Current members'}>
        {crew.map((m) => <Mate member={m} lang={lang} size={64} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); overflow-x: clip; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-5); align-items: center; }
  .copy { display: grid; gap: var(--space-5); position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(44px, 6.6vw, 96px); line-height: 1.08; }
  .hero h1 span { display: block; white-space: nowrap; }
  :global(html:lang(en)) .hero h1 { font-size: clamp(40px, 5vw, 68px); letter-spacing: -0.02em; }
  :global(html:lang(en)) .lede { max-width: 26em; }
  .lede { font-size: 19px; color: var(--ink-2); max-width: 30em; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cta .btn { min-height: 52px; padding: 14px 26px; font-size: 17px; }

  /* the scene bleeds to the right edge of the viewport on wide screens */
  .visual { position: relative; margin-right: min(0px, calc((var(--page) - 100vw) / 2)); margin-bottom: var(--space-5); aspect-ratio: 7 / 5.4; }
  .visual :global(.kline-canvas) { position: absolute; inset: 0; }
  .visual :global(.kline-canvas canvas) { touch-action: pan-y; }
  .visual[data-live] :global(.stage > *) { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .visual :global(.kline-hint) {
    position: absolute; left: 50%; bottom: -28px; transform: translateX(-50%); white-space: nowrap;
    font: 500 14px/1.4 var(--f-body); color: var(--ink-2);
    background: var(--surface); padding: 8px 16px; border-radius: var(--r-full); box-shadow: 4px 6px 14px var(--lo);
  }
  .visual :global(.kline-hint b) { color: var(--ink); }
  /* timeline: a clay ticker in the empty top-left of the scene */
  .visual :global(.kline-time) {
    position: absolute; left: 2%; top: 4%; z-index: 2; display: grid; grid-template-columns: auto auto; grid-template-areas: 'play year' 'range range';
    align-items: center; gap: var(--space-2) var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--r-lg);
    background: var(--surface); box-shadow: 6px 8px 18px var(--lo), inset 0 2px 0 var(--hi), inset 0 -4px 0 rgb(0 0 0 / 0.05);
  }
  .visual :global(.kline-play) {
    grid-area: play; width: 44px; height: 44px; border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-ink); box-shadow: 3px 4px 10px var(--lo), inset 0 -3px 0 rgb(0 0 0 / 0.15), inset 0 2px 0 rgb(255 255 255 / 0.25);
    transition: transform var(--dur-press) var(--ease-out);
  }
  .visual :global(.kline-play:active) { transform: scale(0.94); }
  .visual :global(.kline-play svg) { width: 16px; height: 16px; fill: currentColor; }
  .visual :global(.kline-year) { grid-area: year; display: grid; line-height: 1.1; }
  .visual :global(.kline-year b) { font: 600 30px/1 var(--f-display); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; min-width: 3.2ch; }
  .visual :global(.kline-year small) { font: 500 13px/1.4 var(--f-body); color: var(--ink-2); }
  .visual :global(.kline-time input) { grid-area: range; width: 100%; min-width: 150px; accent-color: var(--accent); height: 24px; cursor: pointer; }
  @media (max-width: 559px) {
    .visual :global(.kline-time) { top: 0; left: 16px; right: 16px; padding: var(--space-2) var(--space-3); grid-template-columns: auto auto 1fr; grid-template-areas: 'play year range'; }
    .visual :global(.kline-year b) { font-size: 22px; }
    .visual :global(.kline-time input) { min-width: 90px; }
  }

  /* phones: the board has no nameplates, so a quiet colour key sits under it (the research-areas section below has the links) */
  .legend { display: none; list-style: none; margin: 0; padding: 0 var(--space-4); flex-wrap: wrap; justify-content: center; gap: var(--space-1) var(--space-4); font-size: 14px; color: var(--ink-2); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; background: var(--c); box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.16); }
  @media (max-width: 559px) { .legend { display: flex; } }
  .ticker { margin: var(--space-6) 0 0; padding: var(--space-5) var(--space-6); display: grid; grid-template-columns: repeat(5, 1fr); }
  .ticker > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-1); padding-inline: var(--space-5); }
  @media (min-width: 768px) { .ticker > div + div { box-shadow: inset 1px 0 0 var(--line); } }
  .ticker > div:first-child { padding-left: 0; }
  .ticker dd { margin: 0; font: 600 clamp(40px, 4.4vw, 60px)/1 var(--f-display); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .ticker dt { font-size: 15px; color: var(--ink-2); }

  .areas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .area {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 1fr auto; gap: var(--space-4) var(--space-5);
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-6); text-decoration: none; color: var(--ink); height: 100%;
    background: color-mix(in oklab, var(--c) 9%, var(--surface));
  }
  /* text takes the full card width; the tower and count share the bottom row */
  .txt { grid-column: 1 / -1; display: grid; align-content: start; gap: var(--space-2); }
  .area h3 { font-size: 24px; }
  /* one clay brick per work, two to a course like a wall, growing upward */
  .tower { grid-row: 2; grid-column: 2; align-self: end; width: 82px; display: flex; flex-wrap: wrap-reverse; gap: 4px; align-content: flex-start; }
  .tower i {
    width: 36px; height: 18px; border-radius: 6px; background: var(--c);
    box-shadow: inset 0 -4px 0 rgb(0 0 0 / 0.16), inset 2px 3px 3px rgb(255 255 255 / 0.4), 0 3px 5px var(--lo);
    transition: transform var(--dur-base) var(--ease-out);
  }
  /* every other course shifts half a brick, like real bonding */
  .tower i:nth-child(4n+3), .tower i:nth-child(4n+4) { translate: 6px 0; }
  @media (hover: hover) and (pointer: fine) {
    .area:hover .tower i { transform: translateY(-3px); }
    .area:hover .tower i:nth-child(n+3) { transition-delay: 40ms; }
    .area:hover .tower i:nth-child(n+5) { transition-delay: 80ms; }
    .area:hover .tower i:nth-child(n+7) { transition-delay: 120ms; }
  }
  .count { grid-row: 2; grid-column: 1; font: 500 14px/1 var(--f-mono); color: var(--ink-2); align-self: end; }
  .count b { font: 600 32px/1 var(--f-display); color: var(--ink); margin-right: 4px; letter-spacing: -0.02em; }

  /* 2×2 bookcase: each cohort is one shelf with a plank */
  .shelf { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7) var(--space-6); }
  .row { position: relative; display: grid; gap: var(--space-3); padding-bottom: var(--space-4); }
  /* a clay plank: lit top edge, darker front, soft cast shadow */
  .row::after { content: ''; position: absolute; inset: auto -8px 0; height: 18px; border-radius: 9px; background: var(--surface); box-shadow: 0 10px 18px var(--lo), inset 0 3px 0 var(--hi), inset 0 -7px 0 var(--surface-2); }
  /* under the plank, out of flow: every plank stays level with its neighbour */
  .row .also { position: absolute; top: calc(100% + var(--space-3)); left: 0; margin: 0; font-size: 14px; }
  .row ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); align-items: end; }

  .row-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-5); max-width: none; }
  .more { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .more:hover { text-decoration: underline; }
  .news { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .news li { padding: var(--space-5); display: grid; gap: var(--space-3); align-content: start; }
  .tag { display: flex; align-items: center; gap: var(--space-2); font: 500 14px/1.4 var(--f-mono); color: var(--ink-2); }
  .tag i { width: 26px; height: 15px; border-radius: 5px; background: var(--c, color-mix(in oklab, var(--ink) 58%, var(--surface))); box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.16), inset 1px 2px 3px rgb(255 255 255 / 0.4); }
  .tag i[data-k='thesis'] { scale: 0.75 1.3; }
  .tag i[data-k='grant'] { scale: 1.2 0.6; }
  .tag i[data-k='award'] { width: 18px; height: 18px; border-radius: 50%; --c: var(--clay-sun); }
  .tag i[data-k='milestone'] { width: 15px; rotate: 45deg; }
  .say { font-size: 17px; line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
