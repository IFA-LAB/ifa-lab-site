---
import Base from '@/layouts/Base.astro';
import ClayFigure from '@/components/ClayFigure.astro';
import ClayBuddy from '@/components/three/ClayBuddy';
import { Picture, getImage } from 'astro:assets';
import CustomFrame from '@/components/CustomFrame.astro';

/** Member-built sections: src/custom/<member-id>/Section.astro (rules: CONTRIBUTING.md). */
const customs = import.meta.glob<{ default: any }>('/src/custom/*/Section.astro', { eager: true });
import Bi from '@/components/Bi.astro';
import { getCollection, getEntry } from 'astro:content';
import { ui, t, pick, href, locales, type Locale } from '@/i18n/ui';
import { publications } from '@/lib/content';

export async function getStaticPaths() {
  const members = await getCollection('members');
  return locales.flatMap((lang) => members.map((m) => ({ params: { lang, slug: m.id }, props: { m } })));
}
const { m } = Astro.props;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';
const d = m.data;
const site = Astro.site!;
const thesis = d.thesis ? await getEntry('theses', d.thesis) : undefined;
const enName = d.name.en;
const myPubs = enName ? (await publications()).filter((p) => p.data.authors.includes(enName)) : [];
const name = t(d.name, lang);

const description = d.placeholder
  ? `${name}，IFA Lab ${t(ui.cohort(d.cohort), lang)}。`
  : (pick(d.bio, lang).text || t(d.headline, lang)).slice(0, 150);

if (d.photo && (d.photo.width < 400 || Math.abs(d.photo.width / d.photo.height - 1) > 0.05)) {
  throw new Error(`members/${m.id}: photo must be square (1:1) and at least 400px wide, got ${d.photo.width}x${d.photo.height}`);
}
const Custom = customs[`/src/custom/${m.id}/Section.astro`]?.default;
const share = d.photo ? await getImage({ src: d.photo, width: 640, format: 'jpg' }) : undefined;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: enName ?? d.name.zh,
  alternateName: d.name.zh,
  url: new URL(href(lang, `members/${m.id}`), site).href,
  affiliation: { '@id': new URL('/#org', site).href },
  ...(d.research.length ? { knowsAbout: d.research } : {}),
  ...(d.links.schoolEmail ? { email: d.links.schoolEmail } : {}),
  ...(share ? { image: new URL(share.src, site).href } : {}),
  sameAs: [d.links.github, d.links.linkedin, d.links.website].filter(Boolean),
};
const links = [
  d.links.website && { label: 'Website', url: d.links.website },
  d.links.github && { label: 'GitHub', url: d.links.github },
  d.links.linkedin && { label: 'LinkedIn', url: d.links.linkedin },
].filter(Boolean) as { label: string; url: string }[];
---
<Base lang={lang} title={name} description={description} jsonld={[person]} ogType="profile" image={share?.src}>
  <article class="wrap section">
    <p class="crumbs"><a href={href(lang, 'members')}>{t(ui.nav.members, lang)}</a> / {t(ui.cohort(d.cohort), lang)}</p>

    <header class="head">
      <div class="portrait" data-face={d.photo ? 'photo' : 'buddy'}>
      {d.photo && (
        <Picture class="photo" src={d.photo} alt={zh ? `${name}的照片` : `Photo of ${name}`} widths={[240, 480]} sizes="240px" formats={['avif', 'webp']} loading="eager" />
      )}
      <div class="buddy" data-buddy>
        <div class="stage"><ClayFigure clay={d.figure.clay} accessory={d.figure.accessory} placeholder={d.placeholder} size={160} /></div>
        <ClayBuddy
          client:visible
          clay={d.figure.clay}
          accessory={d.figure.accessory}
          placeholder={d.placeholder}
          hint={zh ? '拖曳轉圈，點一下會跳' : 'Drag to spin, click to hop'}
          hintTouch={zh ? '左右滑轉圈，點一下會跳' : 'Swipe to spin, tap to hop'}
        />
      </div>
      {d.photo && (
        <button type="button" class="flip chip" aria-pressed="false" data-on={zh ? '換回照片' : 'Show photo'} data-off={zh ? '換成黏土公仔' : 'Show clay figure'}>{zh ? '換成黏土公仔' : 'Show clay figure'}</button>
      )}
      </div>
      <div class="who">
        <p class="eyebrow">{t(ui.cohort(d.cohort), lang)}{d.founder ? ` · ${t(ui.founder, lang)}` : ''}</p>
        <h1>{name}</h1>
        {zh && enName && <p class="en" lang="en">{enName}</p>}
        {d.headline && !d.placeholder && <p class="muted">{t(d.headline, lang)}</p>}
        {(links.length > 0 || d.links.schoolEmail) && (
          <ul class="links">
            {links.map((l) => <li><a class="chip" href={l.url} rel="me noopener" target="_blank">{l.label}</a></li>)}
            {d.links.schoolEmail && <li><a class="chip" href={`mailto:${d.links.schoolEmail}`}>{d.links.schoolEmail}</a></li>}
          </ul>
        )}
      </div>
    </header>

    {Custom && !d.placeholder && (
      <CustomFrame lang={lang} name={name} id={m.id}><Custom lang={lang} /></CustomFrame>
    )}

    {d.placeholder ? (
      <p class="empty clay">{zh
        ? '個人資料還在準備中。公仔目前是灰色的，資料補上後就會上色。'
        : 'This profile is still being prepared. The figure stays grey until it is filled in.'}</p>
    ) : (
      <div class="blocks">
        {d.bio && (
          <section class="block wide">
            <h2>{t(ui.sections.bio, lang)}</h2>
            <Bi text={d.bio} lang={lang} />
          </section>
        )}
        {thesis && (
          <section class="block wide">
            <h2>{t(ui.sections.thesis, lang)}</h2>
            <p class="thesis">{t(thesis.data.title, lang)}</p>
            <p class="muted small">{zh ? `國立中央大學資訊管理學系，${thesis.data.academicYear} 學年度` : `National Central University, academic year ${thesis.data.academicYear + 1911}–${thesis.data.academicYear + 1912}`}{thesis.data.fullTextFrom && ` · ${t(ui.pubs.fullTextFrom, lang)} ${thesis.data.fullTextFrom}`}</p>
          </section>
        )}
        {myPubs.length > 0 && (
          <section class="block wide">
            <h2>{zh ? '論文' : 'Papers'}</h2>
            <ul class="plain">
              {myPubs.map((p) => <li><a href={href(lang, `papers/${p.id}`)} lang="en">{p.data.title}</a> <span class="muted small">({p.data.year}{p.data.kind === 'working' ? `, ${t(ui.pubs.working, lang)}` : ''})</span></li>)}
            </ul>
          </section>
        )}
        {d.research.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.research, lang)}</h2>
            <ul class="tags">{d.research.map((r) => <li lang="en">{r}</li>)}</ul>
          </section>
        )}
        {d.education.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.education, lang)}</h2>
            <ul class="timeline">{d.education.map((e) => <li><span class="mono">{e.period}</span><span>{t(e.school, lang)}・{t(e.degree, lang)}</span></li>)}</ul>
          </section>
        )}
        {d.experience.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.experience, lang)}</h2>
            <ul class="timeline">{d.experience.map((e) => <li><span class="mono">{e.period}</span><span>{t(e.title, lang)}・{t(e.org, lang)}</span></li>)}</ul>
          </section>
        )}
        {d.projects.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.projects, lang)}</h2>
            <ul class="plain">{d.projects.map((p) => (
              <li>
                {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : <strong>{p.name}</strong>}
                <span class="muted small"> {p.year}</span>
                <br /><span>{t(p.desc, lang)}</span>
              </li>
            ))}</ul>
          </section>
        )}
        {d.awards.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.awards, lang)}</h2>
            <ul class="plain">{d.awards.map((a) => <li>{t(a, lang)}</li>)}</ul>
          </section>
        )}
        {d.interests.length > 0 && (
          <section class="block">
            <h2>{t(ui.sections.interests, lang)}</h2>
            <ul class="tags">{d.interests.map((i) => <li>{t(i, lang)}</li>)}</ul>
          </section>
        )}
      </div>
    )}
  </article>
</Base>

<script>
  // Photo ⇄ clay figure. The 3D island only loads once the figure is first shown (client:visible on a hidden box).
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.portrait .flip')) {
    btn.addEventListener('click', () => {
      const box = btn.closest<HTMLElement>('.portrait')!;
      const toBuddy = box.dataset.face === 'photo';
      box.dataset.face = toBuddy ? 'buddy' : 'photo';
      btn.setAttribute('aria-pressed', String(toBuddy));
      btn.textContent = (toBuddy ? btn.dataset.on : btn.dataset.off) ?? '';
    });
  }
</script>

<style>
  .crumbs { font-size: 15px; color: var(--ink-2); margin-bottom: var(--space-5); }
  .head { display: flex; gap: var(--space-6); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-7); }
  .portrait { position: relative; width: 240px; display: grid; justify-items: center; gap: var(--space-3); flex: none; }
  .portrait > :global(picture), .buddy { grid-area: 1 / 1; }
  .portrait :global(.photo) {
    display: block; width: 240px; height: 240px; object-fit: cover; border-radius: var(--r-lg);
    box-shadow: 8px 10px 22px var(--lo), inset 0 0 0 1px rgb(0 0 0 / 0.06);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }
  .portrait > :global(picture) { grid-row: 1; grid-column: 1; }
  .buddy { position: relative; width: 240px; height: 260px; grid-row: 1; grid-column: 1; }
  [data-face='photo'] .buddy { display: none; }
  [data-face='buddy'] :global(picture) { display: none; }
  [data-face='buddy'] .buddy { animation: pop var(--dur-slow) var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: scale(0.96); } }
  .flip { min-height: 44px; cursor: pointer; font: inherit; font-size: 15px; border: 0; }
  .stage { position: absolute; inset: 0; display: grid; place-items: center; }
  .buddy[data-live] .stage { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .buddy :global(.buddy-canvas) { position: absolute; inset: 0; cursor: grab; touch-action: pan-y; }
  .buddy :global(.buddy-canvas:active) { cursor: grabbing; }
  .buddy :global(.buddy-hint) {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); white-space: nowrap;
    font: 500 13px/1.4 var(--f-body); color: var(--ink-2); pointer-events: none;
  }
  .who { display: grid; gap: var(--space-1); min-width: 0; }
  .en { font: 500 20px/1.3 var(--f-display); color: var(--ink-2); }
  .links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .links a { text-decoration: none; min-height: 40px; overflow-wrap: anywhere; }
  .empty { padding: var(--space-6); color: var(--ink-2); max-width: 40em; }
  .blocks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); align-items: start; }
  .block { padding: var(--space-5) var(--space-6); border-radius: var(--r-lg); background: var(--surface); box-shadow: 8px 10px 22px var(--lo), inset -4px -6px 12px rgb(0 0 0 / 0.04), inset 4px 6px 12px var(--hi); display: grid; gap: var(--space-3); align-content: start; min-width: 0; }
  .block.wide { grid-column: 1 / -1; }
  .block h2 { font-size: 18px; display: flex; align-items: center; gap: var(--space-2); }
  .block h2::before { content: ''; width: 12px; height: 12px; border-radius: 4px; background: var(--accent); }
  .thesis { font: 600 19px/1.6 var(--f-body); }
  .small { font-size: 14px; }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .timeline li { display: grid; grid-template-columns: 9.5em 1fr; gap: var(--space-3); }
  .timeline .mono { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) {
    .blocks { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 0; }
  }
</style>
