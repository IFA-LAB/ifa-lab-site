---
import LabCat from '@/components/LabCat.astro';
import Base from '@/layouts/Base.astro';
import ClayFigure from '@/components/ClayFigure.astro';
import ClayShelf from '@/components/three/ClayShelf';
import { Image } from 'astro:assets';
import { ui, t, href, type Locale } from '@/i18n/ui';
import { langPaths, membersByCohort } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';
const cohorts = await membersByCohort();
const site = Astro.site!;

// the cabinet: one plank per cohort, members who have a profile stand on it
const rows = cohorts.map(([c, ms]) => ({
  label: t(ui.cohort(c), lang),
  members: ms.filter((m) => !m.data.placeholder).map((m) => ({
    id: m.id, name: t(m.data.name, lang), sub: t(m.data.headline, lang) ?? '',
    clay: m.data.figure.clay, accessory: m.data.figure.accessory, model: m.data.figure.model, href: href(lang, `members/${m.id}`),
  })),
}));
const people = cohorts.flatMap(([, ms]) => ms).filter((m) => !m.data.placeholder);
const jsonld = people.map((m) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: m.data.name.en ?? m.data.name.zh,
  alternateName: m.data.name.zh,
  url: new URL(href(lang, `members/${m.id}`), site).href,
  affiliation: { '@id': new URL('/#org', site).href },
}));
---
<Base lang={lang} title={t(ui.nav.members, lang)} description={zh ? 'IFA Lab 各屆成員：碩士論文、研究方向與專案。' : 'IFA Lab members by cohort: theses, research interests and projects.'} jsonld={jsonld}>
  <div class="wrap section">
    <div class="intro">
      <div class="section-head">
        <p class="eyebrow">{t(ui.nav.members, lang)}</p>
        <h1>{zh ? '各屆成員' : 'Members by cohort'}</h1>
        <p class="muted">{zh ? '2023 年 8 月成立至今，一屆一層，第一屆在最下面。指一下櫃子裡的公仔看是誰，再點一下進個人頁；下面是每個人的卡片。' : 'Since August 2023, one shelf per cohort, the first at the bottom. Point at or tap a figure in the cabinet to see who it is, then click to open their page; cards for everyone follow below.'}</p>
      </div>
      <div class="cabinet has-cat" data-shelf>
        <span class="cat-perch" style="right: 28px; top: -52px;"><LabCat lang={lang} bubble="left" lines={[{ zh: '每個公仔都是成員自己挑顏色和配件的。', en: 'Each member picks their own figure color and prop.' }, { zh: '耳機、吉他、眼鏡……配件會透露他們的興趣。', en: 'Headphones, a guitar, glasses: the props give away their hobbies.' }, { zh: '我住在櫃子頂上，最高的那一層歸我。', en: 'I live on top of the cabinet. The top shelf is mine.' }]} /></span>
        {/* CSS cabinet: what shows before the 3D one draws, and on devices without WebGL */}
        <div class="stage" aria-hidden="true">
          {rows.map((r) => (
            <div class="plank-row">
              <div class="figs">{r.members.map((m) => <ClayFigure clay={m.clay} accessory={m.accessory} model={m.model} size={58} />)}</div>
              <span class="plank">{r.label}</span>
            </div>
          ))}
        </div>
        <ClayShelf client:visible rows={rows}
          hint={zh ? '滑過公仔看是誰，點一下進個人頁' : 'Hover a figure to see who it is, click to open'}
          hintTouch={zh ? '點公仔看是誰，再點一次進個人頁' : 'Tap a figure to see who it is, tap again to open'}
          open={zh ? '點一下進個人頁' : 'click to open'}
          openTouch={zh ? '再點一次進個人頁' : 'tap again to open'} />
      </div>
    </div>

    {cohorts.map(([c, ms]) => (
      <section class="cohort" aria-labelledby={`c${c}`}>
        <h2 id={`c${c}`}>{t(ui.cohort(c), lang)}</h2>
        <ul class="cards">
          {ms.filter((m) => !m.data.placeholder).map((m) => (
            <li>
              <a class="card clay" href={href(lang, `members/${m.id}`)} data-member={m.id}>
                {m.data.photo
                  ? <span class="face"><Image class="avatar" src={m.data.photo} alt="" width={88} height={88} densities={[1, 2]} format="webp" /><span class="twin"><ClayFigure clay={m.data.figure.clay} accessory={m.data.figure.accessory} model={m.data.figure.model} size={40} /></span></span>
                  : <ClayFigure clay={m.data.figure.clay} accessory={m.data.figure.accessory} model={m.data.figure.model} placeholder={m.data.placeholder} size={88} />}
                <span class="txt">
                  <strong>{t(m.data.name, lang)}</strong>
                  {m.data.name.en && zh && <span class="en">{m.data.name.en}</span>}
                  <span class="muted">{m.data.placeholder ? t(ui.placeholderNote, lang) : (t(m.data.headline, lang) ?? '').split('・').map((part, i, all) => <><span class:list={[{ nw: all.length > 1 }]}>{part}{i < all.length - 1 && '・'}</span><wbr /></>)}</span>
                  <span class="badges">
                    {m.data.founder && <span class="chip">{t(ui.founder, lang)}</span>}
                    {m.data.status === 'graduated' && <span class="chip">{t(ui.graduated, lang)}</span>}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {/* members without a profile yet: named, so every page lists the same people, but no empty card */}
        {(() => { const rest = ms.filter((m) => m.data.placeholder); return rest.length > 0 && (
          <p class="also muted">{zh ? '同屆還有 ' : 'Also in this cohort: '}{rest.map((m, i) => <>{i > 0 && (zh ? '、' : ', ')}<a href={href(lang, `members/${m.id}`)}>{t(m.data.name, lang)}</a></>)}{zh ? '（個人頁整理中）' : ' (profile coming)'}</p>
        ); })()}
      </section>
    ))}
  </div>
</Base>

<style>
  /* heading on the left, the cabinet on the right; stacked on phones */
  /* heading sits at the same height as on every other page; the cabinet extends below it */
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); gap: var(--space-7); align-items: center; } /* the heading sits level with the middle of the cabinet, not stranded above empty space */
  @media (max-width: 899px) { .intro { grid-template-columns: 1fr; gap: var(--space-6); } .cabinet { justify-self: center; width: min(100%, 460px); aspect-ratio: 1 / 1.12; } }
  .cabinet { position: relative; aspect-ratio: 1 / 1.02; margin-block: var(--space-7) calc(var(--space-6) + 24px); }
  .stage { position: absolute; inset: 4% 8% 8%; display: flex; flex-direction: column-reverse; padding: var(--space-3); border-radius: var(--r-lg); background: var(--surface-2); box-shadow: inset 0 0 0 12px var(--surface), 8px 12px 24px var(--lo); }
  .cabinet[data-live] .stage { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .plank-row { flex: 1; display: grid; grid-template-rows: 1fr auto; padding-inline: var(--space-3); }
  .figs { display: flex; justify-content: center; align-items: end; gap: var(--space-5); }
  .plank { display: block; padding: 4px var(--space-3); border-radius: 8px; background: var(--surface); box-shadow: 0 6px 10px var(--lo), inset 0 2px 0 var(--hi); font: 600 13px/1.4 var(--f-body); color: var(--ink-2); }
  .cabinet :global(.shelf-canvas) { position: absolute; inset: 0; }
  .cabinet :global(.shelf-canvas canvas) { touch-action: pan-y; }
  .cabinet :global(.shelf-hint) {
    position: absolute; left: 50%; top: calc(100% + var(--space-2)); transform: translateX(-50%); white-space: nowrap; max-width: calc(100vw - 32px); overflow: hidden; text-overflow: ellipsis;
    font: 500 14px/1.4 var(--f-body); color: var(--ink-2);
    background: var(--surface); padding: 8px 16px; border-radius: var(--r-full); box-shadow: 4px 6px 14px var(--lo);
  }
  .cabinet :global(.shelf-hint b) { color: var(--ink); }
  .also { margin-top: var(--space-4); font-size: 15px; }
  .avatar { width: 88px; height: 88px; border-radius: 24px; object-fit: cover; flex: none; box-shadow: 4px 6px 14px var(--lo); }
  .face { position: relative; flex: none; }
  .twin { position: absolute; right: -14px; bottom: -12px; transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .card:hover .twin { transform: translateY(-6px) rotate(-6deg); } }
  .cohort { margin-top: var(--space-7); }
  .cohort h2 { margin-bottom: var(--space-4); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  /* the photo's small clay twin (and its guitar) sticks out of the corner: one wider gap for every card keeps text columns aligned */
  .card { display: flex; gap: var(--space-5); align-items: flex-start; padding: var(--space-5); color: var(--ink); text-decoration: none; height: 100%; transition: transform var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .card:hover { transform: translateY(-3px); } }
  /* lit from the cabinet above */
  .card.lit { transform: translateY(-3px); box-shadow: 0 0 0 3px var(--accent), 8px 12px 24px var(--lo); }

  .txt { display: grid; gap: 2px; min-width: 0; }
  .txt strong { font: 600 22px/1.3 var(--f-display); }
  .en { font-size: 14px; color: var(--ink-2); }
  .txt .muted { font-size: 15px; line-height: 1.5; text-wrap: pretty; word-break: keep-all; overflow-wrap: anywhere; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .badges .chip { font-size: 13px; padding: 5px 10px; }
  @media (max-width: 1023px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 639px) { .cards { grid-template-columns: 1fr; } }
</style>
