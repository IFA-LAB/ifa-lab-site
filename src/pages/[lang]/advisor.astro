---
import LabCat from '@/components/LabCat.astro';
import Base from '@/layouts/Base.astro';
import ClayFigure from '@/components/ClayFigure.astro';
import CareerSteps from '@/components/CareerSteps.astro';
import ClayBuddy from '@/components/three/ClayBuddy';
import ClayKnead from '@/components/ClayKnead.astro';
import { Picture, getImage } from 'astro:assets';
import photo from '@/assets/advisor.jpg';
import { advisor, lab } from '@/data/lab';
import { ui, t, href, type Locale } from '@/i18n/ui';
import { langPaths } from '@/lib/content';
import { getCollection } from 'astro:content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const zh = lang === 'zh-tw';
const site = Astro.site!;
const allJournal = (await getCollection('publications')).filter((p) => p.data.kind === 'journal').sort((a, b) => b.data.year - a.data.year);
const recent = allJournal.slice(0, 5);
const journals = allJournal.length;
const share = await getImage({ src: photo, width: 336, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#advisor', site).href,
  name: advisor.name.en,
  alternateName: advisor.name.zh,
  jobTitle: [advisor.title.en, advisor.office.en],
  image: new URL(share.src, site).href,
  email: lab.contact.email,
  url: new URL(href(lang, 'advisor'), site).href,
  worksFor: { '@id': new URL('/#org', site).href },
  knowsAbout: advisor.research,
  sameAs: [advisor.facultyUrl, advisor.scholarUrl, advisor.researchGateUrl],
  award: advisor.awards.map((a) => a.zh),
  alumniOf: advisor.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school.en })),
};
// the description ends on what he researches (the bio's last sentence), not on the bio cut at 100 characters mid-word
const focus = t(advisor.bio, lang).split(/(?<=[。.])\s*/).filter(Boolean).at(-1) ?? '';
---
<Base lang={lang} title={zh ? `${advisor.name.zh}老師（中央資管副教授）` : `Prof. ${advisor.name.en}`} description={(zh ? `中央資管${advisor.name.zh}老師：國立中央大學資訊管理學系${advisor.title.zh}，IFA Lab 主持人。` : `Prof. ${advisor.name.en} leads IFA Lab, NCU. `) + focus} jsonld={[person]} ogType="profile" image={share.src}>
  <article class="wrap section">
    <header class="head">
      <div class="portrait" data-face="photo">
        <Picture class="photo" src={photo} alt={zh ? '邱信瑜老師的照片' : 'Photo of Hsin-Yu Chiu'} widths={[240, 336]} sizes="240px" formats={['avif', 'webp']} loading="eager" />
        <div class="buddy" data-buddy>
          <div class="stage"><ClayFigure clay="sun" accessory="guitar" size={160} model="prof" /></div>
          <ClayBuddy client:visible clay="sun" accessory="guitar" model="prof" hint="" hintTouch="" />
          <ClayKnead lang={lang} clay="sun" />
        </div>
        <button type="button" class="flip chip" aria-pressed="false" data-on={zh ? '換回照片' : 'Show photo'} data-off={zh ? '換成黏土公仔' : 'Show clay figure'}>{zh ? '換成黏土公仔' : 'Show clay figure'}</button>
      </div>
      <div class="who">
        <p class="eyebrow">{t(ui.nav.advisor, lang)}</p>
        <h1>{t(advisor.name, lang)}</h1>
        {zh && <p class="en" lang="en">{advisor.name.en}</p>}
        <p class="muted role">{t(advisor.title, lang)} · {t(lab.dept, lang)}</p>
        <p class="muted role"><a href={advisor.officeUrl} target="_blank" rel="noopener">{t(advisor.office, lang)}</a></p>
        <ul class="links">
          <li><a class="chip" href={`mailto:${lab.contact.email}`}>{lab.contact.email}</a></li>
          <li><a class="chip" href={advisor.facultyUrl} target="_blank" rel="noopener">{zh ? '資管系師資頁' : 'NCU IM faculty page'}</a></li>
          <li><a class="chip" href={advisor.scholarUrl} target="_blank" rel="noopener">Google Scholar</a></li>
          <li><a class="chip" href={advisor.researchGateUrl} target="_blank" rel="noopener">ResearchGate</a></li>
        </ul>
      </div>
    </header>
    <section class="lead" aria-label={t(ui.sections.bio, lang)}>
      <p class="bio">{t(advisor.bio, lang)}</p>
      <dl class="facts">
        <div><dt>{zh ? '在大學任教' : 'Teaching since'}</dt><dd class="nw"><b>2017</b>{zh ? ' 年起' : ''}</dd></div>
        <div><dt>{zh ? '期刊論文' : 'Journal papers'}</dt><dd class="nw"><b>{journals}</b>{zh ? ' 篇' : ''}</dd></div>
      </dl>
    </section>
    <section class="sec">
      <h2 id="career-h">{zh ? '經歷' : 'Career'}</h2>
      <CareerSteps lang={lang} />
    </section>
    <div class="two">
      <section class="sec"><h2>{zh ? '近期期刊論文' : 'Recent journal papers'}</h2>
        <ol class="recent">{recent.map((p) => <li><a href={href(lang, `papers/${p.id}`)} lang="en">{p.data.title}</a> <span class="mono muted nowrap">{p.data.year > new Date().getFullYear() ? (zh ? `${p.data.year} 即將刊登` : `${p.data.year}, forthcoming`) : p.data.year}</span></li>)}</ol>
        <p><a href={href(lang, 'research')}>{zh ? '全部論文與研究計畫 →' : 'All papers and grants →'}</a></p></section>
      <section class="sec"><h2>{zh ? '老師開的課' : 'Prof. Chiu’s courses'}</h2>
        <p class="muted small">{zh ? '114-2 與 115-1 學期。' : 'Spring and fall 2026.'}</p>
        {(['ug', 'grad'] as const).map((lv) => (
          <div class="courses">
            <h3>{lv === 'ug' ? (zh ? '大學部' : 'Undergraduate') : (zh ? '研究所' : 'Graduate')}</h3>
            <ul class="plain">{advisor.courses.filter((c) => c.level === lv).map((c) => <li><strong>{t(c.name, lang)}</strong> <span class="mono muted">{c.code}</span><br /><span class="muted">{t(c.note, lang)}</span></li>)}</ul>
          </div>
        ))}
      </section>
    </div>
    <section class="band">
      <div>
        <h2>{t(ui.sections.research, lang)}</h2>
        <ul class="tags">{advisor.research.map((r) => <li lang="en">{r}</li>)}</ul>
      </div>
      <div>
        <h2>{t(ui.sections.interests, lang)}</h2>
        <ul class="tags">{advisor.hobbies.map((h) => <li>{t(h, lang)}</li>)}</ul>
        <p class="muted artists">{zh ? '常聽：' : 'On repeat: '}{advisor.artists.map((a, i) => <>{i > 0 && (zh ? '、' : ', ')}<span class="nm">{a}</span></>)}</p>
      </div>
      <span class="cat-row"><LabCat lang={lang} size={64} bubble="left" lines={[{ zh: '老師愛貓，所以我住在這一頁。', en: 'The professor loves cats, so I live on this page.' }, { zh: '他也彈電吉他。我比較喜歡安靜的 Fusion。', en: 'He plays electric guitar too. I prefer the quieter fusion.' }]} /></span>
    </section>
    <div class="two">
      <section class="sec"><h2>{zh ? '獎項' : 'Awards'}</h2><ul class="plain">{advisor.awards.map((x) => <li>{t(x, lang)}</li>)}</ul></section>
      <section class="sec"><h2>{zh ? '證照' : 'Certifications'}</h2><ul class="plain lic">{advisor.licenses.map((l) => <li>{t(l, lang)}</li>)}</ul></section>
    </div>
  </article>
</Base>

<script>
  // Photo ⇄ clay figure. The 3D island only loads once the figure is first shown (client:visible on a hidden box).
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.portrait .flip')) {
    btn.addEventListener('click', () => {
      const box = btn.closest<HTMLElement>('.portrait')!;
      const toBuddy = box.dataset.face === 'photo';
      box.dataset.face = toBuddy ? 'buddy' : 'photo';
      btn.setAttribute('aria-pressed', String(toBuddy));
      btn.textContent = (toBuddy ? btn.dataset.on : btn.dataset.off) ?? '';
    });
  }
</script>

<style>
  .courses { display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  .courses h3 { font-size: 18px; }
  /* "…required, full / year" left one word on the last line */
  .courses li { text-wrap: pretty; }
  .courses li { line-height: 1.6; }
  .small { font-size: 15px; }
  .nowrap { white-space: nowrap; }
  .portrait { position: relative; width: 240px; display: grid; justify-items: center; gap: var(--space-3); flex: none; }
  .portrait > :global(picture), .buddy { grid-area: 1 / 1; }
  .portrait :global(.photo) {
    display: block; width: 240px; height: 240px; object-fit: cover; border-radius: var(--r-lg);
    box-shadow: 8px 10px 22px var(--lo), inset 0 0 0 1px rgb(0 0 0 / 0.06);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }
  .portrait > :global(picture) { grid-row: 1; grid-column: 1; }
  .buddy { position: relative; width: 240px; height: 260px; grid-row: 1; grid-column: 1; }
  [data-face='photo'] .buddy { display: none; }
  [data-face='buddy'] :global(picture) { display: none; }
  [data-face='buddy'] .buddy { animation: pop var(--dur-slow) var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: scale(0.96); } }
  .flip { min-height: 44px; cursor: pointer; font: inherit; font-size: 15px; border: 0; }
  .stage { position: absolute; inset: 0; display: grid; place-items: center; }
  .buddy[data-live] .stage { opacity: 0; transition: opacity var(--dur-base) var(--ease-out); }
  .buddy :global(.buddy-canvas) { position: absolute; inset: 0; cursor: grab; touch-action: pan-y; }
  .buddy :global(.buddy-canvas:active) { cursor: grabbing; }
  .buddy :global(.buddy-hint) {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); white-space: nowrap;
    font: 500 13px/1.4 var(--f-body); color: var(--ink-2); pointer-events: none;
  }
  .head { display: flex; gap: var(--space-6); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-7); }
  .who { display: grid; gap: var(--space-1); min-width: 0; }
  .en { font: 500 20px/1.3 var(--f-display); color: var(--ink-2); }
  .links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .links a { text-decoration: none; min-height: 40px; }
  .lead { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-7); align-items: start; margin-bottom: var(--space-9); }
  .bio { margin: 0; font: 500 clamp(19px, 1.6vw, 22px)/1.8 var(--f-body); max-width: 38em; text-wrap: pretty; }
  .facts { margin: 0; display: grid; gap: var(--space-4); }
  .facts div { display: grid; gap: 2px; padding-top: var(--space-2); border-top: 3px solid var(--clay-sun); }
  .facts dt { font-size: 14px; color: var(--ink-2); }
  .facts dd { margin: 0; font-size: 15px; }
  .facts b { font: 700 36px/1.1 var(--f-display); font-variant-numeric: tabular-nums; }
  .sec { display: grid; gap: var(--space-3); align-content: start; min-width: 0; margin-bottom: var(--space-9); }
  .sec h2, .band h2 { font-size: clamp(22px, 2.2vw, 28px); }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); }
  /* the one coloured surface on the page: what he works on and what he plays */
  .band {
    position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-8);
    padding: var(--space-7) var(--space-7) var(--space-8); margin-bottom: var(--space-9); border-radius: var(--r-lg);
    background: var(--tint-warm);
    box-shadow: 10px 14px 28px var(--lo), inset 0 2px 0 var(--hi), inset -6px -8px 14px rgb(0 0 0 / 0.05);
  }
  .band > div { display: grid; gap: var(--space-3); align-content: start; }
  .band .tags li { background: var(--surface); }
  .cat-row { position: absolute; right: var(--space-6); bottom: calc(-1 * var(--space-6)); }
  .recent { margin: 0; padding-left: 1.4em; display: grid; gap: var(--space-2); }
  .recent .mono { font-size: 13px; margin-left: var(--space-1); }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  /* licence names stay whole: two columns only when each column can hold the longest name */
  .lic li { word-break: keep-all; }
  @media (min-width: 768px) { .lic { display: grid; grid-template-columns: repeat(auto-fit, minmax(14em, 1fr)); column-gap: var(--space-5); } }
  @media (max-width: 899px) { .lead { grid-template-columns: 1fr; gap: var(--space-6); } .facts { grid-template-columns: repeat(3, auto); justify-content: start; column-gap: var(--space-6); } }
  @media (max-width: 767px) {
    .two, .band { grid-template-columns: 1fr; }
    .band { padding: var(--space-6) var(--space-5) var(--space-8); }
    .sec, .lead, .band { margin-bottom: var(--space-8); }
    .facts { grid-template-columns: 1fr 1fr; }
  }
  /* the title and 國立中央大學 管理學院 資訊管理學系 break only at their spaces */
  .role { word-break: keep-all; }
  .artists { margin: var(--space-3) 0 0; font-size: 15px; }
  .nm { white-space: nowrap; }
</style>
