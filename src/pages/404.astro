---
import LabCat from '@/components/LabCat.astro';
import Base from '@/layouts/Base.astro';
import { href } from '@/i18n/ui';
---
<Base lang="zh-tw" title="找不到頁面" description="這個頁面不存在。">
  <meta slot="head" name="robots" content="noindex" />
  {/* the host serves this one file for every missing URL; under /en/ it switches to English before the first paint */}
  <script slot="head" is:inline>
    if (location.pathname.startsWith('/en/')) { document.documentElement.lang = 'en'; document.documentElement.classList.add('lost-en'); document.title = 'Page not found | IFA Lab'; }
  </script>
  <div class="wrap section lost zh">
    <LabCat lang="zh-tw" size={120} bubble="right" lines={[{ zh: '我也找不到這塊積木……', en: '' }, { zh: '回首頁看看？', en: '' }]} />
    <h1>這塊積木不見了</h1>
    <p>這個網址沒有頁面，可能已經搬家了。從這幾個地方找找看：</p>
    <p class="cta">
      <a class="btn" href={href('zh-tw')}>回首頁</a>
      <a class="btn secondary" href={href('zh-tw', 'research')}>研究成果</a>
      <a class="btn secondary" href={href('zh-tw', 'members')}>成員</a>
      <a class="btn secondary" href={href('zh-tw', 'join')}>加入我們</a>
    </p>
  </div>
  <div class="wrap section lost en" lang="en">
    <LabCat lang="en" size={120} bubble="right" lines={[{ zh: '', en: 'I can’t find this brick either…' }, { zh: '', en: 'Back to the home page?' }]} />
    <h1>This brick is missing</h1>
    <p>Nothing lives at this address; it may have moved. Try one of these:</p>
    <p class="cta">
      <a class="btn" href={href('en')}>Home</a>
      <a class="btn secondary" href={href('en', 'research')}>Research</a>
      <a class="btn secondary" href={href('en', 'members')}>Members</a>
      <a class="btn secondary" href={href('en', 'join')}>Join us</a>
    </p>
  </div>
</Base>

<style>
  .lost { display: grid; justify-items: center; text-align: center; gap: var(--space-4); padding-block: var(--space-9); }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-3); }
  .lost.en { display: none; }
  :global(html.lost-en) .lost.en { display: grid; }
  :global(html.lost-en) .lost.zh { display: none; }
</style>
