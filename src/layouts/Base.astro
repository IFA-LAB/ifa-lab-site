---
import MailPick from '@/components/MailPick.astro';
import AskCat from '@/components/AskCat.astro';
import '@/styles/global.css';
import ScrollCat from '@/components/ScrollCat.astro';
import Header from '@/components/Header.astro';
import Gate from '@/components/Gate.astro';
import Footer from '@/components/Footer.astro';
import { htmlLang, ogLocale, locales, swapLocale, ui, t, type Locale } from '@/i18n/ui';
import { lab } from '@/data/lab';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. The Organization node is always added. */
  jsonld?: object[];
  ogType?: 'website' | 'profile' | 'article';
  /** Absolute or root-relative URL of a square share image (a member photo). Without it, the page shares the
   *  1200×630 shot of the home page (public/og-<lang>-N.jpg; when it changes, bump N: LINE caches share images by URL). */
  image?: string;
  /** Trail between home and this page, for BreadcrumbList. Root-relative paths; the last item is this page. */
  crumbs?: { name: string; path: string }[];
  /** The page opens on a 3D scene: hold it behind the loading screen until the scene has drawn (Gate.astro). */
  gate?: boolean;
  /** Keep this page out of search results (an empty profile reads as a soft 404). */
  noindex?: boolean;
}
const { lang, title, description, jsonld = [], ogType = 'website', image, crumbs, gate = false, noindex = false } = Astro.props;
const site = Astro.site!;
const path = Astro.url.pathname;
const canonical = new URL(path, site).href;
// titles carry what people actually search for (中央大學, 資管), not only the lab's short name
const fullTitle = title === lab.short
  ? (lang === 'zh-tw' ? `${lab.short} ${lab.name.zh}｜中央大學資管系` : `${lab.short} | ${lab.name.en}, National Central University`)
  : (lang === 'zh-tw' ? `${title}｜IFA Lab 中央大學資管` : `${title} | IFA Lab, NCU`);

const org = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  '@id': new URL('/#org', site).href,
  name: `${lab.short} — ${lab.name.en}`,
  alternateName: [lab.name.zh, `${lab.short}-${lab.name.zh}`],
  url: new URL(`/${lang}/`, site).href,
  foundingDate: lab.founded,
  email: lab.contact.email,
  telephone: lab.contact.phone,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'National Central University',
    alternateName: '國立中央大學',
    department: { '@type': 'Organization', name: lab.dept.en },
  },
  address: { '@type': 'PostalAddress', streetAddress: lab.contact.address.en, addressCountry: 'TW' },
  logo: new URL('/logo.png', site).href,
  sameAs: ['https://github.com/IFA-LAB'],
};
const shareImage = new URL(image ?? `/og-${lang === 'en' ? 'en' : 'zh'}-2.jpg`, site).href;
// every page says which site it belongs to and who publishes it, so an answer engine can attribute what it quotes
const webPage = {
  '@type': ogType === 'profile' ? 'ProfilePage' : 'WebPage',
  '@id': canonical,
  url: canonical,
  name: fullTitle,
  inLanguage: htmlLang[lang],
  isPartOf: { '@type': 'WebSite', '@id': new URL('/#site', site).href, name: lab.short, url: new URL(`/${lang}/`, site).href },
  publisher: { '@id': org['@id'] },
  ...(crumbs?.length
    ? { breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ name: lab.short, path: `/${lang}/` }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site).href })) } }
    : {}),
};
const graph = [org, webPage, ...jsonld];
---
<!doctype html>
<html lang={htmlLang[lang]} data-gate-page={gate ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(swapLocale(path, l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(swapLocale(path, 'zh-tw'), site).href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={lab.short} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={shareImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary' : 'summary_large_image'} />
    <meta name="theme-color" content="#eef2f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141a23" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      try { const s = localStorage.getItem('theme'); if (s === 'light' || s === 'dark') document.documentElement.dataset.theme = s; } catch {}
      // desktop with a mouse: the scrollbar becomes K 喵's candle (ScrollCat.astro); decided before paint so nothing shifts
      // pages that open on 3D wait behind the loading screen, but only when the 3D will run (same test as canRun3D)
      if (document.documentElement.hasAttribute('data-gate-page') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const n = navigator;
        let gl = false; try { const c = document.createElement('canvas').getContext('webgl2'); gl = !!c; c?.getExtension('WEBGL_lose_context')?.loseContext(); } catch {}
        if (gl && !n.connection?.saveData && !(n.deviceMemory < 4)) document.documentElement.setAttribute('data-gate', '');
      }
      if (matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('cat-scroll');
      // Shared elements between pages: the paper title you clicked grows into the paper page's heading (its brick into the
      // heading's stud); a member's face and name fly to the profile's portrait and name. Pairs are named only for the one
      // navigation that needs them, so every page keeps unique view-transition names. No support / reduced motion: plain navigation.
      if ('onpagereveal' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let link = null;
        addEventListener('click', (e) => { link = e.target.closest?.('a[href]') ?? null; }, true);
        const clear = (els) => els.forEach((el) => { el.style.viewTransitionName = ''; });
        addEventListener('pageswap', (e) => {
          const to = e.activation?.entry?.url;
          if (!e.viewTransition || !link || !to || new URL(link.href).pathname !== new URL(to).pathname) return;
          const box = link.closest('li') ?? link, paper = /\/papers\/[^/]+\/?$/.test(to), member = /\/members\/[^/]+\/?$/.test(to);
          const pick = paper ? { title: box.querySelector('[data-vt=title]') ?? link, brick: box.querySelector('[data-vt=brick]') }
            : member ? { face: box.querySelector('[data-vt=face]') ?? link.querySelector('.fig'), name: box.querySelector('[data-vt=name]') } : {};
          const keys = Object.keys(pick).filter((k) => pick[k]);
          keys.forEach((k) => { pick[k].style.viewTransitionName = 'vt-' + k; });
          try { sessionStorage.setItem('vt', keys.join(' ')); } catch {}
          e.viewTransition.finished.finally(() => clear(keys.map((k) => pick[k])));
        });
        addEventListener('pagereveal', (e) => {
          let keys = '';
          try { keys = sessionStorage.getItem('vt') ?? ''; sessionStorage.removeItem('vt'); } catch {}
          if (!e.viewTransition || !keys) return;
          const els = keys.split(' ').map((k) => { const el = document.querySelector(`[data-vt-dest="${k}"]`); if (el) el.style.viewTransitionName = 'vt-' + k; return el; }).filter(Boolean);
          e.viewTransition.finished.finally(() => clear(els));
        });
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : { '@context': 'https://schema.org', '@graph': graph.map(({ '@context': _c, ...g }: any) => g) })} />
    {/* the next page renders in the background while the pointer rests on its link, so arriving is instant */}
    <script type="speculationrules" set:html={JSON.stringify({ prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] })} />
    <slot name="head" />
  </head>
  <body>
    {gate && <Gate lang={lang} />}
    <a class="skip" href="#main">{t(ui.skip, lang)}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollCat lang={lang} />
    <MailPick lang={lang} />
    <AskCat lang={lang} />
    {/* Chinese paragraphs never end on a line of one or two characters: the last four characters stay together.
         text-wrap: pretty does not do this for CJK in Chromium. Runs before first paint; skips React islands (their
         DOM must match what they hydrate). Same rule as glueTail() in src/lib/glue.ts. */}
    {lang === 'zh-tw' && <script is:inline>
      (() => {
        const cjk = /[\u3400-\u9fff\uf900-\ufaff]/;
        // names the dictionary does not know, so they are never cut (台／積電)
        const KEEP = ['台積電', '工研院', '中研院', '國科會', '資策會', '中華電信', '玉山銀行', '國泰金控', '富邦金控', '聯發科', '鴻海', '邱信瑜', '黑客松', '懶人包', '資安', '準實驗', '自適應', '去過', '沙盒', '生成式', '衍生性', '個人化', '財伴', '研發替代役', '替代役'];
        const seg = Intl.Segmenter ? new Intl.Segmenter('zh-Hant', { granularity: 'word' }) : null;
        for (const el of document.querySelectorAll('main p, main li, main dd, main figcaption, main summary, footer p')) {
          if (el.closest('astro-island, pre, code, .nw')) continue;
          const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          let t, last = null;
          while ((t = w.nextNode())) if (t.data.trim()) last = t;
          if (!last || last.parentElement.closest('.glue, .nw')) continue;
          const s = last.data.replace(/\s+$/, '');
          let i = s.length, n = 0;
          while (i > 0 && n < 4) { const c = s[i - 1]; if (/[\sA-Za-z0-9]/.test(c)) break; if (cjk.test(c)) n++; i--; }
          // back to the start of the word the cut falls in (台積電 stays whole)
          if (seg) { let st = 0; for (const x of seg.segment(s)) { if (x.index > i) break; st = x.index; } i = st; }
          for (const k of KEEP) for (let j = s.indexOf(k); j >= 0; j = s.indexOf(k, j + 1)) if (j < i && i < j + k.length) i = j;
          if (!n || i < 6) continue;
          const tail = last.splitText(i);
          const span = document.createElement('span');
          span.className = 'glue';
          tail.before(span);
          span.append(tail);
        }
        // Lines break between words, never inside one (投資人, not 投／資人): Chrome's word-break: auto-phrase only knows
        // Japanese, so mark the word boundaries with <wbr> and let .wb (keep-all) forbid every other break between characters.
        if (!seg) return;
        const pair = /[㐀-鿿豈-﫿]$/;
        for (const el of document.querySelectorAll('main :is(p, li, dd, dt, h1, h2, h3, h4, td, figcaption, summary), footer p')) {
          if (el.closest('astro-island, pre, code, .lines')) continue;
          // already done as part of its parent; it still needs the class, or the global auto-phrase rule on p/li wins
          if (el.parentElement?.closest('.wb')) { el.classList.add('wb'); continue; }
          const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes = [];
          let t;
          while ((t = w.nextNode())) if (cjk.test(t.data) && !t.parentElement.closest('.glue, .nw, code, astro-island')) nodes.push(t);
          for (const node of nodes) {
            const f = document.createDocumentFragment();
            const inside = new Set();
            for (const k of KEEP) for (let i = node.data.indexOf(k); i >= 0; i = node.data.indexOf(k, i + 1)) for (let j = 1; j < k.length; j++) inside.add(i + j);
            let prev = '';
            for (const x of seg.segment(node.data)) {
              // a break point only where a Chinese word meets another Chinese word
              if (prev && pair.test(prev) && cjk.test(x.segment[0]) && !inside.has(x.index)) f.append(document.createElement('wbr'));
              f.append(x.segment);
              prev = x.segment;
            }
            node.replaceWith(f);
          }
          el.classList.add('wb');
        }
      })();
    </script>}
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 16px; top: -60px; z-index: 50;
    background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: var(--r-sm);
  }
  .skip:focus { top: 12px; }
  main:focus { outline: none; }
</style>
