---
// The 404 page in one language. dist/404.html (Chinese) is served for missing URLs anywhere; dist/en/404.html
// (English, copied into place after the build by scripts/en-404.mjs) for missing URLs under /en/.
import LabCat from '@/components/LabCat.astro';
import Base from '@/layouts/Base.astro';
import { href, type Locale } from '@/i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const zh = lang === 'zh-tw';
const links = zh
  ? [['回首頁', href(lang)], ['研究成果', href(lang, 'research')], ['成員', href(lang, 'members')], ['加入我們', href(lang, 'join')]]
  : [['Home', href(lang)], ['Research', href(lang, 'research')], ['Members', href(lang, 'members')], ['Join us', href(lang, 'join')]];
---
<Base lang={lang} title={zh ? '找不到頁面' : 'Page not found'} description={zh ? '這個頁面不存在。' : 'This page does not exist.'}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="wrap section lost">
    <LabCat lang={lang} size={120} bubble="right" lines={zh
      ? [{ zh: '我也找不到這塊積木……', en: '' }, { zh: '回首頁看看？', en: '' }]
      : [{ zh: '', en: 'I can’t find this brick either…' }, { zh: '', en: 'Back to the home page?' }]} />
    <h1>{zh ? '找不到這一頁' : 'Page not found'}</h1>
    <p>{zh ? '這個連結壞了，或頁面搬走了。找論文就從「研究成果」開始：' : 'This link is broken or the page has moved. Looking for a paper? Start from Research:'}</p>
    <p class="cta">
      {links.map(([label, url], i) => <a class:list={['btn', i > 0 && 'secondary']} href={url}>{label}</a>)}
    </p>
  </div>
</Base>

<style>
  .lost { display: grid; justify-items: center; text-align: center; gap: var(--space-4); padding-block: var(--space-9); }
  .cta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-3); }
</style>
