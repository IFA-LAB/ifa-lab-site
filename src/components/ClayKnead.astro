---
/**
 * The wait between "show the clay figure" and the 3D figure's first frame: a lump of the member's own clay being kneaded,
 * with pellets dropping in, instead of the flat CSS figure that would otherwise flash first.
 * Goes inside a `[data-buddy]` box, after the island. The inline script runs the same test as canRun3D before paint:
 * when 3D will run, the box gets data-knead (flat figure hidden, lump shown) until ClayBuddy marks it data-live
 * after its first frames. Without JavaScript or 3D nothing changes and the CSS figure shows; if 3D never draws,
 * the CSS figure comes back after 10 s. Hovering or focusing the flip button starts fetching the 3D code early.
 */
import type { Locale } from '@/i18n/ui';
interface Props { lang: Locale; clay: string }
const { lang, clay } = Astro.props;
---
<div class="knead" style={`--c: var(--clay-${clay})`} aria-hidden="true">
  <div class="tray">
    <i class="bit" style="--x: -34px; --d: 0s"></i>
    <i class="bit" style="--x: 30px; --d: 0.55s"></i>
    <i class="bit" style="--x: -4px; --d: 1.1s"></i>
    <span class="lump"></span>
    <span class="shade"></span>
  </div>
  <p class="note">{lang === 'zh-tw' ? '正在捏黏土…' : 'Shaping the clay…'}</p>
</div>
<script is:inline>
  (() => {
    const box = document.currentScript?.closest('[data-buddy]');
    if (!box) return;
    const n = navigator;
    let gl = false;
    try { const c = document.createElement('canvas').getContext('webgl2'); gl = !!c; c?.getExtension('WEBGL_lose_context')?.loseContext(); } catch {}
    if (!gl || n.connection?.saveData || n.deviceMemory < 4) return;
    box.setAttribute('data-knead', '');
    // warm the island's code as soon as the visitor reaches for the button, so the lump is kneaded for less time
    const btn = box.closest('.portrait')?.querySelector('.flip');
    const warm = () => {
      const isl = box.querySelector('astro-island');
      for (const a of ['component-url', 'renderer-url']) { const u = isl?.getAttribute(a); if (u) import(u).catch(() => {}); }
    };
    for (const e of ['pointerenter', 'focus', 'touchstart']) btn?.addEventListener(e, warm, { once: true, passive: true });
  })();
</script>

<style>
  .knead {
    position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: var(--space-4);
    pointer-events: none; opacity: 0; visibility: hidden;
  }
  :global([data-buddy][data-knead]:not([data-live])) .knead { opacity: 1; visibility: visible; animation: knead-giveup 0.3s 10s forwards; }
  /* once the figure is drawn the lump shrinks away under it */
  :global([data-buddy][data-knead][data-live]) .knead {
    opacity: 0; visibility: hidden; transform: scale(0.7);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }
  /* hide the flat figure while kneading; bring it back if the 3D gives up */
  :global([data-buddy][data-knead]:not([data-live]) .stage) { opacity: 0; animation: knead-back 0.3s 10s forwards; }
  /* the 3D figure pops out of the lump */
  :global([data-buddy][data-knead] .buddy-canvas canvas), :global([data-buddy][data-knead] .buddy-hint) { opacity: 0; }
  :global([data-buddy][data-knead][data-live] .buddy-canvas canvas) { opacity: 1; animation: knead-pop 520ms cubic-bezier(0.34, 1.4, 0.64, 1); }
  :global([data-buddy][data-knead][data-live] .buddy-hint) { opacity: 1; transition: opacity var(--dur-base) var(--ease-out) 300ms; }

  .tray { position: relative; width: 120px; height: 120px; display: grid; place-items: end center; }
  .lump {
    position: relative; width: 92px; height: 78px; margin-bottom: 14px; background: var(--c);
    border-radius: 48% 52% 46% 54% / 60% 56% 44% 40%; transform-origin: 50% 100%;
    box-shadow: inset -10px -12px 18px rgb(0 0 0 / 0.2), inset 9px 8px 14px rgb(255 255 255 / 0.38);
    animation: knead 1.65s ease-in-out infinite;
  }
  /* a thumb pressing in, once a round */
  .lump::after {
    content: ''; position: absolute; left: 30%; top: 26%; width: 30%; height: 24%; border-radius: 50%;
    background: rgb(0 0 0 / 0.12); box-shadow: inset 2px 3px 4px rgb(0 0 0 / 0.16);
    animation: thumb 1.65s ease-in-out infinite;
  }
  .shade { position: absolute; bottom: 6px; width: 96px; height: 12px; border-radius: 50%; background: rgb(0 0 0 / 0.14); animation: shade 1.65s ease-in-out infinite; }
  .bit {
    position: absolute; left: calc(50% + var(--x) - 9px); top: 0; width: 18px; height: 18px; border-radius: 50%; background: var(--c);
    box-shadow: inset -3px -4px 5px rgb(0 0 0 / 0.2), inset 3px 3px 4px rgb(255 255 255 / 0.35);
    opacity: 0; animation: drop 1.65s var(--d) cubic-bezier(0.5, 0, 0.75, 0) infinite;
  }
  .note { margin: 0; font: 500 13px/1.4 var(--f-body); color: var(--ink-2); }

  @keyframes knead {
    0%, 100% { transform: scale(1, 1); border-radius: 48% 52% 46% 54% / 60% 56% 44% 40%; }
    25% { transform: scale(1.12, 0.84); border-radius: 56% 44% 52% 48% / 50% 62% 38% 50%; }
    50% { transform: scale(0.94, 1.08); border-radius: 44% 56% 58% 42% / 64% 48% 52% 36%; }
    75% { transform: scale(1.06, 0.92) rotate(-3deg); border-radius: 52% 48% 44% 56% / 56% 60% 40% 44%; }
  }
  @keyframes thumb { 0%, 15%, 45%, 100% { opacity: 0; transform: scale(0.4); } 25%, 35% { opacity: 1; transform: scale(1); } }
  @keyframes shade { 0%, 50%, 100% { transform: scaleX(1); } 25% { transform: scaleX(1.14); } }
  @keyframes drop {
    0% { opacity: 0; transform: translateY(-8px) scale(0.8); }
    10% { opacity: 1; }
    55% { opacity: 1; transform: translateY(62px) scale(1); }
    70%, 100% { opacity: 0; transform: translateY(70px) scale(0.3); }
  }
  @keyframes knead-pop { from { opacity: 0; transform: scale(0.82) translateY(10px); } 40% { opacity: 1; } }
  @keyframes knead-giveup { to { opacity: 0; visibility: hidden; } }
  @keyframes knead-back { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .lump, .lump::after, .shade { animation: none; }
    .bit { display: none; }
    :global([data-buddy][data-knead][data-live] .buddy-canvas canvas) { animation: knead-fade var(--dur-fast) var(--ease-out); }
  }
  @keyframes knead-fade { from { opacity: 0; } }
</style>
