---
/** K 喵 keeps you company while you scroll. On desktop the page's scrollbar itself becomes a K-line candle:
    the track is the wick, the thumb is a clay candle body, and the cat hugs the candle and climbs after it.
    Drag the candle (or the cat) to scroll; press the track to jump. The native scrollbar is hidden only where this
    runs: Base.astro sets `html.cat-scroll` before paint (desktop, mouse, ≥1024px, no reduced motion).
    Cat: scroll down → climbs down tail first; up → climbs up; a fling → slides. Stops → turns round to face you;
    idle → looks at the page; bottom → sleeps. Click → meow, and back to the top. Steps away while the page's own
    K 喵 is on screen (it is the same cat); the candle stays. */
import type { Locale } from '@/i18n/ui';
interface Props { lang: Locale }
const zh = Astro.props.lang === 'zh-tw';
const text = zh
  ? { label: 'K 喵：回到頁面頂端', top: '回到上面囉！', lines: ['我在旁邊陪你看。', '我抱著的這根 K 棒就是捲軸，拖我也能捲。', '往下滾，我就跟著爬。'] }
  : { label: 'K-meow: back to top', top: 'Back to the top!', lines: ['I will keep you company.', 'The candle I am hugging is the scrollbar. Drag me to scroll.', 'Scroll down and I climb along.'] };
---
<div class="scrollcat" data-pose="front" hidden>
  {/* the page's scrollbar: a candle wick (track) with a clay candle body (thumb) */}
  <div class="rail" aria-hidden="true"><span class="wick"></span><span class="thumb"></span></div>
  <div class="rider">
    <button type="button" class="cat" aria-label={text.label} data-top={text.top} data-lines={JSON.stringify(text.lines)}>
      <svg viewBox="0 0 64 84" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id="sc-fur" cx="40%" cy="30%" r="75%">
            <stop offset="0" style="stop-color: var(--fur-hi)" />
            <stop offset="1" style="stop-color: var(--fur)" />
          </radialGradient>
        </defs>
        <!-- tail hangs below; it swishes while idle and streams up while sliding -->
        <g class="tail"><path d="M32 64 C32 76 44 80 46 72" fill="none" style="stroke: var(--fur)" stroke-width="6" stroke-linecap="round" /></g>
        <!-- hind legs and front paws grip the candle (x = 32) -->
        <g class="limbs" style="fill: var(--fur-hi)">
          <ellipse class="paw fl" cx="21" cy="36" rx="5" ry="4" />
          <ellipse class="paw fr" cx="43" cy="36" rx="5" ry="4" />
          <ellipse class="paw hl" cx="22" cy="62" rx="6" ry="4.5" />
          <ellipse class="paw hr" cx="42" cy="62" rx="6" ry="4.5" />
        </g>
        <ellipse class="body" cx="32" cy="50" rx="15" ry="17" fill="url(#sc-fur)" />
        <g class="head">
          <path d="M18 24 L16 6 Q17 4 19 5 L29 15 Z" style="fill: var(--fur)" />
          <path d="M46 24 L48 6 Q47 4 45 5 L35 15 Z" style="fill: var(--fur)" />
          <ellipse cx="32" cy="24" rx="16" ry="13.5" fill="url(#sc-fur)" />
          <!-- the face: only when it turns round -->
          <g class="face">
            <path d="M20 19 L19 10 L25 15 Z" fill="#f2a3b3" opacity="0.8" />
            <path d="M44 19 L45 10 L39 15 Z" fill="#f2a3b3" opacity="0.8" />
            <g class="eyes open"><ellipse cx="26" cy="24" rx="2.2" ry="2.7" fill="#f4f7fb" /><ellipse cx="38" cy="24" rx="2.2" ry="2.7" fill="#f4f7fb" /></g>
            <g class="eyes shut" fill="none" stroke="#f4f7fb" stroke-width="1.6" stroke-linecap="round"><path d="M23.5 25 Q26 27.5 28.5 25" /><path d="M35.5 25 Q38 27.5 40.5 25" /></g>
            <ellipse cx="21.5" cy="29" rx="2.8" ry="1.7" fill="#f2a3b3" opacity="0.75" />
            <ellipse cx="42.5" cy="29" rx="2.8" ry="1.7" fill="#f2a3b3" opacity="0.75" />
            <path d="M30.5 29 Q32 30.6 33.5 29" fill="none" stroke="#f2a3b3" stroke-width="1.3" stroke-linecap="round" />
          </g>
        </g>
        <g class="zzz" style="fill: var(--ink-2)" font-size="12" font-weight="700"><text x="47" y="12">z</text><text x="55" y="3" font-size="9">z</text></g>
      </svg>
    </button>
    <span class="bubble" role="status" aria-live="polite"></span>
  </div>
</div>

<script>
  import { meow } from '@/lib/sfx';
  const root = document.querySelector<HTMLElement>('.scrollcat');
  const doc = document.documentElement;
  // Base.astro adds `cat-scroll` (and hides the native scrollbar) only where this should run
  if (root && doc.classList.contains('cat-scroll')) {
    const rider = root.querySelector<HTMLElement>('.rider')!;
    const rail = root.querySelector<HTMLElement>('.rail')!;
    const thumb = root.querySelector<HTMLElement>('.thumb')!;
    const btn = root.querySelector<HTMLButtonElement>('.cat')!;
    const bubble = root.querySelector<HTMLElement>('.bubble')!;
    const lines: string[] = JSON.parse(btn.dataset.lines ?? '[]');
    const TOP = 72, BOTTOM = 10; // the track runs from under the header to near the window edge
    let y = -1, raf = 0, idle = 0, said = 0, talk = 0, still = 0, rest = 0;
    const range = () => doc.scrollHeight - innerHeight;
    const progress = () => (range() > 0 ? Math.min(1, Math.max(0, scrollY / range())) : 0);
    const trackH = () => innerHeight - TOP - BOTTOM;
    const thumbH = () => Math.max(40, Math.round((trackH() * innerHeight) / doc.scrollHeight));
    const thumbTop = () => TOP + progress() * (trackH() - thumbH());
    // the cat hugs the middle of the candle
    const target = () => Math.min(innerHeight - rider.offsetHeight - 4, Math.max(TOP - 8, thumbTop() + thumbH() / 2 - rider.offsetHeight / 2));
    const pose = (p: string) => { if (root.dataset.pose !== p) root.dataset.pose = p; };
    const place = () => { thumb.style.height = `${thumbH()}px`; thumb.style.translate = `0 ${thumbTop().toFixed(1)}px`; };
    // after it settles: face you, then look at the page, or sleep at the very bottom
    const settle = () => {
      clearTimeout(idle); clearTimeout(rest);
      rest = window.setTimeout(() => root.classList.remove('moving'), 1500);
      pose(progress() > 0.985 ? 'sleep' : 'front');
      if (root.dataset.pose === 'front') idle = window.setTimeout(() => pose('peek'), 5000);
    };
    const step = () => {
      raf = 0;
      const t = target();
      if (y < 0) y = t;
      const d = t - y;
      if (Math.abs(d) < 1.5) { y = t; rider.style.translate = `0 ${y}px`; settle(); return; }
      clearTimeout(idle); clearTimeout(rest);
      root.classList.add('moving');
      y += d * 0.12; // the candle moves at once; the cat climbs after it
      rider.style.translate = `0 ${y.toFixed(1)}px`;
      root.dataset.dir = d > 0 ? 'down' : 'up';
      pose(Math.abs(d) > 140 ? 'slide' : 'climb');
      raf = requestAnimationFrame(step);
    };
    const kick = () => {
      place();
      if (!raf) raf = requestAnimationFrame(step);
      // scrolling stopped a moment ago: arrive and turn round even if frames were throttled
      clearTimeout(still);
      still = window.setTimeout(() => { cancelAnimationFrame(raf); raf = 0; y = target(); rider.style.translate = `0 ${y.toFixed(1)}px`; settle(); }, 700);
    };
    // any scrollable page gets the candle; the cat only comes out on pages worth climbing
    const sizeUp = () => { root.hidden = range() <= 0; root.classList.toggle('short', range() < innerHeight * 0.6); kick(); };
    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', sizeUp, { passive: true });
    new ResizeObserver(sizeUp).observe(document.body);
    sizeUp();

    // drag the candle (or the cat) to scroll; press the track to jump there
    let grab: number | null = null, moved = false, startY = 0;
    const scrollToThumb = (top: number) => {
      const p = Math.min(1, Math.max(0, (top - TOP) / (trackH() - thumbH())));
      scrollTo({ top: p * range(), behavior: 'instant' });
    };
    const down = (e: PointerEvent, onThumb: boolean) => {
      if (e.button !== 0) return;
      grab = onThumb ? e.clientY - thumbTop() : thumbH() / 2;
      startY = e.clientY; moved = false;
      (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId);
      root.classList.add('dragging');
      if (!onThumb) { moved = true; scrollToThumb(e.clientY - grab); }
    };
    const move = (e: PointerEvent) => {
      if (grab === null) return;
      if (Math.abs(e.clientY - startY) > 4) moved = true;
      if (moved) scrollToThumb(e.clientY - grab);
    };
    const up = () => { grab = null; root.classList.remove('dragging'); };
    rail.addEventListener('pointerdown', (e) => down(e, e.target === thumb));
    btn.addEventListener('pointerdown', (e) => down(e, true));
    for (const el of [rail, btn]) { el.addEventListener('pointermove', move); el.addEventListener('pointerup', up); el.addEventListener('pointercancel', up); }

    // the page's own K 喵 is the same cat: when it is on screen, the climber steps away (the candle stays)
    const homes = document.querySelectorAll('.labcat');
    if (homes.length) {
      const near = new Set<Element>();
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? near.add(e.target) : near.delete(e.target)));
        root.classList.toggle('away', near.size > 0);
      });
      homes.forEach((h) => io.observe(h));
    }
    btn.addEventListener('click', (e) => {
      if (moved) { e.preventDefault(); moved = false; return; } // that was a drag, not a click
      meow();
      const goUp = progress() > 0.25;
      bubble.textContent = goUp ? btn.dataset.top ?? '' : lines[said++ % lines.length];
      root.classList.add('talking');
      clearTimeout(talk);
      talk = window.setTimeout(() => { root.classList.remove('talking'); talk = window.setTimeout(() => (bubble.textContent = ''), 300); }, 2600);
      if (goUp) scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* only where the cat runs: the native scrollbar steps aside for the candle */
  :global(html.cat-scroll) { scrollbar-width: none; }
  :global(html.cat-scroll::-webkit-scrollbar) { display: none; }

  .scrollcat {
    --fur: #3a4252; --fur-hi: #57627a;
    position: fixed; top: 0; right: 0; bottom: 0; width: 64px; z-index: 30; pointer-events: none;
  }
  :global(:root[data-theme='dark']) .scrollcat { --fur: #5d667a; --fur-hi: #7d88a0; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .scrollcat { --fur: #5d667a; --fur-hi: #7d88a0; } }

  /* rail = the scrollbar's hit area; wick = track; thumb = the candle body */
  .rail { position: absolute; top: 0; bottom: 0; right: 22px; width: 20px; pointer-events: auto; cursor: pointer; }
  .wick { position: absolute; top: 72px; bottom: 10px; left: 9px; width: 2px; border-radius: 1px; background: color-mix(in oklab, var(--ink) 14%, transparent); }
  .thumb {
    position: absolute; top: 0; left: 3px; width: 14px; border-radius: 7px; cursor: grab;
    background: var(--clay-blue);
    box-shadow: inset -3px -4px 5px rgb(0 0 0 / 0.18), inset 3px 3px 5px rgb(255 255 255 / 0.35), 2px 4px 8px var(--lo);
    transition: scale var(--dur-fast) var(--ease-out), filter var(--dur-fast) var(--ease-out);
  }
  .rail:hover .thumb { scale: 1.2 1; filter: brightness(1.06); }
  .dragging .thumb { cursor: grabbing; filter: brightness(1.1); }
  :global(html:has(.scrollcat.dragging)) { user-select: none; }

  .rider { position: absolute; top: 0; right: 0; width: 64px; will-change: translate; transition: opacity var(--dur-slow) var(--ease-out); }
  /* the page's own K 喵 is on screen, or the page is short: the climber leaves, the candle stays */
  .away .rider, .short .rider { opacity: 0; }
  .away .cat, .short .cat { pointer-events: none; }
  .cat { display: block; width: 64px; height: 84px; padding: 0; border: 0; background: none; cursor: grab; pointer-events: auto; border-radius: var(--r-md); touch-action: none; }
  .cat svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(2px 4px 5px var(--lo)); }
  @media (max-width: 1279px) {
    /* the window gutter is narrow here: a smaller cat; the candle sits right at the edge */
    .scrollcat { width: 44px; }
    .rider, .cat { width: 44px; } .cat { height: 58px; }
    .cat svg { translate: 12px 0; }
    .rail { right: 0; }
    .wick { left: 12px; } .thumb { left: 7px; width: 12px; }
    /* no room to park on the text column: the cat shows while you scroll, then tucks away; the candle stays */
    .scrollcat:not(.moving):not(.talking):not(.dragging) .rider { opacity: 0; }
    .scrollcat:not(.moving):not(.talking):not(.dragging) .cat { pointer-events: none; }
  }

  /* --- poses --- */
  .head, .body, .tail, .paw { transform-box: fill-box; transform-origin: center; }
  .face, .zzz, .eyes.shut { opacity: 0; transition: opacity var(--dur-fast) var(--ease-out); }
  /* climbing: seen from behind, paws step in turn; climbing down reverses the order */
  [data-pose='climb'] .fl, [data-pose='climb'] .hr { animation: step 380ms ease-in-out infinite; }
  [data-pose='climb'] .fr, [data-pose='climb'] .hl { animation: step 380ms ease-in-out infinite reverse; }
  [data-pose='climb'] .body { animation: sway 380ms ease-in-out infinite alternate; }
  [data-dir='down'] .paw { animation-direction: reverse; }
  [data-dir='down'] .fr, [data-dir='down'] .hl { animation-direction: normal; }
  @keyframes step { 0%, 100% { translate: 0 0; } 50% { translate: 0 -4px; } }
  @keyframes sway { from { rotate: -3deg; } to { rotate: 3deg; } }
  /* sliding on a fast scroll: paws up, tail streaming */
  [data-pose='slide'] .fl, [data-pose='slide'] .fr { translate: 0 -5px; }
  [data-pose='slide'][data-dir='down'] .tail { rotate: 180deg; translate: 0 -30px; }
  [data-pose='slide'] .body { scale: 0.94 1.06; }
  /* stopped: it turns round to face you and blinks now and then */
  [data-pose='front'] .face, [data-pose='peek'] .face, [data-pose='sleep'] .face { opacity: 1; }
  [data-pose='front'] .tail, [data-pose='peek'] .tail { animation: swish 2.4s ease-in-out infinite; transform-origin: 0% 0%; }
  [data-pose='front'] .eyes.open { animation: blink 4.2s infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes swish { 0%, 100% { rotate: 0deg; } 50% { rotate: 14deg; } }
  @keyframes blink { 0%, 94%, 100% { scale: 1 1; } 97% { scale: 1 0.1; } }
  /* idle a while: head turns towards the page, eyes looking left */
  [data-pose='peek'] .head { rotate: -12deg; translate: -3px 1px; transition: rotate var(--dur-slow) var(--ease-out), translate var(--dur-slow) var(--ease-out); }
  [data-pose='peek'] .eyes.open { translate: -2px 0; }
  /* end of the page: eyes shut, zzz */
  [data-pose='sleep'] .eyes.open { opacity: 0; }
  [data-pose='sleep'] .eyes.shut, [data-pose='sleep'] .zzz { opacity: 1; }
  [data-pose='sleep'] .zzz { animation: float 2.6s ease-in-out infinite; }
  [data-pose='sleep'] .body { animation: breathe 2.6s ease-in-out infinite; }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 2px -3px; } }
  @keyframes breathe { 0%, 100% { scale: 1 1; } 50% { scale: 1.04 1.02; } }
  .cat:active svg { scale: 0.94; transition: scale var(--dur-press) var(--ease-out); }

  .bubble {
    position: absolute; right: calc(100% + 4px); top: 8px; width: max-content; max-width: 220px;
    padding: 8px 12px; border-radius: var(--r-md); background: var(--surface); color: var(--ink);
    font: 500 15px/1.5 var(--f-body); box-shadow: 4px 6px 14px var(--lo), inset 0 2px 0 var(--hi);
    opacity: 0; translate: 6px 0; pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-base) var(--ease-out);
  }
  .bubble:empty { display: none; }
  .talking .bubble { opacity: 1; translate: 0 0; }
</style>
