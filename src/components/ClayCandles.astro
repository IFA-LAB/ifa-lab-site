---
/** Static clay picture of the home board (CSS only): one block per research area, area colour, height by
    number of works. Shown before the three.js scene loads and when WebGL cannot run; it fades out once the
    canvas is live, so it matches the 3D board's colours and proportions. */
interface Props { label: string; bars: { clay: string; count: number }[] }
const { label, bars } = Astro.props;
const max = Math.max(1, ...bars.map((b) => b.count));
---
<figure class="stage" role="img" aria-label={label}>
  <div class="plate"></div>
  <div class="candles" style={`--n: ${bars.length}`}>
    {bars.map((b) => (
      <div class="candle" style={`--c: var(--clay-${b.clay})`}>
        <span class="wick" style={`height:${18 + (b.count / max) * 62}%`}></span>
        <span class="body" style={`height:${b.count ? 10 + (b.count / max) * 58 : 0}%`}></span>
      </div>
    ))}
  </div>
  <div class="coin c1"></div><div class="coin c2"></div>
</figure>

<style>
  .stage { position: relative; margin: 0; height: 100%; width: 100%; max-width: 100%; overflow: hidden; }
  .plate {
    position: absolute; left: 8%; right: 8%; bottom: 10%; height: 12%; border-radius: 22px; background: var(--surface);
    box-shadow: 0 18px 30px var(--lo), inset -6px -8px 12px rgb(0 0 0 / 0.06), inset 6px 6px 12px var(--hi);
  }
  .candles { position: absolute; left: 14%; right: 14%; bottom: 21%; top: 14%; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 4%; }
  .candle { position: relative; }
  .candle span { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); background: var(--c); }
  .wick { width: 14%; border-radius: 99px; }
  .body { width: 78%; border-radius: 10px; box-shadow: 4px 8px 12px var(--lo), inset -4px -5px 8px rgb(0 0 0 / 0.18), inset 4px 4px 8px rgb(255 255 255 / 0.35); }
  .candle:has(.body[style*="height:0%"]) .wick { display: none; }
  .coin {
    position: absolute; width: 9%; aspect-ratio: 1; border-radius: 50%; background: var(--clay-sun);
    box-shadow: 4px 6px 10px var(--lo), inset -3px -4px 6px rgb(0 0 0 / 0.18), inset 3px 3px 6px rgb(255 255 255 / 0.4);
  }
  .c1 { top: 8%; left: 20%; } .c2 { top: 14%; right: 18%; width: 7%; }
</style>
