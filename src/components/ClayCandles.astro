---
/** Static clay K-line diorama (CSS only). Phase 3 replaces it with the three.js scene
    and keeps this as the no-WebGL / reduced-data fallback. Red = up, green = down (Taiwan convention). */
interface Props { label: string }
const { label } = Astro.props;
// [open, close, high, low] on a 0–4 scale
const data = [[1.0, 1.8, 2.1, 0.7], [1.8, 1.3, 2.2, 1.1], [1.3, 2.4, 2.7, 1.2], [2.4, 2.0, 2.8, 1.8], [2.0, 3.1, 3.4, 1.9], [3.1, 2.6, 3.3, 2.3], [2.6, 3.7, 4.0, 2.5]];
const unit = 18; // % of stage height per unit
---
<figure class="stage clay" role="img" aria-label={label}>
  <div class="plate"></div>
  <div class="candles">
    {data.map(([o, c, h, l]) => {
      const up = c >= o;
      const bodyLo = Math.min(o, c), bodyH = Math.max(Math.abs(c - o), 0.25);
      return (
        <div class:list={['candle', up ? 'up' : 'down']}>
          <span class="wick" style={`bottom:${(l - 0.7) * unit}%;height:${(h - l) * unit}%`}></span>
          <span class="body" style={`bottom:${(bodyLo - 0.7) * unit}%;height:${bodyH * unit}%`}></span>
        </div>
      );
    })}
  </div>
  <div class="coin c1"></div><div class="coin c2"></div>
</figure>

<style>
  .stage { position: relative; margin: 0; aspect-ratio: 5 / 4; width: 100%; max-width: 100%; overflow: hidden; background: var(--surface-2); }
  .plate {
    position: absolute; left: 8%; right: 8%; bottom: 10%; height: 12%; border-radius: 22px; background: var(--surface);
    box-shadow: 0 18px 30px var(--lo), inset -6px -8px 12px rgb(0 0 0 / 0.06), inset 6px 6px 12px var(--hi);
  }
  .candles { position: absolute; left: 14%; right: 14%; bottom: 21%; top: 14%; display: grid; grid-template-columns: repeat(7, 1fr); gap: 4%; }
  .candle { position: relative; }
  .candle span { position: absolute; left: 50%; transform: translateX(-50%); }
  .wick { width: 14%; border-radius: 99px; }
  .body { width: 78%; border-radius: 10px; box-shadow: 4px 8px 12px var(--lo), inset -4px -5px 8px rgb(0 0 0 / 0.18), inset 4px 4px 8px rgb(255 255 255 / 0.35); }
  .up span { background: var(--clay-up); } .down span { background: var(--clay-down); }
  .coin {
    position: absolute; width: 9%; aspect-ratio: 1; border-radius: 50%; background: var(--clay-sun);
    box-shadow: 4px 6px 10px var(--lo), inset -3px -4px 6px rgb(0 0 0 / 0.18), inset 3px 3px 6px rgb(255 255 255 / 0.4);
  }
  .c1 { top: 8%; left: 20%; } .c2 { top: 14%; right: 18%; width: 7%; }
</style>
