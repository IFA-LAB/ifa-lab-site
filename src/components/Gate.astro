---
/** Loading screen for pages that open on a 3D scene (home board, history walk, members shelf).
    Shown only when the 3D will actually run (same test as canRun3D, plus no reduced-motion), decided before first paint;
    without JavaScript or 3D the page shows at once with its static clay picture. It lifts when every scene on the page
    has drawn (its host gets data-live, or data-flat when it gave up), two frames later so shaders have compiled,
    and never later than 5 s after the visitor arrives. */
import { type Locale } from '@/i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const zh = lang === 'zh-tw';
const bars = [
  { c: 'up', h: 46, o: 20 }, { c: 'down', h: 34, o: 30 }, { c: 'up', h: 58, o: 14 }, { c: 'up', h: 40, o: 34 }, { c: 'down', h: 30, o: 52 },
];
---
<div class="gate" aria-hidden="true">
  <div class="inner">
    <div class="bars">
      {bars.map((b, i) => <span class="bar" style={`--c: var(--clay-${b.c}); --h: ${b.h}px; --o: ${b.o}px; --i: ${i}`}><i></i></span>)}
    </div>
    <p class="word">IFA Lab</p>
    <p class="note">{zh ? '正在把積木疊好…' : 'Stacking the bricks…'}</p>
  </div>
</div>
<script is:inline>
  (() => {
    const root = document.documentElement;
    if (!root.hasAttribute('data-gate')) return;
    const HOSTS = '[data-kline],[data-walk],[data-shelf]';
    const t0 = performance.now();
    let opened = false;
    const open = () => {
      if (opened) return;
      opened = true;
      const wait = Math.max(0, 450 - (performance.now() - t0)); // never a flash
      setTimeout(() => {
        root.setAttribute('data-gate', 'out');
        setTimeout(() => { root.removeAttribute('data-gate'); document.querySelector('.gate')?.remove(); }, 420);
      }, wait);
    };
    const ready = () => { const hs = [...document.querySelectorAll(HOSTS)]; return hs.length > 0 && hs.every((h) => h.hasAttribute('data-live') || h.hasAttribute('data-flat')); };
    const check = () => { if (ready()) requestAnimationFrame(() => requestAnimationFrame(() => setTimeout(open, 320))); };
    const mo = new MutationObserver(check);
    const arm = () => {
      mo.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['data-live', 'data-flat'] });
      setTimeout(open, 5000);
      if (document.readyState !== 'loading') check(); else addEventListener('DOMContentLoaded', check, { once: true });
    };
    // a prerendered page (speculation rules) counts its 5 s from the moment the visitor actually arrives
    if (document.prerendering) document.addEventListener('prerenderingchange', () => { if (ready()) open(); else arm(); }, { once: true }); else arm();
    if (document.prerendering) mo.observe(document.documentElement, { subtree: true, attributes: true, attributeFilter: ['data-live', 'data-flat'] });
  })();
</script>

<style>
  .gate { display: none; }
  :global(html[data-gate]) .gate {
    position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--bg);
    transition: opacity 400ms var(--ease-out), visibility 0s linear 400ms;
  }
  :global(html[data-gate='out']) .gate { opacity: 0; visibility: hidden; }
  :global(html[data-gate='out']) .bars { transform: translateY(-12px) scale(0.96); transition: transform 400ms var(--ease-out); }
  .inner { display: grid; justify-items: center; gap: var(--space-3); }
  .bars { display: flex; align-items: flex-end; gap: 10px; height: 96px; }
  .bar { position: relative; width: 22px; height: calc(var(--h) + var(--o)); display: flex; align-items: flex-end; }
  /* each candle: a wick and a clay body that rises from below, one after another, like a chart being drawn */
  .bar::before { content: ''; position: absolute; left: 50%; bottom: calc(var(--o) - 8px); height: calc(var(--h) + 16px); width: 3px; translate: -50% 0; border-radius: 2px; background: var(--c); opacity: 0.5; }
  .bar i {
    position: relative; display: block; width: 100%; height: var(--h); margin-bottom: var(--o); border-radius: 7px; background: var(--c);
    box-shadow: 3px 5px 10px var(--lo), inset -3px -4px 6px rgb(0 0 0 / 0.16), inset 3px 4px 6px rgb(255 255 255 / 0.3);
    transform-origin: bottom center; animation: rise 1.8s var(--ease-out) calc(var(--i) * 140ms) infinite both;
  }
  @keyframes rise {
    0% { transform: translateY(14px) scaleY(0.4); opacity: 0; }
    22%, 78% { transform: none; opacity: 1; }
    100% { transform: translateY(-6px); opacity: 0; }
  }
  .word { margin: var(--space-2) 0 0; font: 600 22px/1 var(--f-display); letter-spacing: -0.01em; }
  .note { margin: 0; font-size: 14px; color: var(--ink-2); }
</style>
