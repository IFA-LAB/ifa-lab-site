---
/** CSS clay figure. Also the no-WebGL fallback for the 3D figure planned in phase 3.
    `placeholder` renders the grey, unpainted figure used for empty profiles. */
interface Props {
  clay?: string;
  accessory?: 'none' | 'cat' | 'phones' | 'glasses' | 'guitar';
  size?: number;
  placeholder?: boolean;
}
const { clay = 'grey', accessory = 'none', size = 120, placeholder = false } = Astro.props;
const colour = placeholder ? 'grey' : clay;
---
<div class:list={['fig', { ghost: placeholder }]} style={`--me: var(--clay-${colour}); --s: ${size / 120};`} data-acc={placeholder ? 'none' : accessory} aria-hidden="true">
  <div class="acc cat l"></div><div class="acc cat r"></div>
  <div class="body"></div>
  <div class="eye l"></div><div class="eye r"></div>
  <div class="cheek l"></div><div class="cheek r"></div>
  <div class="acc phones"></div>
  <div class="acc glasses"></div>
  <div class="acc guitar"></div>
</div>

<style>
  .fig { position: relative; width: calc(120px * var(--s)); height: calc(120px * var(--s)); flex: none; }
  .fig > * { position: absolute; }
  .body {
    inset: calc(14px * var(--s)) calc(10px * var(--s)) 0; border-radius: 50% 50% 44% 44%; background: var(--me);
    box-shadow: calc(6px * var(--s)) calc(10px * var(--s)) calc(18px * var(--s)) var(--lo),
      inset calc(-8px * var(--s)) calc(-10px * var(--s)) calc(16px * var(--s)) rgb(0 0 0 / 0.18),
      inset calc(8px * var(--s)) calc(8px * var(--s)) calc(14px * var(--s)) rgb(255 255 255 / 0.35);
  }
  .eye { top: calc(52px * var(--s)); width: calc(11px * var(--s)); height: calc(14px * var(--s)); border-radius: 50%; background: #1d2633; }
  .eye.l { left: calc(42px * var(--s)); } .eye.r { right: calc(42px * var(--s)); }
  .cheek { top: calc(70px * var(--s)); width: calc(14px * var(--s)); height: calc(8px * var(--s)); border-radius: 50%; background: rgb(255 120 140 / 0.55); }
  .cheek.l { left: calc(30px * var(--s)); } .cheek.r { right: calc(30px * var(--s)); }
  .ghost .eye { height: calc(3px * var(--s)); top: calc(58px * var(--s)); border-radius: 2px; opacity: 0.6; }
  .ghost .cheek { display: none; }
  .ghost .body { opacity: 0.85; }

  .acc { display: none; }
  .cat { top: calc(2px * var(--s)); width: calc(30px * var(--s)); height: calc(30px * var(--s)); background: var(--me); filter: brightness(0.92); border-radius: calc(6px * var(--s)) calc(30px * var(--s)); }
  .cat.l { left: calc(14px * var(--s)); transform: rotate(-8deg); } .cat.r { right: calc(14px * var(--s)); transform: rotate(98deg); }
  .phones { top: calc(10px * var(--s)); left: calc(2px * var(--s)); right: calc(2px * var(--s)); height: calc(70px * var(--s)); border: calc(9px * var(--s)) solid #2b3443; border-bottom: 0; border-radius: calc(60px * var(--s)) calc(60px * var(--s)) 0 0; }
  .phones::before, .phones::after { content: ''; position: absolute; bottom: calc(-26px * var(--s)); width: calc(22px * var(--s)); height: calc(32px * var(--s)); border-radius: calc(10px * var(--s)); background: #2b3443; }
  .phones::before { left: calc(-14px * var(--s)); } .phones::after { right: calc(-14px * var(--s)); }
  .glasses { top: calc(46px * var(--s)); left: calc(28px * var(--s)); width: calc(64px * var(--s)); height: calc(24px * var(--s)); border: calc(4px * var(--s)) solid #2b3443; border-radius: calc(12px * var(--s)); background: rgb(255 255 255 / 0.25); }
  .guitar { right: calc(-6px * var(--s)); bottom: calc(4px * var(--s)); width: calc(30px * var(--s)); height: calc(40px * var(--s)); border-radius: 45% 45% 50% 50%; background: #c2552d; box-shadow: inset -3px -4px 6px rgb(0 0 0 / 0.25); }
  .guitar::after { content: ''; position: absolute; left: 50%; bottom: 85%; width: calc(6px * var(--s)); height: calc(36px * var(--s)); transform: translateX(-50%) rotate(12deg); background: #6b3a1f; border-radius: 3px; }
  [data-acc='cat'] .cat, [data-acc='phones'] .phones, [data-acc='glasses'] .glasses, [data-acc='guitar'] .guitar { display: block; }
</style>
