---
// The lab's history as its own candlestick chart (top of the history page).
// One candle a year: open = works so far, close = works after that year, the body built from that year's bricks.
// K 喵 climbs it as the page scrolls; each cohort joins the climb in the year it arrived.
import LabWalk from '@/components/three/LabWalk';
import { getCollection } from 'astro:content';
import { areas, lab, advisor } from '@/data/lab';
import { t, href, type Locale } from '@/i18n/ui';
import { publications } from '@/lib/content';
import { labEvents } from '@/lib/history';

const { lang, listId = 'record' } = Astro.props as { lang: Locale; listId?: string };
const zh = lang === 'zh-tw';

const pubs = await publications();
const theses = await getCollection('theses');
const members = (await getCollection('members'))
  .sort((a, b) => a.data.cohort - b.data.cohort || a.data.order - b.data.order);
const events = await labEvents(lang);
const areaOf = (k: string) => areas.find((a) => a.key === k);
const areaName = (k: string) => t(areaOf(k)?.name, lang);

const works = [
  ...pubs.map((p) => ({ title: p.data.title, year: p.data.status === 'forthcoming' ? 0 : p.data.year, area: p.data.area, kind: p.data.kind as string, href: href(lang, `papers/${p.id}`) })),
  ...theses.map((x) => ({ title: t(x.data.title, lang), year: x.data.academicYear + 1912, area: x.data.area, kind: 'thesis', href: href(lang, 'research#t-h') })),
];
const byArea = (a: { area: string }, b: { area: string }) => areas.findIndex((x) => x.key === a.area) - areas.findIndex((x) => x.key === b.area);
const brick = (w: (typeof works)[number]) => ({ title: w.title, clay: areaOf(w.area)?.clay ?? 'grey', kind: w.kind, href: w.href });
// founders were there when the lab opened (2023); everyone else from the September their cohort started (cohort 1 = 2023)
const joinYear = (m: (typeof members)[number]) => (m.data.founder ? 2023 : 2022 + m.data.cohort);
const done = works.filter((w) => w.year > 0);
// the chart starts the year the lab opened; everything before it is one candle: 邱老師's own work up to then
const OPEN = 2023;
const first = Math.min(...done.map((w) => w.year)), last = Math.max(...done.map((w) => w.year), ...members.map(joinYear));
const yearList = Array.from({ length: last - OPEN + 1 }, (_, i) => OPEN + i);
const before = done.filter((w) => w.year < OPEN).sort((a, b) => a.year - b.year || byArea(a, b));

const pick = (y: number) => {
  const evs = events.filter((e) => e.date.startsWith(String(y)));
  return evs.find((e) => e.kind === 'milestone' && e.date.slice(5) === '08') ?? evs.find((e) => e.kind === 'milestone') ?? evs.find((e) => e.kind === 'award' && e.photo);
};
const beforeAreas = [...new Set(before.map((w) => areaName(w.area)))];
const steps = [
  ...(before.length ? [{
    label: zh ? '成立前' : 'Before',
    caption: zh ? `實驗室成立前，${advisor.name.zh}老師 ${first}–${OPEN - 1} 年已經累積 ${before.length} 件研究，這是 K 線的第一根。`
      : `Before the lab opened, Prof. ${advisor.name.en} had published ${before.length} works (${first}–${OPEN - 1}): the first candle.`,
    sub: zh ? `領域：${beforeAreas.join('、')}` : `Areas: ${beforeAreas.join(', ')}`,
    soon: false, bricks: before.map(brick), joins: [] as string[], anchor: '',
  }] : []),
  ...yearList.map((y) => {
    const ws = done.filter((w) => w.year === y).sort(byArea);
    const ms = members.filter((m) => joinYear(m) === y);
    const ev = pick(y);
    const names = ms.map((m) => t(m.data.name, lang));
    const firstPaper = ws.find((w) => w.kind === 'journal') ?? ws[0];
    const caption = ev ? t(ev.text, lang)
      : ms.length ? (zh ? `${names.join('、')}加入，跟著 K 喵一起往上爬。` : `${names.join(', ')} joined the climb.`)
      : firstPaper ? (zh ? `〈${firstPaper.title}〉` : `“${firstPaper.title}”`)
      : zh ? '這年沒有新成果，K 線上是一根十字線。' : 'No new work this year: a doji on the chart.';
    const areasHere = [...new Set(ws.map((w) => areaName(w.area)))];
    const sub = [
      ws.length ? (zh ? `${ws.length} 件新成果：${areasHere.join('、')}` : `${ws.length} new ${ws.length > 1 ? 'works' : 'work'}: ${areasHere.join(', ')}`) : '',
      ev && ms.length ? (zh ? `${names.join('、')}加入` : `${names.join(', ')} joined`) : '',
    ].filter(Boolean).join(zh ? '；' : '; ');
    return { label: String(y), caption, sub, soon: false, bricks: ws.map(brick), joins: ms.map((m) => m.id), anchor: events.some((e) => e.date.startsWith(String(y))) ? `#${listId}-${y}` : '' };
  }),
  ...(works.some((w) => w.year === 0) ? [{
    label: zh ? '即將' : 'Soon',
    caption: zh ? '已被期刊接受、即將刊登的論文。' : 'Accepted papers, about to be published.',
    sub: '', soon: true,
    bricks: works.filter((w) => w.year === 0).sort(byArea).map(brick),
    joins: [] as string[], anchor: '',
  }] : []),
];
// the advisor stands on the first candle from the start (not counted as a member: the step text says "alone" there)
const crew = [{ id: 'advisor', name: zh ? `${advisor.name.zh}老師` : `Prof. ${advisor.name.en}`, clay: 'sun', accessory: 'none' as const, model: 'prof' as const, href: href(lang, 'advisor') }, ...members.map((m) => ({ id: m.id, name: t(m.data.name, lang), clay: m.data.placeholder ? 'grey' : m.data.figure.clay, accessory: m.data.placeholder ? 'none' as const : m.data.figure.accessory, model: m.data.placeholder ? undefined : m.data.figure.model, href: href(lang, `members/${m.id}`) }))];
const text = {
  eyebrow: zh ? 'IFA Lab 的 K 線' : 'The IFA Lab chart',
  totals: zh ? '累積 {w} 件成果・{m} 位成員' : '{w} works so far · {m} members',
  solo: zh ? `累積 {w} 件成果・${advisor.name.zh}老師一個人` : `{w} works so far · Prof. ${advisor.name.en} alone`,
  more: zh ? '這年的紀錄 ↓' : 'This year’s record ↓',
  skip: zh ? '跳到逐筆紀錄 ↓' : 'Skip to the full record ↓', skipHref: `#${listId}`,
  hint: zh ? '往下捲，跟 K 喵爬上去' : 'Scroll to climb with K-meow',
  endH: zh ? '下一根 K 棒，由你來畫' : 'The next candle is yours',
  endP: zh ? `寄一封信給${advisor.name.zh}老師，說說你好奇的題目。每位成員都是從一封信開始的。` : `Email Prof. ${advisor.name.en} about a question you are curious about. Every member started with one letter.`,
  mail: zh ? `寄信給${advisor.name.zh}老師` : `Email Prof. ${advisor.name.en}`,
  mailHref: `mailto:${lab.contact.email}`,
  join: zh ? '先看怎麼加入' : 'How to join',
  joinHref: href(lang, 'join'),
};
---
{/* Decorative for screen readers: the record list below it on the page carries the same history. Hidden without WebGL or with reduced motion. */}
<section class="walk" data-walk style={`--n: ${steps.length + 1}`} aria-hidden="true">
  <div class="stage">
    <LabWalk client:load steps={steps} crew={crew} text={text} />
  </div>
</section>

<style>
  /* about 3/4 of a screen of scroll per year, then the pull-back; the scene stays pinned */
  .walk { position: relative; height: calc(var(--n) * 75dvh + 100dvh); }
  /* below the 64px header, not under it: the first screen's bottom 64px was cut off and the frame's top hidden */
  .stage { position: sticky; top: 64px; height: calc(100dvh - 64px); overflow: hidden; }
  .stage :global(.walk-canvas) { position: absolute; inset: 0; }
  .stage :global(.walk-3d) { position: absolute; inset: 0; }
  /* overlay: the year being built, what happened, running totals */
  .stage :global(.walk-card) {
    position: absolute; left: max(clamp(16px, 4vw, 48px), calc((100% - var(--page)) / 2 + 16px)); top: var(--space-6);
    width: min(340px, calc(100% - 32px)); display: grid; gap: var(--space-2); padding: var(--space-5);
    border-radius: var(--r-lg); background: color-mix(in oklab, var(--surface) 88%, transparent); backdrop-filter: blur(8px); box-shadow: 0 12px 32px var(--lo);
  }
  .stage :global(.walk-card p) { margin: 0; }
  .stage :global(.walk-year) { font: 700 clamp(48px, 5vw, 64px)/1 var(--f-display); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; animation: year-in var(--dur-base) var(--ease-out); }
  .stage :global(.walk-h) { font: 600 clamp(26px, 3vw, 32px)/1.3 var(--f-display); }
  .stage :global(.walk-cap) { font-size: 16px; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .stage :global(.walk-sub) { font-size: 14px; color: var(--ink-2); }
  .stage :global(.walk-tot) { margin-top: var(--space-2) !important; padding-top: var(--space-2); border-top: 1px solid var(--line); font: 600 14px/1.5 var(--f-body); font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .stage :global(.walk-cta) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-2) !important; }
  .stage :global(.walk-hint) {
    position: absolute; left: 50%; bottom: var(--space-5); translate: -50% 0; max-width: calc(100% - 32px);
    padding: 8px 16px; border-radius: var(--r-full); background: var(--surface); box-shadow: 0 4px 12px var(--lo); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  /* hover label: page type beside the pointer, wraps long paper titles */
  .stage :global(.walk-tip) {
    position: absolute; translate: -50% calc(-100% - 16px); width: max-content; max-width: 320px; pointer-events: none;
    padding: 8px 14px; border-radius: var(--r-md); background: var(--surface); box-shadow: 0 6px 16px var(--lo);
    font: 500 14px/1.5 var(--f-body); color: var(--ink); text-wrap: pretty;
  }
  @keyframes year-in { from { opacity: 0; translate: 0 8px; } }
  /* phones and portrait tablets: the chart fills the top, the card sits at the bottom */
  @media (max-aspect-ratio: 23/20) {
    .stage :global(.walk-card) { top: auto; bottom: var(--space-4); translate: none; left: 16px; right: 16px; width: auto; padding: var(--space-4) var(--space-5); gap: var(--space-1); background: var(--surface); backdrop-filter: none; }
    .stage :global(.walk-card .eyebrow), .stage :global(.walk-sub) { display: none; }
    .stage :global(.walk-year) { font-size: 32px; }
    .stage :global(.walk-cap) { font-size: 15px; -webkit-line-clamp: 3; }
    .stage :global(.walk-tot) { margin-top: var(--space-1) !important; }
    .stage :global(.walk-hint) { bottom: auto; top: var(--space-6); font-size: 13px; }
  }
  /* without WebGL or with reduced motion the chart is not shown; the record below tells the same story */
  .walk[data-flat] { display: none; }
  @media (prefers-reduced-motion: reduce) { .walk { display: none; } }
  /* jump past the chart */
  .stage :global(.walk-skip) { font-size: 14px; color: var(--ink-2); }
  .stage :global(.walk-more) { font-size: 14px; }
  .stage :global(.walk-hint) { transition: opacity var(--dur-base) var(--ease-out); }
  .stage :global(.walk-hint[data-off]) { opacity: 0; }
</style>
