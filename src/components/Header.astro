---
import { ui, t, href, swapLocale, otherLocale, type Locale } from '@/i18n/ui';
interface Props { lang: Locale }
const { lang } = Astro.props;
const path = Astro.url.pathname;
const items = [
  { key: 'research', path: 'research' },
  { key: 'members', path: 'members' },
  { key: 'advisor', path: 'advisor' },
  { key: 'join', path: 'join' },
  { key: 'collaboration', path: 'collaboration' },
  { key: 'history', path: 'history' },
] as const;
// a paper page lives under Research in the menu
const isCurrent = (p: string) => path.startsWith(href(lang, p)) || (p === 'research' && path.startsWith(href(lang, 'papers')));
const other = otherLocale(lang);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={href(lang)} aria-label={`IFA Lab ${t(ui.nav.home, lang)}`}>
      <span class="blocks" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="word">IFA Lab</span>
    </a>
    <nav class="desk" aria-label={t(ui.menu, lang)}>
      <ul class="links">
        {items.map((i) => (
          <li><a href={href(lang, i.path)} aria-current={isCurrent(i.path) ? 'page' : undefined}>{t(ui.nav[i.key], lang)}</a></li>
        ))}
      </ul>
    </nav>
    <details class="menu">
      <summary><span class="when-shut">{t(ui.menu, lang)}</span><span class="when-open" aria-hidden="true">{lang === 'en' ? 'Close' : '關閉'}</span></summary>
      <nav aria-label={t(ui.menu, lang)}>
        <ul class="links">
          {items.map((i) => (
            <li><a href={href(lang, i.path)} aria-current={isCurrent(i.path) ? 'page' : undefined}>{t(ui.nav[i.key], lang)}</a></li>
          ))}
        </ul>
      </nav>
    </details>
    <div class="tools">
      <button class="tool ask-open" type="button" data-ask-open aria-label={lang === 'zh-tw' ? '問 K 喵：問實驗室的事' : 'Ask K-meow about the lab'} aria-haspopup="dialog">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 4.5 4.6 1.8 7.4 3.6A10 9 0 0 1 12 2.5c5.2 0 9.5 3.6 9.5 8.2s-4.3 8.2-9.5 8.2c-1 0-1.9-.1-2.8-.4L4 21l.9-4.5A7.7 7.7 0 0 1 2.5 10.7c0-2.4 1-4.6 2.5-6.2Z"/><circle cx="8.5" cy="11" r="1.3" fill="var(--surface-2)"/><circle cx="15.5" cy="11" r="1.3" fill="var(--surface-2)"/></svg>
        <span class="ask-word">{lang === 'zh-tw' ? '問 K 喵' : 'Ask'}</span>
      </button>
      <a class="tool lang" href={swapLocale(path, other)} hreflang={other === 'en' ? 'en' : 'zh-Hant-TW'} lang={other === 'en' ? 'en' : 'zh-Hant-TW'}><span class="lang-long">{t(ui.langSwitch, lang)}</span><span class="lang-short">{other === 'en' ? 'EN' : '中'}</span><span class="vh" lang={lang === 'en' ? 'en' : 'zh-Hant-TW'}>{t(ui.langSwitchLabel, lang).replace(t(ui.langSwitch, lang), '')}</span></a>
      <button class="tool theme" type="button" aria-label={t(ui.theme, lang)} data-theme-toggle>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.4 5.4 0 0 1-9.54-5A9 9 0 0 0 12 3Z"/></svg>
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></g></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(isDark())));
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', async () => {
      const dark = root.dataset.theme
        ? root.dataset.theme === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches;
      const next = dark ? 'light' : 'dark';
      const apply = () => {
        root.dataset.theme = next;
        // back on the system's theme: forget the choice, so a later OS switch is followed again
        const sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try { if (next === sys) localStorage.removeItem('theme'); else localStorage.setItem('theme', next); } catch {}
        b.setAttribute('aria-pressed', String(next === 'dark'));
      };
      // the new theme spreads out from the button as a growing circle (View Transitions);
      // without the API, or with reduced motion, it simply switches
      if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) { apply(); return; }
      const r = b.getBoundingClientRect();
      const x = r.left + r.width / 2, y = r.top + r.height / 2;
      const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-vt');
      const vt = document.startViewTransition(apply);
      vt.finished.finally(() => root.classList.remove('theme-vt'));
      try {
        await vt.ready;
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      } catch {}
    }),
  );
  // Close the mobile menu on Escape or a tap anywhere outside it.
  document.querySelectorAll<HTMLDetailsElement>('details.menu').forEach((d) => {
    // on the document, not the menu: after a tap on the summary, focus may not be inside it
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
    document.addEventListener('pointerdown', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  // The language switch keeps the page's state in the hash (the research filter, a section): #behavioral stays put.
  document.querySelectorAll<HTMLAnchorElement>('a.lang').forEach((a) =>
    a.addEventListener('click', () => { if (location.hash) a.hash = location.hash; }),
  );
</script>

<style>
  .site-header {
    view-transition-name: site-header;
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  @media (prefers-reduced-transparency: reduce) { .site-header { background: var(--bg); backdrop-filter: none; } }
  .bar { display: flex; align-items: center; gap: var(--space-4); min-height: 64px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .word { font: 600 22px/1 var(--f-display); white-space: nowrap; }
  .blocks { display: grid; grid-template-columns: repeat(3, 10px); gap: 3px; align-items: end; }
  .blocks i { display: block; width: 10px; border-radius: 3px; box-shadow: inset -2px -2px 3px rgb(0 0 0 / 0.15), inset 2px 2px 3px rgb(255 255 255 / 0.35); }
  .blocks i:nth-child(1) { height: 14px; background: var(--clay-down); }
  .blocks i:nth-child(2) { height: 22px; background: var(--clay-up); }
  .blocks i:nth-child(3) { height: 18px; background: var(--clay-blue); }

  .desk { margin-left: auto; }
  .menu { display: none; margin-left: auto; }
  .links { display: flex; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  .links a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: var(--r-full);
    color: var(--ink); text-decoration: none; font-weight: 500; font-size: 16px; white-space: nowrap;
  }
  .links a[aria-current='page'] { background: var(--surface-2); }
  @media (hover: hover) and (pointer: fine) { .links a:hover { background: var(--surface-2); } }

  .tools { display: flex; gap: var(--space-2); }
  .tool {
    white-space: nowrap;
    display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 12px;
    border-radius: var(--r-full); border: 0; background: var(--surface-2); color: var(--ink);
    font: 500 15px/1 var(--f-body); text-decoration: none; cursor: pointer;
  }
  .tool:active { transform: scale(0.97); }
  .ask-open { display: inline-flex; gap: 6px; }
  @media (max-width: 1279px) { .ask-word { display: none; } }
  /* moon in light mode, sun in dark mode: the icon shows where the button takes you */
  .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: block; }
  :global(:root[data-theme='dark']) .theme .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme .moon { display: none; }
  }

  .lang-short { display: none; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* phones up to 479px: "English" is the widest button; the short label keeps the bar on one line with a right margin */
  @media (max-width: 479px) { .lang-long { display: none; } .lang-short { display: inline; } }
  @media (max-width: 420px) {
    .bar { gap: var(--space-2); }
    .word { font-size: 19px; }
    .tool, .menu summary { padding: 0 10px; }
  }
  /* 320px phones: logo, menu, language and theme must fit on one line without sideways scroll */
  @media (max-width: 360px) {
    .bar { gap: 6px; }
    .blocks { grid-template-columns: repeat(3, 8px); }
    .word { font-size: 17px; }
    .tools { gap: 4px; }
    .tool, .menu summary { padding: 0 8px; }
    /* 320px: the blocks alone carry the brand (the link keeps its "IFA Lab" label), so nothing touches the edge */
    .word { display: none; }
  }
  @media (max-width: 1023px) {
    .desk { display: none; }
    .menu { display: block; }
    .menu summary {
      display: inline-grid; place-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--r-full);
      background: var(--surface-2); cursor: pointer; list-style: none; font-weight: 500; white-space: nowrap;
    }
    .menu summary::-webkit-details-marker { display: none; }
    /* open, the button says how to close it; the page you are on is marked in the list */
    .menu .when-open, .menu[open] .when-shut { display: none; }
    .menu[open] .when-open { display: inline; }
    .menu .links a[aria-current='page'] { font-weight: 700; box-shadow: inset 3px 0 0 var(--accent); }
    .menu .links {
      position: absolute; left: max(16px, env(safe-area-inset-left, 0px)); right: max(16px, env(safe-area-inset-right, 0px)); top: 68px;
      flex-direction: column; padding: var(--space-3); background: var(--surface); border-radius: var(--r-md);
      box-shadow: 10px 14px 28px var(--lo);
    }
    .menu .links a { width: 100%; }
  }
</style>
