---
/** A member's clay figure as a link. On hover or keyboard focus it hops, smiles (eyes squint) and
    holds up a name tag: name, cohort and their one-line headline. */
import ClayFigure from '@/components/ClayFigure.astro';
import { ui, t, href, type Locale } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'members'>;
  lang: Locale;
  size?: number;
  /** Print the name under the figure too (the shelf); otherwise the name lives only in the tag. */
  caption?: boolean;
}
const { member: m, lang, size = 64, caption = false } = Astro.props;
const name = t(m.data.name, lang);
const zh = lang === 'zh-tw';
const sep = zh ? '・' : ' · ';
// each part of the line stays whole when the tag wraps (no "114 學 / 年度畢業")
const parts = [t(ui.cohort(m.data.cohort), lang), ...(m.data.placeholder ? [t(ui.placeholderNote, lang)] : m.data.headline ? t(m.data.headline, lang).split(/・| · /) : [])].filter(Boolean);
const sub = parts.join(sep);
---
<a class:list={['mate', { caption }]} href={href(lang, `members/${m.id}`)} aria-label={caption ? undefined : `${name}，${sub}`}>
  <ClayFigure clay={m.data.figure.clay} accessory={m.data.figure.accessory} placeholder={m.data.placeholder} size={size} />
  {caption && <span class="name">{name}</span>}
  <span class="tag" aria-hidden={caption ? undefined : 'true'}><b>{name}</b><small>{parts.map((x, i) => <>{i > 0 && sep}<span class="seg">{x}</span></>)}</small></span>
</a>

<style>
  .mate { position: relative; display: inline-grid; justify-items: center; gap: var(--space-1); color: var(--ink); text-decoration: none; border-radius: var(--r-md); padding: var(--space-1); }
  .mate.caption { font-size: 16px; font-weight: 500; padding: var(--space-2); }
  .tag {
    position: absolute; bottom: calc(100% + 2px); left: 50%; z-index: 5; display: grid; gap: 2px; width: max-content; max-width: 240px;
    padding: 8px 12px; border-radius: var(--r-md); background: var(--ink); color: var(--bg); text-align: left;
    box-shadow: 4px 6px 14px var(--lo);
    opacity: 0; translate: -50% 6px; scale: 0.96; transform-origin: 50% 100%; pointer-events: none;
    /* out of layout while hidden, so a tag near the edge never widens the page */
    display: none; transition-behavior: allow-discrete;
    transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-base) var(--ease-out), scale var(--dur-base) var(--ease-out), display var(--dur-fast) allow-discrete;
  }
  .mate:hover .tag, .mate:focus-visible .tag { display: grid; }
  @starting-style { .mate:hover .tag, .mate:focus-visible .tag { opacity: 0; translate: -50% 6px; scale: 0.96; } }
  /* a little pointer under the tag */
  .tag::after { content: ''; position: absolute; top: 100%; left: calc(50% - var(--nudge, 0px)); translate: -50% -1px; border: 6px solid transparent; border-top-color: var(--ink); }
  .tag b { font: 600 15px/1.3 var(--f-body); }
  .seg { white-space: nowrap; }
  .tag small { font: 400 13px/1.45 var(--f-body); opacity: 0.85; }
  .caption .tag b { display: none; }
  .mate:hover .tag, .mate:focus-visible .tag { opacity: 1; translate: calc(-50% + var(--nudge, 0px)) 0; scale: 1; }
  .mate:hover :global(.fig), .mate:focus-visible :global(.fig) { animation: mate-hop 460ms var(--ease-out); }
  /* wide, excited eyes (the sleepy dash belongs to profiles still to be filled in, so hover never looks like it) */
  .mate:hover :global(.fig:not(.ghost) .eye), .mate:focus-visible :global(.fig:not(.ghost) .eye) { scale: 1.25 1.3; }
  .mate :global(.eye) { transition: scale var(--dur-fast) var(--ease-out); }
  @keyframes mate-hop {
    0% { transform: translateY(0) scale(1, 1); }
    25% { transform: translateY(2px) scale(1.07, 0.9); }
    55% { transform: translateY(-10px) scale(0.96, 1.05); }
    100% { transform: translateY(0) scale(1, 1); }
  }
  @media (hover: none) { .mate:hover .tag { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .mate:hover :global(.fig), .mate:focus-visible :global(.fig) { animation: none; }
    .tag { translate: calc(-50% + var(--nudge, 0px)) 0; scale: 1; transition: opacity 120ms linear, display 120ms allow-discrete; }
    @starting-style { .mate:hover .tag, .mate:focus-visible .tag { translate: -50% 0; scale: 1; } }
  }
</style>

<script>
  // keep a tag inside the window: measure it when it opens and push it back in from the edge
  for (const a of document.querySelectorAll<HTMLElement>('.mate')) {
    const tag = a.querySelector<HTMLElement>('.tag');
    if (!tag) continue;
    const fit = () => requestAnimationFrame(() => {
      tag.style.removeProperty('--nudge');
      const r = tag.getBoundingClientRect(), W = document.documentElement.clientWidth - 8;
      const n = r.right > W ? W - r.right : r.left < 8 ? 8 - r.left : 0;
      if (n) tag.style.setProperty('--nudge', `${Math.round(n)}px`);
    });
    a.addEventListener('pointerenter', fit);
    a.addEventListener('focus', fit);
  }
</script>
